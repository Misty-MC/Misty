// Page d'accueil : la news à la une (grande image, flèches, points) puis les dernières news en
// petites cartes ; ou, sur l'onglet Skin, le studio. Les onglets sont dans la tuile du haut de la
// fenêtre, le lancement (version, JOUER, compte) dans la barre du bas (dock.slint).

import { Theme, Tr, Assets } from "theme.slint";
import { HomeState, AppState, NewsItem } from "state.slint";
import { Icon, PixelLabel, OutlinedText, Thumb, IconButton, PlayButton, GlassCombo } from "widgets.slint";
import { ConsoleState } from "console.slint";
import { SkinState, SkinPanel } from "skin.slint";

/// Flèche ronde du carrousel (précédente / suivante).
component Fleche inherits Rectangle {
    in property <string> icon;
    callback clicked;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: zone.has-hover ? #FFFFFFF0 : #FFFFFFB8;
    drop-shadow-blur: 10px;
    drop-shadow-color: #0A0F1D40;
    transform-scale: zone.pressed ? 0.9 : 1;
    animate background { duration: Theme.fast; }
    animate transform-scale { duration: 120ms; easing: ease-out; }
    Icon {
        text: root.icon;
        font-size: 11px;
        color: #1C2335;
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Une diapositive de la news à la une : l'image en haut, le texte en bas.
component Diapo inherits Rectangle {
    in property <NewsItem> news;
    in property <int> numero;
    in property <length> hauteur-texte;
    clip: true;
    Rectangle {
        height: parent.height - root.hauteur-texte;
        y: 0;
        clip: true;
        background: #1C2335;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.news.image;
            image-fit: cover;
            image-rendering: ImageRendering.pixelated;
        }
        // fondu vers le texte
        Rectangle {
            y: parent.height - 50px;
            height: 50px;
            background: @linear-gradient(180deg, #0A0F1D00 0%, #0A0F1D59 100%);
        }
    }
    HorizontalLayout {
        y: parent.height - root.hauteur-texte;
        height: root.hauteur-texte;
        padding-left: 20px;
        padding-right: 18px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 1px;
                        background: Theme.accent;
                    }
                }
                PixelLabel {
                    text: Tr.t("Home_News");
                    font-size: 11px;
                    color: Theme.accent;
                }
                Text {
                    text: root.news.date != "" ? "·  " + root.news.date : "";
                    font-size: 11.5px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Text {
                text: root.news.title;
                font-size: 19px;
                font-weight: 700;
                color: Theme.navy;
                overflow: elide;
            }
            Text {
                text: root.news.text;
                font-size: 13px;
                color: Theme.text-muted;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 34px;
                width: lire.preferred-width + 26px;
                border-radius: 6px;
                background: zone-lire.has-hover ? Theme.fill-hover : Theme.fill;
                animate background { duration: Theme.fast; }
                lire := HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    PixelLabel {
                        text: Tr.t("Home_LireNews");
                        font-size: 11px;
                        color: Theme.on-fill;
                    }
                    Icon {
                        text: "\u{E72A}";
                        font-size: 10px;
                        color: Theme.on-fill;
                    }
                }
                zone-lire := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { HomeState.news-open(root.numero); }
                }
            }
        }
    }
}

/// La news à la une : une grande carte (image en haut, texte en bas), des flèches de part et
/// d'autre de l'image et des points dessous. Elle avance toute seule toutes les 8 s, sauf quand la
/// souris est dessus.
component NewsUne inherits Rectangle {
    property <int> nombre: HomeState.news-items.length;
    property <int> courant: clamp(HomeState.news-index, 0, max(0, root.nombre - 1));
    property <length> hauteur-texte: 92px;
    border-radius: 12px;
    background: Theme.panel-strong;
    border-width: 1px;
    border-color: Theme.glass-border;
    drop-shadow-blur: 22px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: Theme.shadow;

    function aller(pas: int) {
        if (root.nombre > 0) {
            HomeState.news-index = Math.mod(root.courant + pas + root.nombre, root.nombre);
        }
    }

    // survol de toute la carte : met l'avance automatique en pause
    survol := TouchArea { }

    Timer {
        interval: 8s;
        running: root.nombre > 1 && !survol.has-hover;
        triggered => { root.aller(1); }
    }

    Rectangle {
        border-radius: root.border-radius;
        clip: true;
        for news[i] in HomeState.news-items: Diapo {
            x: (i - root.courant) * parent.width;
            width: parent.width;
            height: parent.height;
            news: news;
            numero: i;
            hauteur-texte: root.hauteur-texte;
            animate x { duration: 420ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        }
    }

    property <length> milieu-image: (root.height - root.hauteur-texte) / 2;
    if root.nombre > 1: Fleche {
        x: 12px;
        y: root.milieu-image - self.height / 2;
        icon: "\u{E76B}";
        clicked => { root.aller(-1); }
    }
    if root.nombre > 1: Fleche {
        x: parent.width - self.width - 12px;
        y: root.milieu-image - self.height / 2;
        icon: "\u{E76C}";
        clicked => { root.aller(1); }
    }

    // points : un par news, le courant plus long
    if root.nombre > 1: HorizontalLayout {
        x: (parent.width - self.preferred-width) / 2;
        y: parent.height - root.hauteur-texte - 18px;
        height: 6px;
        spacing: 5px;
        for news[i] in HomeState.news-items: Rectangle {
            width: i == root.courant ? 18px : 6px;
            height: 6px;
            border-radius: 1px;
            background: i == root.courant ? #FFFFFF : #FFFFFF80;
            animate width, background { duration: 260ms; easing: ease-out; }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { HomeState.news-index = i; }
            }
        }
    }
}

/// Petite carte d'une autre news, sous la une : vignette, titre, date. Un clic la met à la une.
component NewsMini inherits Rectangle {
    in property <int> numero;
    property <NewsItem> news: HomeState.news-items[root.numero];
    property <bool> survol: zone.has-hover;
    height: 64px;
    border-radius: 10px;
    background: root.survol ? Theme.panel-strong : Theme.panel;
    border-width: 1px;
    border-color: root.survol ? Theme.accent.with-alpha(0.6) : Theme.glass-border;
    animate background, border-color { duration: Theme.normal; }
    HorizontalLayout {
        padding: 8px;
        spacing: 10px;
        Rectangle {
            width: 64px;
            border-radius: 6px;
            clip: true;
            background: #1C2335;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.news.image;
                image-fit: cover;
                image-rendering: ImageRendering.pixelated;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.news.title;
                font-size: 13px;
                font-weight: 700;
                color: Theme.navy;
                overflow: elide;
            }
            Text {
                text: root.news.date != "" ? root.news.date : root.news.text;
                font-size: 11.5px;
                color: Theme.text-muted;
                overflow: elide;
            }
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { HomeState.news-index = root.numero; }
    }
}

export component HomePage inherits Rectangle {
    // ═══════════ Jouer : la news à la une, puis les dernières news (comme les sections de laby.net) ═══════════
    if SkinState.tab == 0: VerticalLayout {
        spacing: 12px;
        if HomeState.news-items.length > 0: NewsUne {
            vertical-stretch: 1;
            min-height: 200px;
        }
        if HomeState.news-items.length == 0: Rectangle { vertical-stretch: 1; }
        if HomeState.news-items.length > 1: VerticalLayout {
            spacing: 10px;
            // en-tête de section : titre à gauche, « tout voir » à droite
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 4px;
                PixelLabel {
                    horizontal-stretch: 1;
                    text: Tr.t("Home_News");
                    font-size: 12px;
                    color: Theme.label-strong;
                }
                Rectangle {
                    width: tout.preferred-width + 8px;
                    tout := Text {
                        text: Tr.t("Onglet_Notes") + "  →";
                        font-size: 12.5px;
                        font-weight: 600;
                        color: zone-tout.has-hover ? Theme.navy : Theme.accent;
                        vertical-alignment: center;
                    }
                    zone-tout := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppState.nav-clicked(3); }
                    }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                for k in min(3, HomeState.news-items.length - 1): NewsMini {
                    horizontal-stretch: 1;
                    numero: Math.mod(clamp(HomeState.news-index, 0, HomeState.news-items.length - 1) + 1 + k, HomeState.news-items.length);
                }
            }
        }
    }

    // ═══════════ Skin : le studio ═══════════
    if SkinState.tab == 1: SkinPanel { }
}
