// Packs de textures : galerie (bandeau « Commencer », cartes avec aperçu des textures, import d'un
// .zip), création, export, suppression. L'édition se fait dans editor.slint.

import { Theme, Tr, Assets } from "theme.slint";
import { PacksState, PackCard } from "state.slint";
import { Icon, PixelLabel, BodyText, TuilePage, EnTetePage, SectionTitle, OutlinedText, GlassCard, Thumb, Badge, IconButton, MButton, GlassInput, GlassCombo, Etiquette } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

/// Carte d'un pack : un bandeau sombre avec ses textures modifiées en pixel art, puis le nom, la
/// description, la version et le nombre de textures. Un clic l'ouvre dans l'éditeur ; au survol :
/// exporter, dossier, supprimer.
component PackCardView inherits Rectangle {
    in property <PackCard> pack;
    callback edit();
    callback folder();
    callback export();
    callback delete();
    property <bool> survol: touch.has-hover;

    width: 316px;
    height: 200px;
    border-radius: 8px;
    clip: true;
    background: root.survol ? Theme.panel-strong : Theme.panel;
    border-width: 1px;
    border-color: root.survol ? Theme.accent.with-alpha(0.6) : Theme.glass-border;
    animate background, border-color { duration: Theme.normal; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.edit(); }
    }
    // bandeau : les textures, ou l'icône du pack
    Rectangle {
        y: 0;
        height: 84px;
        background: #1C2335;
        if root.pack.previews.length > 0: HorizontalLayout {
            x: 14px;
            y: (parent.height - 30px) / 2;
            height: 30px;
            spacing: 6px;
            for img in root.pack.previews: Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 3px;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: img;
                    image-fit: fill;
                    image-rendering: ImageRendering.pixelated;
                }
            }
        }
        if root.pack.previews.length == 0: HorizontalLayout {
            padding-left: 14px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Thumb {
                    width: 52px;
                    height: 52px;
                    radius: 8px;
                    border: 2px;
                    logo-margin: 10px;
                    logo-opacity: 1;
                    pixel-art: true;
                    source: root.pack.icon;
                    has-image: root.pack.has-icon;
                }
            }
            Text {
                text: Tr.t("Pack_SansApercu");
                font-size: 12px;
                color: #CFDAF0;
                vertical-alignment: center;
            }
        }
        // actions au survol
        HorizontalLayout {
            x: parent.width - self.preferred-width - 8px;
            y: 8px;
            height: 32px;
            spacing: 5px;
            opacity: root.survol ? 1 : 0;
            animate opacity { duration: Theme.normal; }
            IconButton {
                width: 32px;
                height: 32px;
                icon: "\u{E896}";
                tooltip: Tr.t("Pack_Exporter");
                clicked => { root.export(); }
            }
            IconButton {
                width: 32px;
                height: 32px;
                icon: "\u{E8B7}";
                tooltip: Tr.t("Pack_Dossier");
                clicked => { root.folder(); }
            }
            IconButton {
                width: 32px;
                height: 32px;
                icon: "\u{E74D}";
                fond: Theme.danger;
                encre: white;
                bord: #FFFFFF66;
                tooltip: Tr.t("Pack_Supprimer");
                clicked => { root.delete(); }
            }
        }
    }
    VerticalLayout {
        y: 84px;
        height: parent.height - 84px;
        padding: 14px;
        padding-top: 12px;
        spacing: 4px;
        Text {
            text: root.pack.name;
            font-weight: 700;
            font-size: 15px;
            color: Theme.navy;
            overflow: elide;
        }
        Text {
            text: root.pack.description;
            font-size: 12.5px;
            color: Theme.text-muted;
            overflow: elide;
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 6px;
            if root.pack.version != "": VerticalLayout {
                alignment: center;
                Etiquette { text: root.pack.version; }
            }
            VerticalLayout {
                alignment: center;
                Etiquette { text: root.pack.count; couleur: Theme.toggle-on; }
            }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                height: 30px;
                width: editer.preferred-width + 24px;
                border-radius: 6px;
                background: root.survol ? Theme.fill : Theme.glass-strong;
                animate background { duration: Theme.normal; }
                editer := HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    Icon {
                        text: "\u{E70F}";
                        font-size: 11px;
                        color: root.survol ? Theme.on-fill : Theme.navy;
                    }
                    Text {
                        text: Tr.t("Pack_Editer");
                        font-size: 12.5px;
                        font-weight: 600;
                        color: root.survol ? Theme.on-fill : Theme.navy;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

/// Bandeau « Commencer » en haut de la galerie : ce que fait l'éditeur, et le bouton pour créer.
component Commencer inherits Rectangle {
    height: 150px;
    border-radius: 8px;
    clip: true;
    background: Theme.dark ? @linear-gradient(120deg, #162140 0%, #0E1527 100%) : @linear-gradient(120deg, #2A3347 0%, #1C2335 100%);
    // une mosaïque de blocs, à droite (couleurs de terre, d'herbe, de pierre, d'eau…)
    property <[color]> blocs: [#5EA35A, #4E8A4B, #7A5A3A, #6B4A3A, #8B8B8B, #9A9A9A, #D9874E, #2F6FD6, #E58FB4, #F7C98B, #25B0B5, #FFF1A8];
    for c[i] in root.blocs: Rectangle {
        visible: root.width > 560px;
        x: root.width - 250px + mod(i, 6) * 38px + (floor(i / 6) == 1 ? 19px : 0px);
        y: 28px + floor(i / 6) * 50px;
        width: 34px;
        height: 34px;
        border-radius: 3px;
        background: c;
        opacity: 0.9;
        // les blocs ondulent doucement
        transform-rotation: 6deg * sin((animation-tick() / 3000ms + i * 0.15) * 360deg);
    }
    VerticalLayout {
        x: 0;
        width: root.width > 560px ? root.width - 280px : root.width;
        padding: 22px;
        padding-left: 26px;
        spacing: 6px;
        alignment: center;
        PixelLabel {
            text: Tr.t("Pack_Commencer");
            font-size: 11px;
            color: #9CC0FF;
        }
        Text {
            text: Tr.t("Pack_Commencer_Titre");
            font-size: 20px;
            font-weight: 700;
            color: white;
        }
        Text {
            text: Tr.t("Pack_Commencer_Texte");
            font-size: 13px;
            color: #CFDAF0;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            padding-top: 6px;
            Rectangle {
                height: 34px;
                width: creer.preferred-width + 28px;
                border-radius: 6px;
                background: zone.has-hover ? #FFFFFF : #FFFFFFE0;
                animate background { duration: Theme.fast; }
                creer := HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    Icon {
                        text: "\u{E710}";
                        font-size: 11px;
                        color: #1C2335;
                    }
                    Text {
                        text: Tr.t("Soon_CreerPack");
                        font-size: 13px;
                        font-weight: 700;
                        color: #1C2335;
                        vertical-alignment: center;
                    }
                }
                zone := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { PacksState.new-pack(); }
                }
            }
        }
    }
}

/// Dernière carte de la galerie : importer un pack de ressources (.zip).
component CarteImport inherits Rectangle {
    width: 316px;
    height: 200px;
    border-radius: 8px;
    background: zone.has-hover ? Theme.glass : transparent;
    border-width: 2px;
    border-color: zone.has-hover ? Theme.accent : Theme.glass-border;
    animate background, border-color { duration: Theme.normal; }
    VerticalLayout {
        alignment: center;
        padding: 20px;
        spacing: 8px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 10px;
                background: Theme.fill;
                Icon {
                    text: "\u{E8E5}";
                    font-size: 17px;
                    color: Theme.on-fill;
                }
            }
        }
        Text {
            text: Tr.t("Pack_Importer");
            font-size: 15px;
            font-weight: 700;
            color: Theme.navy;
            horizontal-alignment: center;
        }
        Text {
            text: Tr.t("Pack_Importer_Texte");
            font-size: 12px;
            color: Theme.text-muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { PacksState.import(); }
    }
}

/// Fenêtre modale : couvre toute la fenêtre de l'application (posée par main.slint).
export component PackCreateOverlay inherits Rectangle {

        background: Theme.scrim;
        TouchArea {
            clicked => {
                if (PacksState.create-enabled) {
                    PacksState.cancel-create();
                }
            }
        }
        Rectangle {
            width: 460px;
            height: form.preferred-height;
            border-radius: 24px;
            background: Theme.surface;
            border-width: 2px;
            border-color: Theme.glass-border;
            drop-shadow-blur: 30px;
            drop-shadow-color: Theme.shadow;
            TouchArea { }
            form := VerticalLayout {
                padding-left: 28px;
                padding-right: 28px;
                padding-top: 26px;
                padding-bottom: 26px;
                spacing: 6px;
                SectionTitle {
                    text: Tr.t("Pack_Nouveau");
                    height: 36px;
                    vertical-alignment: top;
                }
                PixelLabel { text: Tr.t("Pack_Nom"); font-size: 10px; x: 4px; }
                GlassInput {
                    text <=> PacksState.create-name;
                    init => { self.focus-input(); }
                    accepted => {
                        if (PacksState.create-enabled) {
                            PacksState.validate();
                        }
                    }
                }
                Rectangle { height: 8px; }
                PixelLabel { text: Tr.t("Pack_Description"); font-size: 10px; x: 4px; }
                GlassInput {
                    text <=> PacksState.create-desc;
                    accepted => {
                        if (PacksState.create-enabled) {
                            PacksState.validate();
                        }
                    }
                }
                Rectangle { height: 8px; }
                PixelLabel { text: Tr.t("Pack_Version"); font-size: 10px; x: 4px; }
                GlassCombo {
                    model: PacksState.versions;
                    current-index <=> PacksState.version-index;
                    enabled: PacksState.create-enabled;
                }
                BodyText {
                    text: PacksState.create-info;
                    x: 2px;
                    min-height: 36px;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    padding-top: 12px;
                    MButton {
                        text: Tr.t("Commun_Annuler");
                        enabled: PacksState.create-enabled;
                        clicked => { PacksState.cancel-create(); }
                    }
                    MButton {
                        kind: 1;
                        text: Tr.t("Pack_Creer");
                        enabled: PacksState.create-enabled;
                        clicked => { PacksState.validate(); }
                    }
                }
            }
        }
}

export component PacksPage inherits Rectangle {
    // une seule tuile, comme Profils : en-tête (titre, nombre, actions), puis la galerie
    TuilePage {
        VerticalLayout {
            EnTetePage {
                titre: Tr.t("Onglet_Packs");
                info: PacksState.list.length;
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    MButton {
                        icon: "";
                        text: Tr.t("Pack_Importer");
                        clicked => { PacksState.import(); }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    MButton {
                        kind: 1;
                        icon: "";
                        text: Tr.t("Soon_CreerPack");
                        clicked => { PacksState.new-pack(); }
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.line;
            }
            Rectangle {
                vertical-stretch: 1;
                zone := ScrollView {
                    x: 20px;
                    y: 16px;
                    width: parent.width - 28px;
                    height: parent.height - 16px;
                    // autant de colonnes que la largeur le permet (cartes de 260 px au moins)
                    property <int> colonnes: max(1, floor((self.visible-width - 12px + 12px) / (260px + 12px)));
                    property <length> case: (self.visible-width - 12px - (self.colonnes - 1) * 12px) / self.colonnes;
                    property <length> haut: 150px + 12px;
                    // les packs, puis la carte « Importer »
                    property <int> nombre: PacksState.list.length + 1;
                    content-width: self.visible-width;
                    content-height: self.haut + ceil(self.nombre / self.colonnes) * (200px + 12px) + 8px;

                    Commencer {
                        x: 0;
                        y: 0;
                        width: zone.visible-width - 12px;
                    }
                    for p[i] in PacksState.list: PackCardView {
                        x: mod(i, zone.colonnes) * (zone.case + 12px);
                        y: zone.haut + floor(i / zone.colonnes) * (200px + 12px);
                        width: zone.case;
                        pack: p;
                        edit => { PacksState.edit(i); }
                        folder => { PacksState.folder(i); }
                        export => { PacksState.export(i); }
                        delete => { PacksState.delete(i); }
                    }
                    CarteImport {
                        x: mod(PacksState.list.length, zone.colonnes) * (zone.case + 12px);
                        y: zone.haut + floor(PacksState.list.length / zone.colonnes) * (200px + 12px);
                        width: zone.case;
                    }
                }
            }
        }
    }
}
