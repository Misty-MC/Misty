// Outils : liste des outils et visualiseur de seed (biomes et structures d'un monde Minecraft).

import { Theme, Tr } from "theme.slint";
import { ToolsState } from "state.slint";
import { Icon, BodyText, OutlinedText, GlassCard, GlassInput, GlassCombo, MButton, IconButton } from "widgets.slint";

/// Carte d'un outil dans la liste.
component OutilCarte inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> description;
    callback clicked;

    width: 316px;
    height: 130px;
    border-radius: 20px;
    background: touch.has-hover ? Theme.glass-hover : Theme.glass;
    border-width: 1.5px;
    border-color: touch.has-hover ? Theme.accent : Theme.glass-border;
    animate background, border-color { duration: Theme.normal; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding: 18px;
        spacing: 16px;
        Rectangle {
            width: 54px;
            height: 54px;
            y: 0;
            border-radius: 16px;
            background: Theme.accent-soft;
            Icon {
                text: root.icon;
                font-size: 26px;
                color: Theme.accent;
            }
        }
        VerticalLayout {
            spacing: 4px;
            alignment: center;
            Text {
                text: root.title;
                font-size: 16px;
                font-weight: 700;
                color: Theme.navy;
            }
            BodyText {
                text: root.description;
                wrap: word-wrap;
            }
        }
    }
}

/// Pastille de structure : on clique pour l'afficher ou la masquer sur la carte.
component Pastille inherits Rectangle {
    in property <string> text;
    in property <color> dot;
    in property <bool> checked;
    callback clicked;

    height: 32px;
    width: libelle.preferred-width + 44px;
    border-radius: 16px;
    border-width: 1.5px;
    border-color: root.checked ? Theme.accent : Theme.glass-border;
    background: root.checked ? Theme.accent-soft : touche.has-hover ? Theme.glass-hover : Theme.glass;
    opacity: root.checked ? 1 : 0.8;
    animate background, border-color { duration: Theme.normal; }

    Rectangle {
        x: 12px;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        border-radius: 3px;
        background: root.dot;
        border-width: 1.5px;
        border-color: #1C2335;
    }
    libelle := Text {
        x: 32px;
        text: root.text;
        font-size: 12.5px;
        font-weight: 600;
        color: Theme.navy2;
        vertical-alignment: center;
    }
    touche := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component SeedViewer inherits VerticalLayout {
    spacing: 10px;

    // Seed, version, dimension
    HorizontalLayout {
        spacing: 10px;
        GlassInput {
            horizontal-stretch: 1;
            placeholder: Tr.t("Tools_SeedPlaceholder");
            text <=> ToolsState.seed-text;
            accepted(t) => { ToolsState.generate(); }
        }
        MButton {
            kind: 1;
            text: Tr.t("Tools_Generer");
            clicked => { ToolsState.generate(); }
        }
        MButton {
            icon: "\u{E8B1}";
            text: Tr.t("Tools_Aleatoire");
            clicked => { ToolsState.random-seed(); }
        }
        GlassCombo {
            width: 190px;
            model: ToolsState.versions;
            current-index <=> ToolsState.version-index;
            selected(i) => { ToolsState.version-changed(i); }
        }
        GlassCombo {
            width: 150px;
            model: ToolsState.dimensions;
            current-index <=> ToolsState.dimension-index;
            selected(i) => { ToolsState.dimension-changed(i); }
        }
    }

    // La carte
    Rectangle {
        vertical-stretch: 1;
        carte := Rectangle {
            width: min(960px, parent.width);
            height: self.width * 0.4583;
            border-radius: 18px;
            clip: true;
            background: Theme.dark ? #0B1222 : #1C2335;
            border-width: 1.5px;
            border-color: Theme.glass-border;

            // décalage pendant le glissement : la carte suit la souris tout de suite,
            // elle est recalculée une fois relâchée (le décalage retombe à 0 quand la nouvelle arrive)
            property <length> dec-x;
            property <length> dec-y;
            changed carte-id => { self.dec-x = 0; self.dec-y = 0; }
            property <int> carte-id: ToolsState.map-id;

            if ToolsState.has-map: Image {
                x: carte.dec-x + (parent.width - self.width) / 2;
                y: carte.dec-y + (parent.height - self.height) / 2;
                width: parent.width * ToolsState.zoom-scale;
                height: parent.height * ToolsState.zoom-scale;
                source: ToolsState.map;
                image-fit: fill;
                image-rendering: pixelated;
            }
            if !ToolsState.has-map: Text {
                text: Tr.t("Options_Calcul");
                color: #FFFFFFAA;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if ToolsState.busy: Rectangle {
                x: 12px;
                y: 12px;
                height: 26px;
                width: calcul.preferred-width + 24px;
                border-radius: 13px;
                background: #0B1222CC;
                calcul := Text {
                    text: Tr.t("Options_Calcul");
                    font-size: 11px;
                    font-weight: 600;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            touch := TouchArea {
                property <length> dernier-x;
                property <length> dernier-y;
                property <length> debut-x;
                property <length> debut-y;
                mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        self.dernier-x = self.mouse-x;
                        self.debut-x = self.mouse-x;
                        self.debut-y = self.mouse-y;
                        self.dernier-y = self.mouse-y;
                    } else if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                        ToolsState.pan((self.mouse-x - self.debut-x) / self.width, (self.mouse-y - self.debut-y) / self.height);
                    }
                }
                moved => {
                    if (self.pressed) {
                        carte.dec-x += self.mouse-x - self.dernier-x;
                        carte.dec-y += self.mouse-y - self.dernier-y;
                        self.dernier-x = self.mouse-x;
                        self.dernier-y = self.mouse-y;
                    } else {
                        ToolsState.hover(self.mouse-x / self.width, self.mouse-y / self.height);
                    }
                }
                scroll-event(e) => {
                    if (e.delta-y > 0) {
                        ToolsState.zoom(1);
                    } else if (e.delta-y < 0) {
                        ToolsState.zoom(-1);
                    }
                    accept
                }
            }

            // zoom en bas à droite
            HorizontalLayout {
                x: parent.width - self.preferred-width - 12px;
                y: parent.height - 44px;
                spacing: 6px;
                IconButton {
                    icon: "\u{E738}";
                    tooltip: Tr.t("Tools_ZoomMoins");
                    clicked => { ToolsState.zoom(-1); }
                }
                IconButton {
                    icon: "\u{E710}";
                    tooltip: Tr.t("Tools_ZoomPlus");
                    clicked => { ToolsState.zoom(1); }
                }
            }
        }
    }

    // Position sous la souris, centre et zoom
    HorizontalLayout {
        spacing: 16px;
        Text {
            horizontal-stretch: 1;
            text: ToolsState.hover-text != "" ? ToolsState.hover-text : Tr.t("Tools_Aide");
            font-size: 12.5px;
            color: Theme.navy2;
            overflow: elide;
            vertical-alignment: center;
        }
        Text {
            text: Tr.t("Tools_Centre") + " " + ToolsState.center-text + "   ·   " + ToolsState.zoom-text;
            font-size: 12.5px;
            font-weight: 600;
            color: Theme.navy;
            vertical-alignment: center;
        }
    }

    // Structures et raccourcis
    HorizontalLayout {
        spacing: 8px;
        for c[i] in ToolsState.chips: Pastille {
            text: c.name;
            dot: c.color;
            checked: c.on;
            clicked => { ToolsState.toggle-chip(i); }
        }
        Rectangle { horizontal-stretch: 1; }
        MButton {
            text: Tr.t("Tools_Spawn");
            enabled: ToolsState.dimension-index == 0;
            clicked => { ToolsState.goto-spawn(); }
        }
        MButton {
            text: Tr.t("Tools_Origine");
            clicked => { ToolsState.goto-origin(); }
        }
    }
}

export component ToolsPage inherits Rectangle {
    VerticalLayout {
        padding-left: 26px;
        padding-right: 30px;
        padding-bottom: 22px;
        spacing: 14px;

        // En-tête : grand titre pour la liste, titre court avec retour dans un outil
        if ToolsState.tool == 0: VerticalLayout {
            padding-left: 6px;
            spacing: 6px;
            HorizontalLayout {
                alignment: start;
                OutlinedText {
                    text: Tr.t("Tools_Titre");
                    font-size: 40px;
                    depth: 5px;
                }
            }
            BodyText {
                text: Tr.t("Tools_SousTitre");
                x: 4px;
            }
        }
        if ToolsState.tool == 1: HorizontalLayout {
            spacing: 12px;
            height: 44px;
            IconButton {
                icon: "\u{E72B}";
                tooltip: Tr.t("Commun_Retour");
                clicked => { ToolsState.tool = 0; }
            }
            Text {
                text: Tr.t("Tools_Seed_Nom");
                font-size: 24px;
                font-weight: 700;
                color: Theme.navy;
                vertical-alignment: center;
            }
        }

        if ToolsState.tool == 0: HorizontalLayout {
            alignment: start;
            spacing: 16px;
            OutilCarte {
                icon: "\u{E774}";
                title: Tr.t("Tools_Seed_Nom");
                description: Tr.t("Tools_Seed_Desc");
                clicked => {
                    ToolsState.tool = 1;
                    ToolsState.seed-opened();
                }
            }
        }
        if ToolsState.tool == 0: Rectangle { vertical-stretch: 1; }

        if ToolsState.tool == 1: SeedViewer {
            vertical-stretch: 1;
        }
    }
}
