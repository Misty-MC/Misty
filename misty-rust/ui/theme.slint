// Thème : couleurs (clair « brume » et sombre « nuit », repris du site misty-launcher.online),
// polices, traductions, images partagées.

import "../assets/fonts/Silkscreen-Regular.ttf";
import "../assets/fonts/Silkscreen-Bold.ttf";
import { Palette } from "std-widgets.slint";

export global Theme {
    // ── Réglages d'apparence (pilotés par Rust, enregistrés dans data.txt) ──
    /// 0 brume (clair) · 1 nuit (sombre) · 2 comme Windows
    in-out property <int> mode: 0;
    /// Carrés flottants animés sur le fond
    in-out property <bool> particles: true;
    /// Fond flouté derrière les fenêtres (options…)
    in-out property <bool> blur: true;
    out property <bool> dark: mode == 1 || (mode == 2 && Palette.color-scheme == ColorScheme.dark);

    // ── Palette de base ──
    out property <color> sky-light: #C4DFF8;
    out property <color> sky: dark ? #0A0F1D : #A8C8EC;
    out property <color> steel: dark ? #6F9CFF : #6B90BD;
    out property <color> deep: #4F74A6;
    /// Contour et ombre des grands titres pixel
    out property <color> slate: dark ? #3C5486 : #58738E;
    out property <color> slate-dark: dark ? #1A2440 : #3E526A;
    /// Étiquettes (texte gris-bleu) : lisibles sur les deux fonds
    out property <color> label: dark ? #8796B5 : #58738E;
    out property <color> label-strong: dark ? #A3B0CB : #3E526A;
    /// Encre principale (texte fort, icônes)
    out property <color> navy: dark ? #EEF3FF : #1C2335;
    out property <color> navy2: dark ? #CFDAF0 : #2A3347;
    out property <color> green: #1DE062;
    out property <color> green-dark: #13B24C;
    out property <color> green-edge: #0E7F37;
    out property <color> blue: dark ? #6F9CFF : #2F8CFF;
    out property <color> danger: #FF5A6E;

    // ── Accent (sélection, focus) : bleu brume du site ──
    out property <color> accent: dark ? #9CC0FF : #2F6FD6;
    out property <color> accent-soft: dark ? #9CC0FF29 : #2F8CFF24;
    /// Fond d'un élément choisi / bouton principal, et son texte
    out property <color> fill: dark ? #6F9CFF : #1C2335;
    out property <color> fill-hover: dark ? #8AAEFF : #2A3347;
    out property <color> on-fill: #FFFFFF;
    /// Relief sous les boutons (comme les .btn du site)
    out property <color> lip: dark ? #060A14 : #9DB4D3;
    out property <color> fill-lip: dark ? #3D63C4 : #070B16;

    // ── Texte ──
    out property <color> text: dark ? #EEF3FF : #1C2335;
    out property <color> text-muted: dark ? #A3B0CB : #5A6B82;
    out property <color> text-dim: dark ? #6F7C99 : #8394AB;

    // ── Verre dépoli ──
    out property <color> glass: dark ? #111A30B8 : #FFFFFF59;
    out property <color> glass-strong: dark ? #162140F0 : #FFFFFFA6;
    out property <color> glass-hover: dark ? #1C2A50F0 : #FFFFFF8C;
    out property <color> glass-border: dark ? #FFFFFF1F : #FFFFFFB3;
    /// Grands panneaux de page (barre de lancement, carte du skin…)
    out property <color> panel: dark ? #111A30D9 : #FFFFFF73;
    out property <color> panel-strong: dark ? #1C2A50F0 : #FFFFFFB3;
    out property <color> line: dark ? #FFFFFF14 : #1C23351A;

    // ── Surfaces ──
    /// Fenêtres modales
    out property <color> surface: dark ? #0E1527F5 : #F4F8FEF2;
    /// Colonne de navigation des fenêtres modales
    out property <color> surface-2: dark ? #0B1222F5 : #E6EEF9F2;
    /// Listes déroulantes
    out property <color> popup: dark ? #121B33 : #F6FAFF;
    out property <color> popup-hover: dark ? #FFFFFF12 : #2F8CFF26;
    out property <brush> scrim: dark ? @linear-gradient(180deg, #05080F8C 0%, #05080FC0 100%) : @linear-gradient(180deg, #14203A59 0%, #14203A99 100%);
    out property <color> shadow: dark ? #00000099 : #1C233540;
    out property <color> track: dark ? #FFFFFF1F : #1C233526;
    out property <color> toggle-on: dark ? #6F9CFF : #13B24C;
    out property <color> toggle-off: dark ? #FFFFFF26 : #1C233533;
    /// Panneau d'aperçu du personnage (accueil, skin)
    out property <color> stage: dark ? #0E1527 : #D9E9FA;

    // ── Mouvement ──
    out property <duration> fast: 120ms;
    out property <duration> normal: 200ms;
    out property <duration> slow: 320ms;

    // ── Polices ──
    out property <string> pixel-font: "Silkscreen";
    out property <string> ui-font: "Segoe UI Variable Text";
    out property <string> icon-font: "Segoe MDL2 Assets"; // présente sur Windows 10 ET 11 (Segoe Fluent Icons = Win11 seulement)
}

// Traductions : Tr.t("Cle"). Quand la langue change, Rust incrémente `rev`
// et tous les textes qui utilisent Tr.t sont recalculés.
export global Tr {
    in property <int> rev;
    pure callback lookup(string) -> string;
    public pure function t(key: string) -> string {
        if (rev < 0) {
            return "";
        }
        return lookup(key);
    }
}

// Bulle d'aide unique, dessinée par la fenêtre au-dessus de tout le reste.
// Les boutons indiquent seulement le texte et la position (coordonnées dans la fenêtre).
export global Bulle {
    in-out property <string> texte;
    in-out property <length> x;
    in-out property <length> y;
    /// true : à droite du bouton (barre latérale) ; false : centrée sous le bouton
    in-out property <bool> a-droite;
    in-out property <bool> visible;
    /// Hauteur de la fenêtre : les listes déroulantes s'ouvrent vers le haut si elles n'ont pas la place en dessous.
    in-out property <length> fenetre-hauteur: 720px;
}

// Images générées en Rust (bloc d'herbe en pixel art…).
export global Assets {
    in property <image> grass;
}
