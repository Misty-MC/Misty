// Fenêtre de choix de la version : une affiche par mise à jour (1.21 Tricky Trials…) illustrée en
// pixel art, et à droite le détail de celle choisie (bannière, versions, mod loader, un bouton qui
// confirme). En haut, filtres par type, puis Misty Client et Horizon, et recherche.

import { Theme, Tr, Assets } from "theme.slint";
import { HomeState, VersionItem, ProfileItem, VersionGroup, HorizonBuild } from "state.slint";
import { Icon, PixelLabel, BodyText, GlassInput, MButton, OutlinedText, IconButton } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

/// Pastille de filtre (type, loader, onglet).
component Puce inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <color> point: transparent;
    callback clicked;
    height: 36px;
    width: contenu.preferred-width;
    border-radius: 11px;
    background: root.checked ? Theme.fill : zone.has-hover && root.enabled ? Theme.glass-hover : Theme.glass;
    border-width: 1px;
    border-color: root.checked ? Theme.fill : Theme.glass-border;
    opacity: root.enabled ? 1 : 0.4;
    transform-scale: zone.pressed && root.enabled ? 0.95 : 1;
    animate background, border-color { duration: Theme.normal; }
    animate transform-scale { duration: 140ms; easing: ease-out; }
    contenu := HorizontalLayout {
        padding-left: 13px;
        padding-right: 13px;
        spacing: 7px;
        if root.point != transparent: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 2px;
                background: root.point;
            }
        }
        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 600;
            color: root.checked ? Theme.on-fill : Theme.navy;
            vertical-alignment: center;
        }
    }
    zone := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

global Couleurs {
    /// types : release, snapshot, bêta, alpha
    out property <[color]> types: [#1DE062, #FFBE5A, #9CC0FF, #FF8A7A];
    /// loaders filtrés : tous, Fabric, Forge, NeoForge, OptiFine, LiteLoader, Quilt
    out property <[color]> loaders: [transparent, #DBC9A3, #E0915A, #F2A65A, #E25A5A, #6FA3F0, #B58CF0];
}

/// Affiche d'une mise à jour dans la grille : l'illustration en grand, puis le numéro, le nom et le
/// nombre de versions sur un bandeau sombre.
component Affiche inherits Rectangle {
    in property <VersionGroup> g;
    in property <bool> checked;
    callback clicked;
    property <bool> survol: zone.has-hover;
    height: 158px;
    border-radius: 10px;
    clip: true;
    background: #1C2335;
    drop-shadow-blur: root.checked ? 18px : 0px;
    drop-shadow-color: Theme.accent.with-alpha(0.4);
    Image {
        y: 0;
        width: parent.width;
        height: parent.height - 56px;
        source: root.g.art;
        image-fit: cover;
        image-rendering: pixelated;
        transform-scale: root.survol || root.checked ? 1.08 : 1;
        animate transform-scale { duration: 360ms; easing: ease-out; }
    }
    VerticalLayout {
        y: parent.height - 56px;
        height: 56px;
        padding-left: 12px;
        padding-right: 10px;
        alignment: center;
        spacing: 2px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.g.title;
                font-family: Theme.ui-font;
                font-size: 15px;
                color: white;
            }
            Text {
                horizontal-stretch: 1;
                text: root.g.name;
                font-size: 12px;
                font-weight: 600;
                color: #CFDAF0;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        Text {
            text: root.g.count + " · " + root.g.years;
            font-size: 11px;
            color: #8394AB;
            overflow: elide;
        }
    }
    // cadre de l'affiche choisie
    Rectangle {
        border-radius: parent.border-radius;
        border-width: root.checked ? 3px : root.survol ? 2px : 0px;
        border-color: root.checked ? Theme.accent : #FFFFFF99;
        animate border-width { duration: Theme.fast; }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Version dans la mise à jour choisie.
component PuceVersion inherits Rectangle {
    in property <VersionItem> v;
    in property <bool> checked;
    callback clicked;
    height: 42px;
    border-radius: 12px;
    background: root.checked ? Theme.fill : zone.has-hover ? Theme.glass-hover : Theme.glass-strong;
    border-width: 1px;
    border-color: root.checked ? Theme.fill : zone.has-hover ? Theme.accent.with-alpha(0.5) : Theme.glass-border;
    drop-shadow-blur: root.checked ? 16px : 0px;
    drop-shadow-color: Theme.accent.with-alpha(0.4);
    transform-scale: zone.pressed ? 0.95 : zone.has-hover ? 1.04 : 1;
    animate background, border-color, drop-shadow-blur { duration: Theme.normal; }
    animate transform-scale { duration: 160ms; easing: ease-out; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 7px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 2px;
                background: Couleurs.types[root.v.kind];
            }
        }
        Text {
            text: root.v.id;
            font-family: Theme.ui-font;
            font-size: 12.5px;
            color: root.checked ? Theme.on-fill : Theme.navy;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Carte d'un mod loader de la version choisie.
component CarteLoader inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled;
    callback clicked;
    height: 52px;
    // les cartes se partagent la largeur de la ligne (4 ou 5 loaders, même fenêtre étroite)
    horizontal-stretch: 1;
    min-width: nom.preferred-width + 20px;
    preferred-width: nom.preferred-width + 46px;
    max-width: 150px;
    border-radius: 14px;
    background: root.checked ? Theme.accent-soft : zone.has-hover && root.enabled ? Theme.glass-hover : Theme.glass-strong;
    border-width: root.checked ? 2px : 1px;
    border-color: root.checked ? Theme.accent : Theme.glass-border;
    opacity: root.enabled ? 1 : 0.5;
    transform-scale: zone.pressed && root.enabled ? 0.95 : 1;
    animate background, border-color { duration: Theme.normal; }
    animate transform-scale { duration: 140ms; easing: ease-out; }
    nom := Text {
        text: root.text;
        font-size: 14px;
        font-weight: 700;
        color: root.checked ? Theme.accent : Theme.navy;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    zone := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Carte d'un profil, avec l'illustration de sa version.
component CarteProfil inherits Rectangle {
    in property <ProfileItem> p;
    in property <bool> checked;
    callback clicked;
    border-radius: 16px;
    clip: true;
    background: Theme.glass-strong;
    border-width: root.checked ? 2px : 1px;
    border-color: root.checked ? Theme.accent : zone.has-hover ? Theme.accent.with-alpha(0.5) : Theme.glass-border;
    drop-shadow-blur: root.checked ? 20px : 0px;
    drop-shadow-color: Theme.accent.with-alpha(0.35);
    transform-scale: zone.pressed ? 0.97 : zone.has-hover ? 1.02 : 1;
    animate border-color, drop-shadow-blur { duration: Theme.normal; }
    animate transform-scale { duration: 180ms; easing: ease-out; }
    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: 96px;
        source: root.p.art;
        image-fit: cover;
        image-rendering: pixelated;
    }
    Rectangle {
        y: 40px;
        height: 56px;
        background: @linear-gradient(180deg, #0A0F1D00 0%, #0A0F1DB3 100%);
    }
    // icône du profil, posée à cheval sur l'illustration
    Rectangle {
        x: 14px;
        y: 66px;
        width: 54px;
        height: 54px;
        border-radius: 13px;
        background: Theme.dark ? #162140 : #1C2335;
        border-width: 3px;
        border-color: Theme.surface;
        clip: true;
        if root.p.has-icon: Image {
            width: parent.width;
            height: parent.height;
            source: root.p.icon;
            image-fit: cover;
        }
        if !root.p.has-icon: Image {
            x: 10px;
            y: 10px;
            width: parent.width - 20px;
            height: parent.height - 20px;
            source: Assets.logo;
            image-fit: contain;
        }
    }
    VerticalLayout {
        x: 80px;
        y: 100px;
        width: parent.width - 94px;
        height: parent.height - 108px;
        spacing: 2px;
        Text {
            text: root.p.name;
            font-size: 15px;
            font-weight: 700;
            color: root.checked ? Theme.accent : Theme.navy;
            overflow: elide;
        }
        Text {
            text: root.p.detail;
            font-size: 12.5px;
            color: Theme.text-muted;
            overflow: elide;
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Ce que Misty apporte en jeu (une carte par fonction).
component FonctionMisty inherits Rectangle {
    in property <string> icon;
    in property <string> titre;
    in property <string> texte;
    // quatre cartes de même largeur, quel que soit leur texte
    horizontal-stretch: 1;
    min-width: 0;
    preferred-width: 0;
    border-radius: 14px;
    background: Theme.glass-strong;
    border-width: 1px;
    border-color: Theme.glass-border;
    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 8px;
                background: Theme.accent-soft;
                Icon {
                    text: root.icon;
                    font-size: 13px;
                    color: Theme.accent;
                }
            }
            Text {
                text: root.titre;
                font-size: 13px;
                font-weight: 700;
                color: Theme.navy;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        Text {
            text: root.texte;
            font-size: 11.5px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
    }
}

/// Une version de Misty Client, en puce.
component PuceMisty inherits Rectangle {
    in property <string> version;
    in property <bool> checked;
    callback clicked;
    width: 150px;
    height: 42px;
    border-radius: 12px;
    background: root.checked ? Theme.accent : zone.has-hover ? Theme.glass-hover : Theme.glass-strong;
    border-width: 1px;
    border-color: root.checked ? Theme.accent : Theme.glass-border;
    animate background { duration: Theme.normal; }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        Icon {
            text: "\u{E753}";
            font-size: 14px;
            color: root.checked ? white : Theme.accent;
            vertical-alignment: center;
        }
        Text {
            text: "MISTY " + root.version;
            font-family: Theme.ui-font;
            font-size: 12px;
            color: root.checked ? white : Theme.navy;
            vertical-alignment: center;
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Panneau Misty : ce qu'apporte Misty Client, ses versions, et Jouer.
component PanneauMisty inherits VerticalLayout {
    spacing: 14px;
    // bannière
    Rectangle {
        height: 200px;
        border-radius: 20px;
        clip: true;
        border-width: 1px;
        border-color: Theme.accent.with-alpha(0.45);
        background: @linear-gradient(135deg, #0E1A38 0%, #1D3F86 55%, #3B7BE8 100%);
        Image {
            x: 0;
            width: parent.width;
            height: max(parent.height, parent.width * 90 / 160);
            y: min(0px, parent.height - self.height * 82 / 90);
            source: HomeState.misty-art;
            image-fit: fill;
            image-rendering: pixelated;
            opacity: 0.5;
        }
        Rectangle {
            background: @linear-gradient(90deg, #0A1226E6 0%, #0A122699 45%, #0A122600 75%);
        }
        Image {
            width: 120px;
            height: 120px;
            x: parent.width - self.width - 36px;
            y: (parent.height - self.height) / 2;
            source: Assets.logo;
        }
        VerticalLayout {
            padding: 22px;
            spacing: 6px;
            alignment: end;
            PixelLabel {
                text: Tr.t("Misty_Etiquette");
                font-size: 11px;
                color: #CFE0FF;
            }
            HorizontalLayout {
                alignment: start;
                OutlinedText {
                    text: "MISTY";
                    font-size: 44px;
                    thickness: 4px;
                    depth: 5px;
                    stroke-color: #142A5C;
                    shadow: #0A1430;
                }
            }
            Text {
                text: Tr.t("Misty_Titre");
                font-size: 18px;
                font-weight: 800;
                color: white;
            }
            Text {
                text: "Minecraft " + HomeState.misty-mc + " · Fabric · Misty Client";
                font-size: 13px;
                color: #CFDAF0;
            }
        }
    }

    // ce que Misty apporte
    PixelLabel {
        text: Tr.t("Misty_Inclus");
        font-size: 11px;
    }
    HorizontalLayout {
        spacing: 10px;
        FonctionMisty { icon: "\u{E80F}"; titre: Tr.t("Misty_F_Menu"); texte: Tr.t("Misty_F_Menu_Texte"); }
        FonctionMisty { icon: "\u{E9D9}"; titre: Tr.t("Misty_F_Hud"); texte: Tr.t("Misty_F_Hud_Texte"); }
        FonctionMisty { icon: "\u{E753}"; titre: Tr.t("Misty_F_Badge"); texte: Tr.t("Misty_F_Badge_Texte"); }
        FonctionMisty { icon: "\u{E7EE}"; titre: Tr.t("Misty_F_Cosmetiques"); texte: Tr.t("Misty_F_Cosmetiques_Texte"); }
    }

    // versions Misty
    PixelLabel {
        text: Tr.t("Ver_Onglet_Versions");
        font-size: 11px;
    }
    // en grille : autant de puces par ligne que la place le permet, puis on passe à la ligne
    Rectangle {
        property <int> colonnes: max(1, floor((self.width + 8px) / 158px));
        min-width: 0;
        height: ceil(HomeState.misty-versions.length / self.colonnes) * 50px - 8px;
        for v[i] in HomeState.misty-versions: PuceMisty {
            x: mod(i, parent.colonnes) * 158px;
            y: floor(i / parent.colonnes) * 50px;
            version: v;
            checked: HomeState.misty-selected && v == HomeState.misty-mc;
            clicked => { HomeState.misty-select(v); }
        }
    }
    Rectangle { vertical-stretch: 1; }

    // bas : info, Jouer
    HorizontalLayout {
        spacing: 10px;
        Text {
            horizontal-stretch: 1;
            text: Tr.t("Misty_Info");
            font-size: 12.5px;
            color: Theme.text-muted;
            vertical-alignment: center;
            wrap: word-wrap;
        }
        VerticalLayout {
            alignment: center;
            MButton {
                icon: "\u{E73E}";
                text: Tr.t("Ver_Valider");
                clicked => {
                    HomeState.misty-select(HomeState.misty-mc);
                    HomeState.picker-open = false;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            MButton {
                kind: 3;
                icon: "\u{E768}";
                text: Tr.t("Misty_Jouer");
                clicked => { HomeState.misty-play(); }
            }
        }
    }
}

/// Un build d'Horizon, en puce comme les versions : un clic le télécharge, puis le choisit.
component PuceBuild inherits Rectangle {
    in property <HorizonBuild> b;
    in property <bool> checked;
    property <bool> charge: HomeState.horizon-busy && HomeState.horizon-busy-tag == root.b.tag;
    height: 42px;
    border-radius: 12px;
    clip: true;
    background: root.checked ? #F0795A : zone.has-hover ? Theme.glass-hover : Theme.glass-strong;
    border-width: 1px;
    border-color: root.checked ? #F0795A : zone.has-hover ? #F0795A88 : Theme.glass-border;
    opacity: root.b.installed || root.charge || zone.has-hover ? 1 : 0.7;
    drop-shadow-blur: root.checked ? 16px : 0px;
    drop-shadow-color: #F0795A66;
    transform-scale: zone.pressed ? 0.95 : zone.has-hover ? 1.04 : 1;
    animate background, border-color, drop-shadow-blur, opacity { duration: Theme.normal; }
    animate transform-scale { duration: 160ms; easing: ease-out; }
    // téléchargement : la puce se remplit
    if root.charge: Rectangle {
        x: 0;
        width: parent.width * clamp(HomeState.horizon-progress, 0, 1);
        background: #F0795A40;
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 7px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 2px;
                background: root.checked ? white : root.b.nightly ? #FFBE5A : #1DE062;
            }
        }
        Text {
            text: root.b.nightly && root.b.date != "" ? root.b.date : root.b.tag;
            font-family: Theme.ui-font;
            font-size: 12px;
            color: root.checked ? white : Theme.navy;
            vertical-alignment: center;
            overflow: elide;
        }
        Icon {
            text: root.b.installed ? "\u{E73E}" : "\u{E896}";
            font-size: 10px;
            color: root.checked ? white : root.b.installed ? #1DE062 : Theme.text-muted;
        }
    }
    zone := TouchArea {
        enabled: !HomeState.horizon-busy || root.b.installed;
        mouse-cursor: pointer;
        clicked => {
            if (root.b.installed) {
                HomeState.horizon-select(root.b.tag);
            } else {
                HomeState.horizon-install(root.b.tag);
            }
        }
    }
}

/// Horizon, présenté comme une mise à jour : bannière, builds en puces, puis compte et actions.
component PanneauHorizon inherits VerticalLayout {
    spacing: 14px;
    // bannière (même format que les mises à jour)
    Rectangle {
        height: 200px;
        border-radius: 20px;
        clip: true;
        border-width: 1px;
        border-color: #F0795A66;
        Image {
            // comme les mises à jour : le bas visible s'arrête juste sous le sol
            x: 0;
            width: parent.width;
            height: max(parent.height, parent.width * 90 / 160);
            y: min(0px, parent.height - self.height * 82 / 90);
            source: HomeState.horizon-art;
            image-fit: fill;
            image-rendering: pixelated;
        }
        Rectangle {
            background: @linear-gradient(90deg, #120A1CD9 0%, #120A1C80 45%, #120A1C00 75%);
        }
        VerticalLayout {
            padding: 22px;
            spacing: 6px;
            alignment: end;
            PixelLabel {
                text: Tr.t("Hz_Etiquette");
                font-size: 11px;
                color: #FFC2A8;
            }
            HorizontalLayout {
                alignment: start;
                OutlinedText {
                    text: "HORIZON";
                    font-size: 44px;
                    thickness: 4px;
                    depth: 5px;
                    stroke-color: #7A2E14;
                    shadow: #3A1408;
                }
            }
            Text {
                text: Tr.t("Hz_Titre");
                font-size: 18px;
                font-weight: 800;
                color: white;
            }
            Text {
                text: HomeState.horizon-builds.length + " builds · Rust · MIT · " + Tr.t("Hz_Puce_Officiel");
                font-size: 13px;
                color: #F6D5C8;
            }
        }
    }

    // builds
    HorizontalLayout {
        spacing: 8px;
        PixelLabel {
            text: Tr.t("Hz_Builds");
            font-size: 11px;
        }
        if HomeState.horizon-loading: Icon {
            text: "\u{E895}";
            font-size: 11px;
            color: #F0795A;
            transform-rotation: (animation-tick() / 1000ms) * 360deg;
        }
        Rectangle { horizontal-stretch: 1; }
    }
    grille-builds := ScrollView {
        vertical-stretch: 1;
        property <int> colonnes: max(2, floor((self.visible-width + 8px) / 190px));
        property <length> largeur: (self.visible-width - 8px - (self.colonnes - 1) * 8px) / self.colonnes;
        // les builds filtrés (Tous, Nightly, Stables) sont rangés à la suite
        property <[HorizonBuild]> visibles: HomeState.horizon-builds;
        content-width: self.visible-width;
        content-height: ceil(HomeState.horizon-visibles / self.colonnes) * 50px + 10px;
        for b[i] in HomeState.horizon-builds: PuceBuild {
            property <int> rang: HomeState.horizon-ranks[i];
            visible: self.rang >= 0;
            x: 4px + Math.mod(max(0, self.rang), grille-builds.colonnes) * (grille-builds.largeur + 8px);
            y: 4px + floor(max(0, self.rang) / grille-builds.colonnes) * 50px;
            width: grille-builds.largeur;
            b: b;
            checked: HomeState.horizon-selected && b.tag == HomeState.horizon-build;
        }
    }

    if HomeState.horizon-message != "": Text {
        text: HomeState.horizon-message;
        font-size: 12.5px;
        color: Theme.navy2;
        wrap: word-wrap;
    }

    // en bas : compte requis, build choisi, actions (comme la ligne des mod loaders)
    HorizontalLayout {
        spacing: 10px;
        if HomeState.horizon-build != "": VerticalLayout {
            alignment: center;
            PixelLabel {
                text: HomeState.horizon-build;
                font-size: 11px;
                color: #F0795A;
            }
        }
        if HomeState.horizon-build != "": VerticalLayout {
            alignment: center;
            IconButton {
                width: 36px;
                height: 36px;
                icon: "\u{E74D}";
                icon-size: 13px;
                tooltip: Tr.t("Hz_Supprimer");
                enabled: !HomeState.horizon-busy;
                clicked => { HomeState.horizon-remove(HomeState.horizon-build); }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            MButton {
                icon: "\u{E73E}";
                text: Tr.t("Ver_Valider");
                enabled: HomeState.horizon-build != "";
                clicked => {
                    HomeState.horizon-select(HomeState.horizon-build);
                    HomeState.picker-open = false;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            MButton {
                kind: 1;
                icon: "\u{E768}";
                text: HomeState.horizon-build != "" ? Tr.t("Hz_Jouer") : Tr.t("Hz_ChoisisBuild");
                enabled: HomeState.horizon-build != "" && !HomeState.horizon-busy;
                clicked => { HomeState.horizon-play(); }
            }
        }
    }
}

export component VersionPicker inherits Rectangle {
    property <bool> ouvert: HomeState.picker-open;
    property <bool> a-groupe: HomeState.picker-group >= 0 && HomeState.picker-group < HomeState.picker-groups.length;
    property <VersionGroup> groupe: self.a-groupe ? HomeState.picker-groups[HomeState.picker-group] : { title: "", name: "" };
    opacity: root.ouvert ? 1 : 0;
    visible: self.opacity > 0.01;
    animate opacity { duration: root.ouvert ? 200ms : 150ms; easing: ease-out; }

    Rectangle { background: Theme.scrim; }
    TouchArea {
        enabled: root.ouvert;
        clicked => { HomeState.picker-open = false; }
    }

    carte := Rectangle {
        width: min(1180px, parent.width - 60px);
        // en haut, la place des boutons de la fenêtre (réduire, agrandir, fermer : 44 px)
        height: min(720px, parent.height - 88px);
        x: (parent.width - self.width) / 2;
        y: 44px + (parent.height - 44px - self.height) / 2 + (root.ouvert ? 0px : 16px);
        border-radius: 26px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.glass-border;
        drop-shadow-blur: 50px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: Theme.shadow;
        transform-scale: root.ouvert ? 1 : 0.96;
        animate y, transform-scale { duration: root.ouvert ? 380ms : 160ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        clip: true;
        TouchArea { }

        VerticalLayout {
            padding: 22px;
            spacing: 14px;

            // ── En-tête ──
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: Tr.t("Ver_Titre");
                    font-size: 24px;
                    font-weight: 800;
                    color: Theme.navy;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                if HomeState.picker-tab == 0: VerticalLayout {
                    alignment: center;
                    GlassInput {
                        width: 230px;
                        height: 38px;
                        search: true;
                        placeholder: Tr.t("Ver_Recherche");
                        text <=> HomeState.picker-search;
                        edited => { HomeState.picker-changed(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 6px;
                        Puce {
                            text: Tr.t("Ver_Onglet_Versions");
                            checked: HomeState.picker-tab == 0;
                            clicked => { HomeState.picker-tab = 0; }
                        }
                        Puce {
                            text: Tr.t("Ver_Onglet_Profils");
                            checked: HomeState.picker-tab == 1;
                            clicked => { HomeState.picker-tab = 1; }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: fermer.has-hover ? Theme.glass-hover : Theme.glass;
                        border-width: 1px;
                        border-color: fermer.has-hover ? Theme.accent : Theme.glass-border;
                        transform-rotation: fermer.has-hover ? 90deg : 0deg;
                        animate transform-rotation { duration: 260ms; easing: ease-out; }
                        animate background, border-color { duration: Theme.fast; }
                        Icon {
                            text: "\u{E8BB}";
                            font-size: 12px;
                        }
                        fermer := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { HomeState.picker-open = false; }
                        }
                    }
                }
            }

            // ── Filtres : types de versions, puis Misty Client et Horizon ──
            if HomeState.picker-tab == 0: HorizontalLayout {
                spacing: 6px;
                for t[i] in [Tr.t("Ver_Releases"), "Snapshots", Tr.t("Ver_Betas"), "Alphas"]: Puce {
                    text: t;
                    point: Couleurs.types[i];
                    checked: !HomeState.picker-horizon && !HomeState.picker-misty && (i == 0 ? HomeState.picker-release : i == 1 ? HomeState.picker-snapshot : i == 2 ? HomeState.picker-beta : HomeState.picker-alpha);
                    clicked => {
                        // depuis Misty ou Horizon : on revient aux versions, sans changer les filtres
                        if (HomeState.picker-horizon || HomeState.picker-misty) {
                            HomeState.picker-horizon = false;
                            HomeState.picker-misty = false;
                            return;
                        }
                        // au moins un type reste coché : sinon la liste serait vide
                        if (self.checked && (HomeState.picker-release ? 1 : 0) + (HomeState.picker-snapshot ? 1 : 0) + (HomeState.picker-beta ? 1 : 0) + (HomeState.picker-alpha ? 1 : 0) <= 1) {
                            return;
                        }
                        if (i == 0) { HomeState.picker-release = !HomeState.picker-release; }
                        if (i == 1) { HomeState.picker-snapshot = !HomeState.picker-snapshot; }
                        if (i == 2) { HomeState.picker-beta = !HomeState.picker-beta; }
                        if (i == 3) { HomeState.picker-alpha = !HomeState.picker-alpha; }
                        HomeState.picker-changed();
                    }
                }
                VerticalLayout {
                    alignment: center;
                    padding-left: 6px;
                    padding-right: 6px;
                    Rectangle {
                        width: 1px;
                        height: 24px;
                        background: Theme.line;
                    }
                }
                if HomeState.misty-available: Puce {
                    text: "Misty Client";
                    point: #9CC0FF;
                    checked: HomeState.picker-misty;
                    clicked => {
                        HomeState.picker-misty = true;
                        HomeState.picker-horizon = false;
                    }
                }
                Puce {
                    text: "Horizon";
                    point: #F0795A;
                    checked: HomeState.picker-horizon;
                    clicked => {
                        HomeState.picker-horizon = true;
                        HomeState.picker-misty = false;
                        HomeState.horizon-refresh();
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                // Horizon : nightlies ou versions stables
                if HomeState.picker-horizon: HorizontalLayout {
                    spacing: 6px;
                    for f[i] in [Tr.t("Ver_TousLoaders"), "Nightly", Tr.t("Hz_Stables")]: Puce {
                        text: f;
                        point: i == 1 ? #FFBE5A : i == 2 ? #1DE062 : transparent;
                        checked: HomeState.horizon-filter == i;
                        clicked => {
                            HomeState.horizon-filter = i;
                            HomeState.horizon-filter-changed();
                        }
                    }
                }
            }

            // Misty Client et Horizon : leur panneau sur toute la largeur
            if HomeState.picker-tab == 0 && HomeState.picker-misty: PanneauMisty {
                vertical-stretch: 1;
            }
            if HomeState.picker-tab == 0 && HomeState.picker-horizon: PanneauHorizon {
                vertical-stretch: 1;
            }

            // ── Versions : les affiches des mises à jour, le détail à droite ──
            if HomeState.picker-tab == 0 && !HomeState.picker-horizon && !HomeState.picker-misty: HorizontalLayout {
                vertical-stretch: 1;
                spacing: 16px;

                affiches := ScrollView {
                    horizontal-stretch: 1;
                    property <int> colonnes: max(2, floor((self.visible-width + 12px) / 212px));
                    property <length> largeur: (self.visible-width - 8px - (self.colonnes - 1) * 12px) / self.colonnes;
                    content-width: self.visible-width;
                    content-height: ceil(HomeState.picker-groups.length / self.colonnes) * 170px + 8px;
                    for g[i] in HomeState.picker-groups: Affiche {
                        x: 4px + Math.mod(i, affiches.colonnes) * (affiches.largeur + 12px);
                        y: 4px + floor(i / affiches.colonnes) * 170px;
                        width: affiches.largeur;
                        g: g;
                        checked: i == HomeState.picker-group;
                        clicked => { HomeState.picker-group-selected(i); }
                    }
                    if HomeState.picker-groups.length == 0: Text {
                        x: 0;
                        y: 40px;
                        width: affiches.visible-width;
                        text: Tr.t("Ver_Aucune");
                        font-size: 13px;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                // détail de la mise à jour choisie : versions, mod loader, et un bouton qui confirme
                Rectangle {
                    width: 340px;
                    border-radius: 12px;
                    background: Theme.panel-strong;
                    border-width: 1px;
                    border-color: Theme.glass-border;
                    if !root.a-groupe: Text {
                        width: parent.width - 40px;
                        text: Tr.t("Ver_LoadersAttente");
                        font-size: 13px;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    if root.a-groupe: VerticalLayout {
                        padding: 14px;
                        spacing: 10px;
                        // bannière
                        Rectangle {
                            height: 120px;
                            border-radius: 8px;
                            clip: true;
                            Image {
                                x: 0;
                                width: parent.width;
                                height: max(parent.height, parent.width * 90 / 160);
                                y: min(0px, parent.height - self.height * 82 / 90);
                                source: root.groupe.art;
                                image-fit: fill;
                                image-rendering: pixelated;
                            }
                            Rectangle {
                                background: @linear-gradient(0deg, #0A0F1DD9 0%, #0A0F1D00 70%);
                            }
                            VerticalLayout {
                                padding: 12px;
                                alignment: end;
                                spacing: 2px;
                                HorizontalLayout {
                                    alignment: start;
                                    OutlinedText {
                                        text: root.groupe.title;
                                        font-size: 28px;
                                        thickness: 3px;
                                        depth: 3px;
                                        stroke-color: #141B2B;
                                        shadow: #0A0E18;
                                    }
                                }
                                Text {
                                    text: root.groupe.name;
                                    font-size: 14px;
                                    font-weight: 800;
                                    color: white;
                                    overflow: elide;
                                }
                            }
                        }
                        PixelLabel {
                            text: Tr.t("Ver_Onglet_Versions");
                            font-size: 11px;
                        }
                        grille := ScrollView {
                            vertical-stretch: 1;
                            property <int> colonnes: 3;
                            property <length> largeur: (self.visible-width - 8px - (self.colonnes - 1) * 6px) / self.colonnes;
                            content-width: self.visible-width;
                            content-height: ceil(HomeState.picker-sub.length / self.colonnes) * 46px + 8px;
                            for v[i] in HomeState.picker-sub: PuceVersion {
                                x: 4px + Math.mod(i, grille.colonnes) * (grille.largeur + 6px);
                                y: 4px + floor(i / grille.colonnes) * 46px;
                                width: grille.largeur;
                                height: 38px;
                                v: v;
                                checked: HomeState.quick && !HomeState.horizon-selected && !HomeState.misty-selected && v.id == HomeState.card-version;
                                clicked => { HomeState.version-picked(v.id); }
                            }
                        }
                        PixelLabel {
                            text: Tr.t("Commun_ModLoader");
                            font-size: 11px;
                        }
                        // loaders : 3 par ligne
                        Rectangle {
                            property <int> lignes: max(1, ceil(HomeState.modes.length / 3));
                            property <length> largeur: (self.width - 2 * 6px) / 3;
                            height: self.lignes * 46px - 6px;
                            for m[i] in HomeState.modes: CarteLoader {
                                x: Math.mod(i, 3) * (parent.largeur + 6px);
                                y: floor(i / 3) * 46px;
                                width: parent.largeur;
                                height: 40px;
                                text: m;
                                checked: i == HomeState.mode-index;
                                enabled: HomeState.modes-enabled;
                                clicked => {
                                    HomeState.mode-index = i;
                                    HomeState.mode-selected(i);
                                }
                            }
                            if HomeState.modes.length == 0: Text {
                                text: Tr.t("Ver_ChoisisVersion");
                                font-size: 12.5px;
                                color: Theme.text-muted;
                            }
                        }
                        MButton {
                            kind: 1;
                            icon: "\u{E73E}";
                            enabled: HomeState.modes.length > 0;
                            text: HomeState.mode-index >= 0 && HomeState.mode-index < HomeState.modes.length
                                ? Tr.t("Ver_Choisir") + " " + HomeState.card-version + " · " + HomeState.modes[HomeState.mode-index]
                                : Tr.t("Ver_Valider");
                            clicked => { HomeState.picker-open = false; }
                        }
                    }
                }
            }

            // ── Profils : cartes illustrées ──
            if HomeState.picker-tab == 1: profils := ScrollView {
                vertical-stretch: 1;
                property <int> colonnes: max(2, floor((self.visible-width + 14px) / 300px));
                property <length> largeur: (self.visible-width - 8px - (self.colonnes - 1) * 14px) / self.colonnes;
                content-width: self.visible-width;
                content-height: ceil(HomeState.profile-items.length / self.colonnes) * 186px + 10px;
                for p[i] in HomeState.profile-items: CarteProfil {
                    x: 4px + Math.mod(i, profils.colonnes) * (profils.largeur + 14px);
                    y: 4px + floor(i / profils.colonnes) * 186px;
                    width: profils.largeur;
                    height: 172px;
                    p: p;
                    checked: i == HomeState.profile-index;
                    clicked => {
                        HomeState.profile-index = i;
                        HomeState.profile-selected(i);
                        HomeState.picker-open = false;
                    }
                }
            }
        }
    }
}
