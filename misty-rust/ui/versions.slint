// Fenêtre de choix de la version, façon Lunar : à gauche les mises à jour (1.21 Tricky Trials…)
// illustrées en pixel art, à droite une grande bannière, les versions de la mise à jour et les mod
// loaders. En haut, filtres par type, par mod loader compatible, et recherche.

import { Theme, Tr, Assets } from "theme.slint";
import { HomeState, VersionItem, ProfileItem, VersionGroup, HorizonBuild } from "state.slint";
import { Icon, PixelLabel, BodyText, GlassInput, MButton, OutlinedText, IconButton } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

/// Pastille de filtre (type, loader, onglet).
component Puce inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <color> point: transparent;
    callback clicked;
    height: 36px;
    width: contenu.preferred-width;
    border-radius: 11px;
    background: root.checked ? Theme.fill : zone.has-hover && root.enabled ? Theme.glass-hover : Theme.glass;
    border-width: 1px;
    border-color: root.checked ? Theme.fill : Theme.glass-border;
    opacity: root.enabled ? 1 : 0.4;
    transform-scale: zone.pressed && root.enabled ? 0.95 : 1;
    animate background, border-color { duration: Theme.normal; }
    animate transform-scale { duration: 140ms; easing: ease-out; }
    contenu := HorizontalLayout {
        padding-left: 13px;
        padding-right: 13px;
        spacing: 7px;
        if root.point != transparent: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 2px;
                background: root.point;
            }
        }
        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 600;
            color: root.checked ? Theme.on-fill : Theme.navy;
            vertical-alignment: center;
        }
    }
    zone := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

global Couleurs {
    /// types : release, snapshot, bêta, alpha
    out property <[color]> types: [#1DE062, #FFBE5A, #9CC0FF, #FF8A7A];
    /// loaders filtrés : tous, Fabric, Forge, NeoForge, OptiFine, LiteLoader, Quilt
    out property <[color]> loaders: [transparent, #DBC9A3, #E0915A, #F2A65A, #E25A5A, #6FA3F0, #B58CF0];
}

/// Mise à jour dans la colonne de gauche : illustration, titre, nom, nombre de versions.
component LigneGroupe inherits Rectangle {
    in property <VersionGroup> g;
    in property <bool> checked;
    callback clicked;
    height: 74px;
    border-radius: 14px;
    background: root.checked ? Theme.accent-soft : zone.has-hover ? Theme.glass-hover : transparent;
    border-width: 1px;
    border-color: root.checked ? Theme.accent : zone.has-hover ? Theme.glass-border : transparent;
    animate background, border-color { duration: Theme.normal; }
    HorizontalLayout {
        padding: 8px;
        spacing: 12px;
        Rectangle {
            width: 100px;
            border-radius: 10px;
            clip: true;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.g.art;
                image-fit: cover;
                image-rendering: pixelated;
                transform-scale: zone.has-hover || root.checked ? 1.12 : 1;
                animate transform-scale { duration: 360ms; easing: ease-out; }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.g.title;
                font-family: Theme.pixel-font;
                font-size: 15px;
                color: root.checked ? Theme.accent : Theme.navy;
            }
            Text {
                text: root.g.name;
                font-size: 12.5px;
                font-weight: 600;
                color: Theme.navy2;
                overflow: elide;
            }
            Text {
                text: root.g.count + " · " + root.g.years;
                font-size: 11.5px;
                color: Theme.text-dim;
                overflow: elide;
            }
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Version dans la mise à jour choisie.
component PuceVersion inherits Rectangle {
    in property <VersionItem> v;
    in property <bool> checked;
    callback clicked;
    height: 42px;
    border-radius: 12px;
    background: root.checked ? Theme.fill : zone.has-hover ? Theme.glass-hover : Theme.glass-strong;
    border-width: 1px;
    border-color: root.checked ? Theme.fill : zone.has-hover ? Theme.accent.with-alpha(0.5) : Theme.glass-border;
    drop-shadow-blur: root.checked ? 16px : 0px;
    drop-shadow-color: Theme.accent.with-alpha(0.4);
    transform-scale: zone.pressed ? 0.95 : zone.has-hover ? 1.04 : 1;
    animate background, border-color, drop-shadow-blur { duration: Theme.normal; }
    animate transform-scale { duration: 160ms; easing: ease-out; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 7px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 2px;
                background: Couleurs.types[root.v.kind];
            }
        }
        Text {
            text: root.v.id;
            font-family: Theme.pixel-font;
            font-size: 12.5px;
            color: root.checked ? Theme.on-fill : Theme.navy;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Carte d'un mod loader de la version choisie.
component CarteLoader inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled;
    callback clicked;
    height: 52px;
    // les cartes se partagent la largeur de la ligne (4 ou 5 loaders, même fenêtre étroite)
    horizontal-stretch: 1;
    min-width: nom.preferred-width + 20px;
    preferred-width: nom.preferred-width + 46px;
    max-width: 150px;
    border-radius: 14px;
    background: root.checked ? Theme.accent-soft : zone.has-hover && root.enabled ? Theme.glass-hover : Theme.glass-strong;
    border-width: root.checked ? 2px : 1px;
    border-color: root.checked ? Theme.accent : Theme.glass-border;
    opacity: root.enabled ? 1 : 0.5;
    transform-scale: zone.pressed && root.enabled ? 0.95 : 1;
    animate background, border-color { duration: Theme.normal; }
    animate transform-scale { duration: 140ms; easing: ease-out; }
    nom := Text {
        text: root.text;
        font-size: 14px;
        font-weight: 700;
        color: root.checked ? Theme.accent : Theme.navy;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    zone := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Carte d'un profil, avec l'illustration de sa version.
component CarteProfil inherits Rectangle {
    in property <ProfileItem> p;
    in property <bool> checked;
    callback clicked;
    border-radius: 16px;
    clip: true;
    background: Theme.glass-strong;
    border-width: root.checked ? 2px : 1px;
    border-color: root.checked ? Theme.accent : zone.has-hover ? Theme.accent.with-alpha(0.5) : Theme.glass-border;
    drop-shadow-blur: root.checked ? 20px : 0px;
    drop-shadow-color: Theme.accent.with-alpha(0.35);
    transform-scale: zone.pressed ? 0.97 : zone.has-hover ? 1.02 : 1;
    animate border-color, drop-shadow-blur { duration: Theme.normal; }
    animate transform-scale { duration: 180ms; easing: ease-out; }
    Image {
        x: 0;
        y: 0;
        width: parent.width;
        height: 96px;
        source: root.p.art;
        image-fit: cover;
        image-rendering: pixelated;
    }
    Rectangle {
        y: 40px;
        height: 56px;
        background: @linear-gradient(180deg, #0A0F1D00 0%, #0A0F1DB3 100%);
    }
    // icône du profil, posée à cheval sur l'illustration
    Rectangle {
        x: 14px;
        y: 66px;
        width: 54px;
        height: 54px;
        border-radius: 13px;
        background: Theme.dark ? #162140 : #1C2335;
        border-width: 3px;
        border-color: Theme.surface;
        clip: true;
        if root.p.has-icon: Image {
            width: parent.width;
            height: parent.height;
            source: root.p.icon;
            image-fit: cover;
        }
        if !root.p.has-icon: Image {
            x: 10px;
            y: 10px;
            width: parent.width - 20px;
            height: parent.height - 20px;
            source: Assets.logo;
            image-fit: contain;
        }
    }
    VerticalLayout {
        x: 80px;
        y: 100px;
        width: parent.width - 94px;
        height: parent.height - 108px;
        spacing: 2px;
        Text {
            text: root.p.name;
            font-size: 15px;
            font-weight: 700;
            color: root.checked ? Theme.accent : Theme.navy;
            overflow: elide;
        }
        Text {
            text: root.p.detail;
            font-size: 12.5px;
            color: Theme.text-muted;
            overflow: elide;
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Entrée Horizon, épinglée en haut de la colonne des mises à jour.
component LigneHorizon inherits Rectangle {
    in property <bool> checked;
    callback clicked;
    height: 74px;
    border-radius: 14px;
    background: root.checked ? #F0795A2E : zone.has-hover ? Theme.glass-hover : #F0795A12;
    border-width: 1px;
    border-color: root.checked ? #F0795A : #F0795A59;
    animate background, border-color { duration: Theme.normal; }
    HorizontalLayout {
        padding: 8px;
        spacing: 12px;
        Rectangle {
            width: 100px;
            border-radius: 10px;
            clip: true;
            Image {
                width: parent.width;
                height: parent.height;
                source: HomeState.horizon-art;
                image-fit: cover;
                image-rendering: pixelated;
                transform-scale: zone.has-hover || root.checked ? 1.12 : 1;
                animate transform-scale { duration: 360ms; easing: ease-out; }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: "HORIZON";
                font-family: Theme.pixel-font;
                font-size: 15px;
                color: #F0795A;
            }
            Text {
                text: Tr.t("Hz_Sous_Titre");
                font-size: 12.5px;
                font-weight: 600;
                color: Theme.navy2;
                overflow: elide;
            }
            Text {
                text: HomeState.horizon-build != "" ? HomeState.horizon-build : "26.3 · Rust · MIT";
                font-size: 11.5px;
                color: Theme.text-dim;
                overflow: elide;
            }
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Un build d'Horizon, en puce comme les versions : un clic le télécharge, puis le choisit.
component PuceBuild inherits Rectangle {
    in property <HorizonBuild> b;
    in property <bool> checked;
    property <bool> charge: HomeState.horizon-busy && HomeState.horizon-busy-tag == root.b.tag;
    height: 42px;
    border-radius: 12px;
    clip: true;
    background: root.checked ? #F0795A : zone.has-hover ? Theme.glass-hover : Theme.glass-strong;
    border-width: 1px;
    border-color: root.checked ? #F0795A : zone.has-hover ? #F0795A88 : Theme.glass-border;
    opacity: root.b.installed || root.charge || zone.has-hover ? 1 : 0.7;
    drop-shadow-blur: root.checked ? 16px : 0px;
    drop-shadow-color: #F0795A66;
    transform-scale: zone.pressed ? 0.95 : zone.has-hover ? 1.04 : 1;
    animate background, border-color, drop-shadow-blur, opacity { duration: Theme.normal; }
    animate transform-scale { duration: 160ms; easing: ease-out; }
    // téléchargement : la puce se remplit
    if root.charge: Rectangle {
        x: 0;
        width: parent.width * clamp(HomeState.horizon-progress, 0, 1);
        background: #F0795A40;
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 7px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 2px;
                background: root.checked ? white : root.b.nightly ? #FFBE5A : #1DE062;
            }
        }
        Text {
            text: root.b.nightly && root.b.date != "" ? root.b.date : root.b.tag;
            font-family: Theme.pixel-font;
            font-size: 12px;
            color: root.checked ? white : Theme.navy;
            vertical-alignment: center;
            overflow: elide;
        }
        Icon {
            text: root.b.installed ? "\u{E73E}" : "\u{E896}";
            font-size: 10px;
            color: root.checked ? white : root.b.installed ? #1DE062 : Theme.text-muted;
        }
    }
    zone := TouchArea {
        enabled: !HomeState.horizon-busy || root.b.installed;
        mouse-cursor: pointer;
        clicked => {
            if (root.b.installed) {
                HomeState.horizon-select(root.b.tag);
            } else {
                HomeState.horizon-install(root.b.tag);
            }
        }
    }
}

/// Horizon, présenté comme une mise à jour : bannière, builds en puces, puis compte et actions.
component PanneauHorizon inherits VerticalLayout {
    spacing: 14px;
    // bannière (même format que les mises à jour)
    Rectangle {
        height: 200px;
        border-radius: 20px;
        clip: true;
        border-width: 1px;
        border-color: #F0795A66;
        Image {
            // comme les mises à jour : le bas visible s'arrête juste sous le sol
            x: 0;
            width: parent.width;
            height: max(parent.height, parent.width * 90 / 160);
            y: min(0px, parent.height - self.height * 82 / 90);
            source: HomeState.horizon-art;
            image-fit: fill;
            image-rendering: pixelated;
        }
        Rectangle {
            background: @linear-gradient(90deg, #120A1CD9 0%, #120A1C80 45%, #120A1C00 75%);
        }
        VerticalLayout {
            padding: 22px;
            spacing: 6px;
            alignment: end;
            PixelLabel {
                text: Tr.t("Hz_Etiquette");
                font-size: 10.5px;
                color: #FFC2A8;
            }
            HorizontalLayout {
                alignment: start;
                OutlinedText {
                    text: "HORIZON";
                    font-size: 44px;
                    thickness: 4px;
                    depth: 5px;
                    stroke-color: #7A2E14;
                    shadow: #3A1408;
                }
            }
            Text {
                text: Tr.t("Hz_Titre");
                font-size: 18px;
                font-weight: 800;
                color: white;
            }
            Text {
                text: HomeState.horizon-builds.length + " builds · Rust · MIT · " + Tr.t("Hz_Puce_Officiel");
                font-size: 13px;
                color: #F6D5C8;
            }
        }
    }

    // builds
    HorizontalLayout {
        spacing: 8px;
        PixelLabel {
            text: Tr.t("Hz_Builds");
            font-size: 10.5px;
        }
        if HomeState.horizon-loading: Icon {
            text: "\u{E895}";
            font-size: 11px;
            color: #F0795A;
            transform-rotation: (animation-tick() / 1000ms) * 360deg;
        }
        Rectangle { horizontal-stretch: 1; }
    }
    grille-builds := ScrollView {
        vertical-stretch: 1;
        property <int> colonnes: max(2, floor((self.visible-width + 8px) / 190px));
        property <length> largeur: (self.visible-width - 8px - (self.colonnes - 1) * 8px) / self.colonnes;
        // les builds filtrés (Tous, Nightly, Stables) sont rangés à la suite
        property <[HorizonBuild]> visibles: HomeState.horizon-builds;
        content-width: self.visible-width;
        content-height: ceil(HomeState.horizon-visibles / self.colonnes) * 50px + 10px;
        for b[i] in HomeState.horizon-builds: PuceBuild {
            property <int> rang: HomeState.horizon-ranks[i];
            visible: self.rang >= 0;
            x: 4px + Math.mod(max(0, self.rang), grille-builds.colonnes) * (grille-builds.largeur + 8px);
            y: 4px + floor(max(0, self.rang) / grille-builds.colonnes) * 50px;
            width: grille-builds.largeur;
            b: b;
            checked: HomeState.horizon-selected && b.tag == HomeState.horizon-build;
        }
    }

    if HomeState.horizon-message != "": Text {
        text: HomeState.horizon-message;
        font-size: 12.5px;
        color: Theme.navy2;
        wrap: word-wrap;
    }

    // en bas : compte requis, build choisi, actions (comme la ligne des mod loaders)
    HorizontalLayout {
        spacing: 10px;
        if HomeState.horizon-build != "": VerticalLayout {
            alignment: center;
            PixelLabel {
                text: HomeState.horizon-build;
                font-size: 11px;
                color: #F0795A;
            }
        }
        if HomeState.horizon-build != "": VerticalLayout {
            alignment: center;
            IconButton {
                width: 36px;
                height: 36px;
                icon: "\u{E74D}";
                icon-size: 13px;
                tooltip: Tr.t("Hz_Supprimer");
                enabled: !HomeState.horizon-busy;
                clicked => { HomeState.horizon-remove(HomeState.horizon-build); }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            MButton {
                icon: "\u{E73E}";
                text: Tr.t("Ver_Valider");
                enabled: HomeState.horizon-build != "";
                clicked => {
                    HomeState.horizon-select(HomeState.horizon-build);
                    HomeState.picker-open = false;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            MButton {
                kind: 1;
                icon: "\u{E768}";
                text: HomeState.horizon-build != "" ? Tr.t("Hz_Jouer") : Tr.t("Hz_ChoisisBuild");
                enabled: HomeState.horizon-build != "" && !HomeState.horizon-busy;
                clicked => { HomeState.horizon-play(); }
            }
        }
    }
}

export component VersionPicker inherits Rectangle {
    property <bool> ouvert: HomeState.picker-open;
    property <bool> a-groupe: HomeState.picker-group >= 0 && HomeState.picker-group < HomeState.picker-groups.length;
    property <VersionGroup> groupe: self.a-groupe ? HomeState.picker-groups[HomeState.picker-group] : { title: "", name: "" };
    opacity: root.ouvert ? 1 : 0;
    visible: self.opacity > 0.01;
    animate opacity { duration: root.ouvert ? 200ms : 150ms; easing: ease-out; }

    Rectangle { background: Theme.scrim; }
    TouchArea {
        enabled: root.ouvert;
        clicked => { HomeState.picker-open = false; }
    }

    carte := Rectangle {
        width: min(1180px, parent.width - 60px);
        height: min(720px, parent.height - 40px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (root.ouvert ? 0px : 16px);
        border-radius: 26px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.glass-border;
        drop-shadow-blur: 50px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: Theme.shadow;
        transform-scale: root.ouvert ? 1 : 0.96;
        animate y, transform-scale { duration: root.ouvert ? 380ms : 160ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        clip: true;
        TouchArea { }

        VerticalLayout {
            padding: 22px;
            spacing: 14px;

            // ── En-tête ──
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: Tr.t("Ver_Titre");
                    font-size: 24px;
                    font-weight: 800;
                    color: Theme.navy;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                if HomeState.picker-tab == 0: VerticalLayout {
                    alignment: center;
                    GlassInput {
                        width: 230px;
                        height: 38px;
                        search: true;
                        placeholder: Tr.t("Ver_Recherche");
                        text <=> HomeState.picker-search;
                        edited => { HomeState.picker-changed(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 6px;
                        Puce {
                            text: Tr.t("Ver_Onglet_Versions");
                            checked: HomeState.picker-tab == 0;
                            clicked => { HomeState.picker-tab = 0; }
                        }
                        Puce {
                            text: Tr.t("Ver_Onglet_Profils");
                            checked: HomeState.picker-tab == 1;
                            clicked => { HomeState.picker-tab = 1; }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: fermer.has-hover ? Theme.glass-hover : Theme.glass;
                        border-width: 1px;
                        border-color: fermer.has-hover ? Theme.accent : Theme.glass-border;
                        transform-rotation: fermer.has-hover ? 90deg : 0deg;
                        animate transform-rotation { duration: 260ms; easing: ease-out; }
                        animate background, border-color { duration: Theme.fast; }
                        Icon {
                            text: "\u{E8BB}";
                            font-size: 12px;
                        }
                        fermer := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { HomeState.picker-open = false; }
                        }
                    }
                }
            }

            // ── Filtres : types, loader compatible, recherche ──
            if HomeState.picker-tab == 0 && HomeState.picker-horizon: HorizontalLayout {
                spacing: 6px;
                for f[i] in [Tr.t("Ver_TousLoaders"), "Nightly", Tr.t("Hz_Stables")]: Puce {
                    text: f;
                    point: i == 1 ? #FFBE5A : i == 2 ? #1DE062 : transparent;
                    checked: HomeState.horizon-filter == i;
                    clicked => {
                        HomeState.horizon-filter = i;
                        HomeState.horizon-filter-changed();
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if HomeState.picker-tab == 0 && !HomeState.picker-horizon: HorizontalLayout {
                spacing: 6px;
                for t[i] in [Tr.t("Ver_Releases"), "Snapshots", Tr.t("Ver_Betas"), "Alphas"]: Puce {
                    text: t;
                    point: Couleurs.types[i];
                    checked: i == 0 ? HomeState.picker-release : i == 1 ? HomeState.picker-snapshot : i == 2 ? HomeState.picker-beta : HomeState.picker-alpha;
                    clicked => {
                        if (i == 0) { HomeState.picker-release = !HomeState.picker-release; }
                        if (i == 1) { HomeState.picker-snapshot = !HomeState.picker-snapshot; }
                        if (i == 2) { HomeState.picker-beta = !HomeState.picker-beta; }
                        if (i == 3) { HomeState.picker-alpha = !HomeState.picker-alpha; }
                        HomeState.picker-changed();
                    }
                }
            }

            // ── Versions : mises à jour à gauche, détail à droite ──
            if HomeState.picker-tab == 0: HorizontalLayout {
                vertical-stretch: 1;
                spacing: 16px;

                // colonne des mises à jour
                Rectangle {
                    width: 300px;
                    border-radius: 18px;
                    background: Theme.surface-2;
                    border-width: 1px;
                    border-color: Theme.line;
                    clip: true;
                    ScrollView {
                        x: 8px;
                        y: 8px;
                        width: parent.width - 16px;
                        height: parent.height - 16px;
                        content-width: self.visible-width;
                        content-height: (HomeState.picker-groups.length + 1) * 78px + 10px;
                        LigneHorizon {
                            x: 0;
                            y: 0;
                            width: parent.width - 4px;
                            checked: HomeState.picker-horizon;
                            clicked => {
                                HomeState.picker-horizon = true;
                                HomeState.horizon-refresh();
                            }
                        }
                        for g[i] in HomeState.picker-groups: LigneGroupe {
                            x: 0;
                            y: 88px + i * 78px;
                            width: parent.width - 4px;
                            g: g;
                            checked: !HomeState.picker-horizon && i == HomeState.picker-group;
                            clicked => {
                                HomeState.picker-horizon = false;
                                HomeState.picker-group-selected(i);
                            }
                        }
                    }
                    if HomeState.picker-groups.length == 0: Text {
                        y: 30px;
                        width: parent.width;
                        text: Tr.t("Ver_Aucune");
                        font-size: 13px;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                // Horizon
                if HomeState.picker-horizon: PanneauHorizon {
                    horizontal-stretch: 1;
                }

                // détail de la mise à jour choisie
                if !HomeState.picker-horizon && root.a-groupe: VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 14px;

                    // grande bannière illustrée
                    Rectangle {
                        height: 200px;
                        border-radius: 20px;
                        clip: true;
                        border-width: 1px;
                        border-color: Theme.glass-border;
                        Image {
                            // toute la largeur, aux proportions de l'illustration (160 × 90) ; le bas visible
                            // s'arrête juste sous le sol (ligne 82 sur 90), pour montrer le sol et le repère de la mise à jour
                            x: 0;
                            width: parent.width;
                            height: max(parent.height, parent.width * 90 / 160);
                            y: min(0px, parent.height - self.height * 82 / 90);
                            source: root.groupe.art;
                            image-fit: fill;
                            image-rendering: pixelated;
                        }
                        Rectangle {
                            background: @linear-gradient(90deg, #0A0F1DD9 0%, #0A0F1D80 45%, #0A0F1D00 75%);
                        }
                        VerticalLayout {
                            padding: 22px;
                            spacing: 6px;
                            alignment: end;
                            PixelLabel {
                                text: Tr.t("Ver_MiseAJour");
                                font-size: 10.5px;
                                color: #CFE0FF;
                            }
                            HorizontalLayout {
                                alignment: start;
                                OutlinedText {
                                    text: root.groupe.title;
                                    font-size: 44px;
                                    thickness: 4px;
                                    depth: 5px;
                                    stroke-color: #141B2B;
                                    shadow: #0A0E18;
                                }
                            }
                            Text {
                                text: root.groupe.name;
                                font-size: 18px;
                                font-weight: 800;
                                color: white;
                            }
                            Text {
                                text: root.groupe.count + " · " + root.groupe.years;
                                font-size: 13px;
                                color: #CFDAF0;
                            }
                        }
                    }

                    // versions de cette mise à jour
                    PixelLabel {
                        text: Tr.t("Ver_Onglet_Versions");
                        font-size: 10.5px;
                    }
                    grille := ScrollView {
                        vertical-stretch: 1;
                        property <int> colonnes: max(3, floor((self.visible-width + 8px) / 128px));
                        property <length> largeur: (self.visible-width - 8px - (self.colonnes - 1) * 8px) / self.colonnes;
                        content-width: self.visible-width;
                        content-height: ceil(HomeState.picker-sub.length / self.colonnes) * 50px + 10px;
                        for v[i] in HomeState.picker-sub: PuceVersion {
                            x: 4px + Math.mod(i, grille.colonnes) * (grille.largeur + 8px);
                            y: 4px + floor(i / grille.colonnes) * 50px;
                            width: grille.largeur;
                            v: v;
                            checked: HomeState.quick && !HomeState.horizon-selected && v.id == HomeState.card-version;
                            clicked => { HomeState.version-picked(v.id); }
                        }
                    }

                    // mod loader de la version choisie, puis valider
                    PixelLabel {
                        text: Tr.t("Commun_ModLoader");
                        font-size: 10.5px;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        for m[i] in HomeState.modes: CarteLoader {
                            text: m;
                            checked: i == HomeState.mode-index;
                            enabled: HomeState.modes-enabled;
                            clicked => {
                                HomeState.mode-index = i;
                                HomeState.mode-selected(i);
                            }
                        }
                        if HomeState.modes.length == 0: VerticalLayout {
                            alignment: center;
                            Text {
                                text: Tr.t("Ver_LoadersAttente");
                                font-size: 13px;
                                color: Theme.text-muted;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            MButton {
                                kind: 1;
                                icon: "\u{E73E}";
                                text: Tr.t("Ver_Valider");
                                clicked => { HomeState.picker-open = false; }
                            }
                        }
                    }
                }
            }

            // ── Profils : cartes illustrées ──
            if HomeState.picker-tab == 1: profils := ScrollView {
                vertical-stretch: 1;
                property <int> colonnes: max(2, floor((self.visible-width + 14px) / 300px));
                property <length> largeur: (self.visible-width - 8px - (self.colonnes - 1) * 14px) / self.colonnes;
                content-width: self.visible-width;
                content-height: ceil(HomeState.profile-items.length / self.colonnes) * 186px + 10px;
                for p[i] in HomeState.profile-items: CarteProfil {
                    x: 4px + Math.mod(i, profils.colonnes) * (profils.largeur + 14px);
                    y: 4px + floor(i / profils.colonnes) * 186px;
                    width: profils.largeur;
                    height: 172px;
                    p: p;
                    checked: i == HomeState.profile-index;
                    clicked => {
                        HomeState.profile-index = i;
                        HomeState.profile-selected(i);
                        HomeState.picker-open = false;
                    }
                }
            }
        }
    }
}
