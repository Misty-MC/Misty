// Fenêtre principale : cadre, barre latérale, pages, fenêtre des options, boîte de dialogue.

import { Theme, Tr, Assets, Bulle } from "theme.slint";
import { AppState, DialogState, HomeState, ProfilesState, InstanceState, BrowserState, SettingsState, ChangelogState, PacksState, EditorState } from "state.slint";
import { Icon, PixelLabel, BodyText, SectionTitle, IconButton, ChromeButton, MButton } from "widgets.slint";
import { HomePage } from "home.slint";
import { ProfilesPage, ProfileCreateOverlay, ProfileWaitOverlay } from "profiles.slint";
import { InstancePage } from "instance.slint";
import { SettingsModal, StorageOverlay } from "settings.slint";
import { ChangelogPage } from "changelog.slint";
import { SkinState } from "skin.slint";
import { PacksPage, PackCreateOverlay } from "packs.slint";
import { EditorPage } from "editor.slint";
import { ScrollView } from "std-widgets.slint";

export { Theme, Tr, Assets, Bulle, AppState, DialogState, HomeState, ProfilesState, InstanceState, BrowserState, SettingsState, ChangelogState, PacksState, EditorState, SkinState }

/// Bouton de navigation de la barre latérale. Le fond de l'onglet actif est dessiné par la barre
/// (un indicateur qui glisse d'un onglet à l'autre) : le bouton ne fait que l'icône et le survol.
component NavButton inherits Rectangle {
    in property <string> icon;
    in property <string> tooltip;
    in property <bool> checked;
    callback clicked;

    width: 50px;
    height: 50px;
    border-radius: 15px;
    background: !root.checked && touch.has-hover ? #FFFFFF1F : transparent;
    border-width: 1px;
    border-color: !root.checked && touch.has-hover ? #FFFFFF33 : transparent;
    animate background, border-color { duration: Theme.normal; }

    Icon {
        text: root.icon;
        font-size: 18px;
        color: root.checked ? (Theme.dark ? Theme.on-fill : #1C2335) : white;
        opacity: root.checked || touch.has-hover ? 1 : 0.82;
        transform-scale: touch.pressed ? 0.86 : touch.has-hover ? 1.08 : 1;
        animate color, opacity { duration: Theme.normal; }
        animate transform-scale { duration: 160ms; easing: ease-out; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            Bulle.visible = false;
            root.clicked();
        }
    }

    // Bulle d'aide : affichée par la fenêtre, à droite du bouton
    property <bool> survol: touch.has-hover;
    changed survol => {
        if (self.survol) {
            Bulle.texte = root.tooltip;
            Bulle.x = root.absolute-position.x + root.width + 12px;
            Bulle.y = root.absolute-position.y + root.height / 2;
            Bulle.a-droite = true;
            Bulle.visible = true;
        } else if (Bulle.texte == root.tooltip) {
            Bulle.visible = false;
        }
    }
}

/// Page qui apparaît en fondu en glissant vers le haut.
component Apparition inherits Rectangle {
    opacity: 0;
    property <length> decalage: 14px;
    animate opacity { duration: 280ms; easing: ease-out; }
    animate decalage { duration: 380ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    init => {
        self.opacity = 1;
        self.decalage = 0;
    }
    Rectangle {
        y: root.decalage;
        @children
    }
}

export component MainWindow inherits Window {
    title: "Misty";
    // Slint ne lit pas le format .ico : on utilise la version PNG
    icon: @image-url("../assets/icone.png");
    // Taille d'origine par défaut ; la fenêtre peut ensuite être agrandie ou redimensionnée
    preferred-width: 1180px;
    preferred-height: 720px;
    min-width: 1040px;
    min-height: 660px;
    no-frame: true;
    resize-border-width: AppState.maximized ? 0px : 6px;
    // transparent : les coins arrondis du fond laissent voir le bureau
    background: transparent;
    default-font-family: Theme.ui-font;

    // Changement de page : le bouton survolé a pu disparaître, on cache sa bulle
    property <int> page: AppState.page;
    changed page => {
        Bulle.visible = false;
    }
    changed height => {
        Bulle.fenetre-hauteur = self.height;
    }

    // Position de l'indicateur de la barre latérale (onglets 0, 1, 3, 4 → cases 0 à 3)
    property <int> case-nav: AppState.nav == 0 ? 0 : AppState.nav == 1 ? 1 : AppState.nav == 3 ? 2 : AppState.nav == 4 ? 3 : -1;

    clavier := FocusScope {
        key-pressed(e) => {
            if (DialogState.visible && e.text == Key.Escape) {
                DialogState.cancel();
                return accept;
            }
            if (SettingsState.open && e.text == Key.Escape) {
                SettingsState.close();
                return accept;
            }
            return reject;
        }

        // Tout le contenu est découpé aux coins arrondis de la fenêtre
        Rectangle {
        clip: true;
        border-radius: AppState.maximized ? 0px : 18px;
        background: Theme.sky;

        // ═══ Fond : ciel de brume le jour, nuit étoilée le soir ═══
        Rectangle {
            clip: true;
            background: @linear-gradient(135deg, #BAD6F7 0%, #95B9E4 45%, #5B7FB0 100%);

            // nuit : fond du site (dégradé bleu nuit)
            Rectangle {
                opacity: Theme.dark ? 1 : 0;
                animate opacity { duration: 450ms; easing: ease-in-out; }
                background: @linear-gradient(160deg, #0E1527 0%, #0A0F1D 55%, #070B16 100%);
            }

            // vignette sombre en bas à droite
            Rectangle {
                property <length> r: 1060px;
                x: parent.width - self.r;
                y: parent.height - self.r;
                width: self.r * 2;
                height: self.r * 2;
                background: Theme.dark ? @radial-gradient(circle, #16214099 0%, #16214000 60%) : @radial-gradient(circle, #3F4A5EAA 0%, #3F4A5E00 60%);
            }
            // halo en haut (lune la nuit)
            Rectangle {
                property <length> r: 700px;
                x: parent.width * 0.45 - self.r;
                y: -self.r;
                width: self.r * 2;
                height: self.r * 2;
                background: Theme.dark ? @radial-gradient(circle, #6F9CFF33 0%, #6F9CFF00 60%) : @radial-gradient(circle, #E4F1FF88 0%, #E4F1FF00 60%);
            }
            // bloc fantôme en bas à gauche
            Image {
                x: 40px;
                y: parent.height - 130px;
                width: 170px;
                height: 170px;
                source: Assets.grass;
                image-rendering: pixelated;
                opacity: Theme.dark ? 0.06 : 0.13;
                transform-rotation: -14deg;
            }
            // carrés flottants (étoiles la nuit)
            if Theme.particles: Rectangle {
                for p in AppState.particles: Rectangle {
                    // la nuit, chaque carré devient une petite étoile qui scintille (comme sur le site)
                    property <length> taille: Theme.dark ? max(2px, p.size * 0.22) : p.size;
                    x: p.x * (root.width / 1180px) + (p.size - self.taille) / 2;
                    y: p.y * (root.height / 720px) + p.amp * sin((animation-tick() / p.period) * 360deg) + (p.size - self.taille) / 2;
                    width: self.taille;
                    height: self.taille;
                    border-radius: self.taille / 5;
                    background: Theme.dark ? #DCE8FF : white;
                    drop-shadow-blur: Theme.dark ? 6px : 0px;
                    drop-shadow-color: #9CC0FF;
                    opacity: Theme.dark ? 0.3 + 0.6 * abs(sin((animation-tick() / (p.period * 0.7)) * 180deg)) : p.opacity;
                }
            }
        }

        HorizontalLayout {
            spacing: 0px;

            // ═══ Barre latérale ═══
            Rectangle {
                width: 92px;
                Rectangle {
                    x: 14px;
                    y: 14px;
                    width: parent.width - 18px;
                    height: parent.height - 28px;
                    border-radius: 22px;
                    background: Theme.dark ? #FFFFFF0A : #1C233559;
                    border-width: 1px;
                    border-color: Theme.dark ? #FFFFFF14 : #FFFFFF40;
                    animate background { duration: 450ms; }

                    VerticalLayout {
                        padding-top: 16px;
                        padding-bottom: 16px;
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 0px;
                            HorizontalLayout {
                                alignment: center;
                                padding-bottom: 26px;
                                Rectangle {
                                    width: 50px;
                                    height: 50px;
                                    border-radius: 15px;
                                    background: Theme.dark ? #162140 : #1C2335;
                                    border-width: 2px;
                                    border-color: Theme.dark ? #6F9CFF66 : #FFFFFF66;
                                    Image {
                                        width: 34px;
                                        height: 34px;
                                        source: @image-url("../assets/logo-nuage.png");
                                    }
                                }
                            }
                            // Onglets : l'indicateur glisse sous l'onglet actif
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 50px;
                                    height: 4 * 50px + 3 * 10px;

                                    indicateur := Rectangle {
                                        y: max(0, root.case-nav) * 60px;
                                        width: 50px;
                                        height: 50px;
                                        border-radius: 15px;
                                        opacity: root.case-nav >= 0 ? 1 : 0;
                                        background: Theme.dark ? Theme.fill : white;
                                        drop-shadow-blur: 14px;
                                        drop-shadow-color: Theme.dark ? #6F9CFF80 : #FFFFFF90;
                                        animate y { duration: 420ms; easing: cubic-bezier(0.34, 1.32, 0.64, 1); }
                                        animate opacity { duration: Theme.normal; }
                                    }

                                    NavButton {
                                        y: 0;
                                        icon: "\u{E80F}";
                                        tooltip: Tr.t("Nav_Jouer");
                                        checked: AppState.nav == 0;
                                        clicked => { AppState.nav-clicked(0); }
                                    }
                                    NavButton {
                                        y: 60px;
                                        icon: "\u{E8F1}";
                                        tooltip: Tr.t("Nav_Profils");
                                        checked: AppState.nav == 1;
                                        clicked => { AppState.nav-clicked(1); }
                                    }
                                    NavButton {
                                        y: 120px;
                                        icon: "\u{E81C}";
                                        tooltip: Tr.t("Nav_Notes");
                                        checked: AppState.nav == 3;
                                        clicked => { AppState.nav-clicked(3); }
                                    }
                                    NavButton {
                                        y: 180px;
                                        icon: "\u{E790}";
                                        tooltip: Tr.t("Nav_Soon");
                                        checked: AppState.nav == 4;
                                        clicked => { AppState.nav-clicked(4); }
                                    }
                                }
                            }
                        }

                        // bas : options + dossier + version
                        VerticalLayout {
                            spacing: 12px;
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 50px;
                                    height: 50px;
                                    // l'engrenage reste allumé tant que la fenêtre des options est ouverte
                                    Rectangle {
                                        border-radius: 15px;
                                        background: Theme.dark ? Theme.fill : white;
                                        opacity: SettingsState.open ? 1 : 0;
                                        transform-scale: SettingsState.open ? 1 : 0.7;
                                        animate opacity { duration: Theme.normal; }
                                        animate transform-scale { duration: 300ms; easing: cubic-bezier(0.34, 1.32, 0.64, 1); }
                                    }
                                    NavButton {
                                        icon: "\u{E713}";
                                        tooltip: Tr.t("Nav_Options");
                                        checked: SettingsState.open;
                                        clicked => { AppState.nav-clicked(2); }
                                    }
                                }
                            }
                            HorizontalLayout {
                                alignment: center;
                                IconButton {
                                    icon: "\u{E8B7}";
                                    encre: white;
                                    fond: #FFFFFF1A;
                                    bord: #FFFFFF33;
                                    tooltip: Tr.t("Nav_Dossier");
                                    clicked => { AppState.open-data-folder(); }
                                }
                            }
                            PixelLabel {
                                text: AppState.version-text;
                                font-size: 9px;
                                color: #FFFFFFCC;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // ═══ Contenu ═══
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;

                // Barre de titre : on peut y attraper la fenêtre pour la déplacer,
                // et double-cliquer pour l'agrandir
                Rectangle {
                    height: 46px;
                    TouchArea {
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                                AppState.drag();
                            }
                        }
                        double-clicked => { AppState.toggle-maximize(); }
                    }
                    HorizontalLayout {
                        alignment: end;
                        padding-top: 8px;
                        padding-right: 10px;
                        padding-bottom: 4px;
                        spacing: 4px;
                        ChromeButton {
                            icon: "\u{E921}";
                            clicked => { AppState.minimize(); }
                        }
                        ChromeButton {
                            icon: AppState.maximized ? "\u{E923}" : "\u{E922}";
                            clicked => { AppState.toggle-maximize(); }
                        }
                        ChromeButton {
                            icon: "\u{E8BB}";
                            close: true;
                            clicked => { AppState.close(); }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    if AppState.page == 0: Apparition { HomePage { } }
                    if AppState.page == 1: Apparition { ProfilesPage { } }
                    if AppState.page == 3: Apparition { ChangelogPage { } }
                    if AppState.page == 4: Apparition { PacksPage { } }
                    if AppState.page == 5: Apparition { InstancePage { } }
                    if AppState.page == 6: Apparition { EditorPage { } }
                }
            }
        }

        // ═══ Fenêtre des options (toujours présente, pour pouvoir animer sa fermeture) ═══
        SettingsModal { }

        // ═══ Bulle d'aide (au-dessus des pages) ═══
        if Bulle.visible && !DialogState.visible: Rectangle {
            width: bulle-texte.preferred-width + 20px;
            height: 28px;
            // reste dans la fenêtre
            x: clamp(Bulle.a-droite ? Bulle.x : Bulle.x - self.width / 2, 6px, root.width - self.width - 6px);
            y: Bulle.a-droite ? Bulle.y - self.height / 2 : Bulle.y;
            border-radius: 9px;
            background: Theme.dark ? #162140 : #1C2335;
            border-width: 1px;
            border-color: Theme.dark ? #FFFFFF1F : transparent;
            drop-shadow-blur: 10px;
            drop-shadow-color: Theme.shadow;
            opacity: 0;
            animate opacity { delay: 300ms; duration: 150ms; }
            init => { self.opacity = 0.97; }
            bulle-texte := Text {
                text: Bulle.texte;
                color: white;
                font-family: Theme.ui-font;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // ═══ Fenêtres modales des pages (sur toute la fenêtre, barre latérale comprise) ═══
        if ProfilesState.creating: ProfileCreateOverlay { }
        if ProfilesState.waiting: ProfileWaitOverlay { }
        if PacksState.creating: PackCreateOverlay { }
        if SettingsState.storage-open: StorageOverlay { }

        // ═══ Boîte de dialogue ═══
        if DialogState.visible: Rectangle {
            background: Theme.scrim;
            opacity: 0;
            animate opacity { duration: 200ms; }
            init => {
                self.opacity = 1;
                clavier.focus();
            }
            TouchArea { }

            carte := Rectangle {
                width: 440px;
                height: contenu.preferred-height;
                border-radius: 24px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.glass-border;
                drop-shadow-blur: 40px;
                drop-shadow-color: Theme.shadow;
                transform-scale: 0.94;
                animate transform-scale { duration: 300ms; easing: cubic-bezier(0.34, 1.32, 0.64, 1); }
                init => { self.transform-scale = 1; }

                contenu := VerticalLayout {
                    padding-left: 28px;
                    padding-right: 28px;
                    padding-top: 26px;
                    padding-bottom: 26px;
                    spacing: 12px;

                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: 10px;
                            background: DialogState.danger ? Theme.danger : Theme.blue;
                            Icon {
                                text: DialogState.icon;
                                color: white;
                            }
                        }
                        SectionTitle {
                            horizontal-stretch: 1;
                            text: DialogState.title;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    Text {
                        text: DialogState.message;
                        font-family: Theme.ui-font;
                        font-size: 14px;
                        color: Theme.navy2;
                        wrap: word-wrap;
                    }
                    // options (mode « choix dans une liste »)
                    if DialogState.choices.length > 0: ScrollView {
                        height: min(260px, DialogState.choices.length * 50px);
                        content-height: DialogState.choices.length * 50px;
                        content-width: self.visible-width;
                        for c[i] in DialogState.choices: MButton {
                            x: 0;
                            y: i * 50px;
                            width: parent.width - 12px;
                            text: c;
                            clicked => { DialogState.choose(i); }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 10px;
                        padding-top: 12px;
                        if DialogState.cancel-text != "": MButton {
                            text: DialogState.cancel-text;
                            clicked => { DialogState.cancel(); }
                        }
                        if DialogState.ok-text != "": MButton {
                            kind: DialogState.danger && DialogState.cancel-text != "" ? 2 : 1;
                            text: DialogState.ok-text;
                            clicked => { DialogState.ok(); }
                        }
                    }
                }
            }
        }
        }
    }
}
