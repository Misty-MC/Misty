// Options, classées par catégories (navigation à gauche, contenu à droite) : langue, comptes, mémoire, versions, comportement, stockage, à propos.

import { Theme, Tr } from "theme.slint";
import { SettingsState, StorageRow } from "state.slint";
import { Icon, PixelLabel, BodyText, SectionTitle, OutlinedText, GlassCard, IconButton, MButton, GlassInput, ToggleSwitch, GlassSlider, LangCombo, ChromeButton } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

component Pseudo inherits Rectangle {
    in property <string> text;
    callback remove();
    height: 38px;
    width: t.preferred-width + 54px;
    border-radius: 12px;
    background: Theme.glass-strong;
    border-width: 1.5px;
    border-color: Theme.glass-border;
    t := Text {
        x: 12px;
        text: root.text;
        font-family: Theme.ui-font;
        font-weight: 600;
        font-size: 13px;
        color: Theme.navy;
        vertical-alignment: center;
    }
    ChromeButton {
        x: parent.width - 32px;
        y: 5px;
        width: 28px;
        height: 28px;
        icon: "\u{E8BB}";
        close: true;
        clicked => { root.remove(); }
    }
}

/// Ligne d'un compte Microsoft : pseudo, « utiliser » si ce n'est pas le compte actif, oublier.
component LigneCompte inherits Rectangle {
    in property <string> pseudo;
    in property <bool> active;
    callback use();
    callback forget();
    height: 44px;
    border-radius: 12px;
    background: root.active ? Theme.navy : Theme.glass-strong;
    border-width: 1.5px;
    border-color: root.active ? Theme.navy : Theme.glass-border;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 10px;
        if root.active: Icon {
            text: "\u{E73E}";
            color: Theme.green;
            font-size: 13px;
        }
        Text {
            horizontal-stretch: 1;
            text: root.pseudo;
            font-family: Theme.ui-font;
            font-weight: 600;
            font-size: 13px;
            color: root.active ? white : Theme.navy;
            vertical-alignment: center;
            overflow: elide;
        }
        if !root.active: VerticalLayout {
            alignment: center;
            MButton {
                text: Tr.t("Compte_Utiliser");
                clicked => { root.use(); }
            }
        }
        VerticalLayout {
            alignment: center;
            ChromeButton {
                width: 28px;
                height: 28px;
                icon: "\u{E8BB}";
                close: true;
                encre: root.active ? white : Theme.navy;
                clicked => { root.forget(); }
            }
        }
    }
}

// ───────────── Navigation par catégories (à la Modrinth) ─────────────

/// Titre de groupe dans la colonne de navigation (AFFICHAGE, COMPTES…).
component GroupeNav inherits Rectangle {
    in property <string> text;
    height: 32px;
    Text {
        x: 12px;
        y: parent.height - self.height - 4px;
        text: root.text;
        font-family: Theme.pixel-font;
        font-size: 11px;
        color: Theme.text-muted;
    }
}

/// Entrée de la colonne de navigation : icône + libellé, surlignée quand elle est choisie.
component EntreeNav inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> checked;
    callback clicked;

    height: 38px;
    border-radius: 12px;
    background: root.checked ? Theme.navy : touch.has-hover ? Theme.glass-hover : transparent;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        Icon {
            width: 18px;
            text: root.icon;
            font-size: 15px;
            color: root.checked ? Theme.green : Theme.navy;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-family: Theme.ui-font;
            font-size: 14px;
            font-weight: 600;
            color: root.checked ? white : Theme.navy;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// En-tête d'un bloc de réglages : titre pixel + description.
component Entete inherits VerticalLayout {
    in property <string> titre;
    in property <string> texte;
    spacing: 4px;
    SectionTitle { text: root.titre; }
    if root.texte != "": BodyText { text: root.texte; }
}

/// Ligne « titre + description » avec l'interrupteur à droite.
component LigneInterrupteur inherits HorizontalLayout {
    in property <string> titre;
    in property <string> texte;
    in-out property <bool> checked;
    callback toggled(bool);
    spacing: 16px;
    Entete {
        horizontal-stretch: 1;
        titre: root.titre;
        texte: root.texte;
    }
    VerticalLayout {
        alignment: center;
        ToggleSwitch {
            width: 44px;
            checked <=> root.checked;
            toggled(v) => { root.toggled(v); }
        }
    }
}

/// Option secondaire (dans un bloc) : libellé à gauche, interrupteur à droite.
component OptionInterrupteur inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);
    height: 48px;
    border-radius: 12px;
    background: Theme.glass;
    border-width: 1px;
    border-color: Theme.glass-border;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 14px;
        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-family: Theme.ui-font;
            font-size: 14px;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            ToggleSwitch {
                width: 44px;
                checked <=> root.checked;
                toggled(v) => { root.toggled(v); }
            }
        }
    }
}

component Separateur inherits Rectangle {
    height: 1.5px;
    background: Theme.glass-border;
}

export component SettingsPage inherits Rectangle {
    // 0 langue · 1 Microsoft · 2 hors-ligne · 3 mémoire · 4 versions · 5 comportement · 6 stockage · 7 à propos
    property <int> section: 0;

    VerticalLayout {
        padding-left: 26px;
        padding-right: 30px;
        padding-bottom: 26px;
        spacing: 18px;

        HorizontalLayout {
            padding-left: 6px;
            alignment: start;
            OutlinedText {
                text: Tr.t("Options_Title");
                font-size: 48px;
                depth: 5px;
            }
        }

        GlassCard {
            vertical-stretch: 1;
            clip: true;

            HorizontalLayout {
                // ═══ Colonne de navigation ═══
                Rectangle {
                    width: 236px;
                    background: #FFFFFF33;

                    VerticalLayout {
                        padding: 12px;
                        padding-top: 6px;
                        spacing: 8px;

                        ScrollView {
                            vertical-stretch: 1;
                            content-width: self.visible-width;
                            content-height: nav.preferred-height;
                            nav := VerticalLayout {
                                width: parent.visible-width;
                                spacing: 2px;
                                GroupeNav { text: Tr.t("Param_Groupe_Affichage"); }
                                EntreeNav { icon: "\u{E774}"; text: Tr.t("Param_Langue"); checked: root.section == 0; clicked => { root.section = 0; } }

                                GroupeNav { text: Tr.t("Param_Groupe_Comptes"); }
                                EntreeNav { icon: "\u{E77B}"; text: Tr.t("Param_Microsoft"); checked: root.section == 1; clicked => { root.section = 1; } }
                                EntreeNav { icon: "\u{E716}"; text: Tr.t("Param_HorsLigne"); checked: root.section == 2; clicked => { root.section = 2; } }

                                GroupeNav { text: Tr.t("Param_Groupe_Jeu"); }
                                EntreeNav { icon: "\u{E9D9}"; text: Tr.t("Param_Memoire"); checked: root.section == 3; clicked => { root.section = 3; } }
                                EntreeNav { icon: "\u{E8F1}"; text: Tr.t("Param_Versions"); checked: root.section == 4; clicked => { root.section = 4; } }

                                GroupeNav { text: Tr.t("Param_Groupe_Launcher"); }
                                EntreeNav { icon: "\u{E713}"; text: Tr.t("Param_Comportement"); checked: root.section == 5; clicked => { root.section = 5; } }
                                EntreeNav { icon: "\u{EDA2}"; text: Tr.t("Param_Stockage"); checked: root.section == 6; clicked => { root.section = 6; } }
                                EntreeNav { icon: "\u{E946}"; text: Tr.t("Param_APropos"); checked: root.section == 7; clicked => { root.section = 7; } }
                            }
                        }

                        // Pied de colonne : version de Misty (comme « Modrinth App 0.23.1 »)
                        Separateur { }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-top: 4px;
                            spacing: 10px;
                            Image {
                                width: 26px;
                                height: 26px;
                                source: @image-url("../assets/logo-nuage.png");
                                image-fit: contain;
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: SettingsState.about-text;
                                font-family: Theme.ui-font;
                                font-size: 12px;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                Rectangle {
                    width: 1.5px;
                    background: Theme.glass-border;
                }

                // ═══ Contenu de la catégorie choisie ═══
                ScrollView {
                    horizontal-stretch: 1;
                    content-width: self.visible-width;
                    content-height: contenu.preferred-height;

                    contenu := VerticalLayout {
                        width: parent.visible-width;
                        padding: 28px;
                        padding-right: 32px;
                        spacing: 22px;
                        alignment: start;

                        // ── Langue ──
                        if root.section == 0: VerticalLayout {
                            spacing: 14px;
                            Entete {
                                titre: Tr.t("Options_Langue");
                                texte: Tr.t("Options_Langue_Texte");
                            }
                            HorizontalLayout {
                                alignment: start;
                                LangCombo {
                                    width: 300px;
                                    model: SettingsState.langs;
                                    current-index <=> SettingsState.lang-index;
                                    selected(i) => { SettingsState.lang-selected(i); }
                                }
                            }
                        }

                        // ── Compte Microsoft ──
                        if root.section == 1: VerticalLayout {
                            spacing: 14px;
                            Entete {
                                titre: Tr.t("Options_Compte_Microsoft");
                                texte: SettingsState.ms-state;
                            }
                            if SettingsState.ms-accounts.length > 0: VerticalLayout {
                                spacing: 8px;
                                for c in SettingsState.ms-accounts: LigneCompte {
                                    pseudo: c.pseudo;
                                    active: c.active && SettingsState.ms-connected;
                                    use => { SettingsState.ms-switch(c.uuid); }
                                    forget => { SettingsState.ms-forget(c.uuid); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                MButton {
                                    kind: 1;
                                    icon: "\u{E710}";
                                    text: SettingsState.ms-accounts.length == 0 ? Tr.t("Compte_SeConnecter") : Tr.t("Compte_Ajouter");
                                    enabled: !SettingsState.ms-busy;
                                    clicked => { SettingsState.connect(); }
                                }
                                if SettingsState.ms-connected: MButton {
                                    text: Tr.t("Compte_SeDeconnecter");
                                    clicked => { SettingsState.disconnect(); }
                                }
                                MButton {
                                    text: Tr.t("Compte_DeconnexionTotale");
                                    clicked => { SettingsState.disconnect-all(); }
                                }
                            }
                        }

                        // ── Comptes hors-ligne ──
                        if root.section == 2: VerticalLayout {
                            spacing: 14px;
                            Entete {
                                titre: Tr.t("Options_hors_ligne");
                                texte: Tr.t("Options_hors_ligne_text");
                            }
                            // Liste des pseudos, découpée en lignes par Rust
                            if SettingsState.pseudo-rows.length > 0: VerticalLayout {
                                spacing: 8px;
                                for ligne in SettingsState.pseudo-rows: HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    for p in ligne.items: Pseudo {
                                        text: p;
                                        remove => { SettingsState.remove-pseudo(p); }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                GlassInput {
                                    horizontal-stretch: 1;
                                    text <=> SettingsState.new-pseudo;
                                    accepted => { SettingsState.add-pseudo(); }
                                }
                                MButton {
                                    kind: 1;
                                    icon: "\u{E710}";
                                    text: Tr.t("Options_bouton_ajout");
                                    clicked => { SettingsState.add-pseudo(); }
                                }
                            }
                        }

                        // ── Mémoire ──
                        if root.section == 3: VerticalLayout {
                            spacing: 16px;
                            HorizontalLayout {
                                spacing: 16px;
                                Entete {
                                    horizontal-stretch: 1;
                                    titre: Tr.t("Options_Ram");
                                    texte: SettingsState.ram-total-text;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        border-radius: 10px;
                                        background: Theme.navy;
                                        width: ram.preferred-width + 24px;
                                        height: 32px;
                                        ram := PixelLabel {
                                            text: SettingsState.ram-text;
                                            color: white;
                                            font-size: 14px;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }
                            GlassSlider {
                                minimum: 1024;
                                maximum: SettingsState.ram-max;
                                step: 1024;
                                value <=> SettingsState.ram-value;
                                changed(v) => { SettingsState.ram-changed(v); }
                            }
                        }

                        // ── Versions affichées ──
                        if root.section == 4: VerticalLayout {
                            spacing: 10px;
                            Entete {
                                titre: Tr.t("Options_Versions");
                                texte: Tr.t("Options_Versions_Texte");
                            }
                            Rectangle { height: 4px; }
                            OptionInterrupteur {
                                text: "Snapshots";
                                checked <=> SettingsState.snapshot;
                                toggled => { SettingsState.types-changed(); }
                            }
                            OptionInterrupteur {
                                text: Tr.t("Options_Betas");
                                checked <=> SettingsState.beta;
                                toggled => { SettingsState.types-changed(); }
                            }
                            OptionInterrupteur {
                                text: Tr.t("Options_indev");
                                checked <=> SettingsState.alpha;
                                toggled => { SettingsState.types-changed(); }
                            }
                        }

                        // ── Comportement : raccourci + Rich Presence Discord ──
                        if root.section == 5: VerticalLayout {
                            spacing: 22px;
                            VerticalLayout {
                                spacing: 14px;
                                LigneInterrupteur {
                                    titre: Tr.t("Options_Raccourci");
                                    texte: Tr.t("Options_Raccourci_Texte");
                                    checked <=> SettingsState.shortcut-enabled;
                                    toggled(v) => { SettingsState.shortcut-toggled(v); }
                                }
                                if SettingsState.shortcut-enabled: VerticalLayout {
                                    spacing: 10px;
                                    Rectangle {
                                        height: 34px;
                                        border-radius: 10px;
                                        background: #FFFFFF40;
                                        Text {
                                            x: 12px;
                                            width: parent.width - 24px;
                                            text: SettingsState.shortcut-path;
                                            font-family: Theme.ui-font;
                                            font-size: 13px;
                                            color: Theme.navy2;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;
                                        MButton {
                                            text: Tr.t("Options_ChoisirDossier");
                                            clicked => { SettingsState.choose-shortcut(); }
                                        }
                                        MButton {
                                            text: Tr.t("Options_Recreer");
                                            clicked => { SettingsState.recreate-shortcut(); }
                                        }
                                    }
                                }
                            }
                            Separateur { }
                            LigneInterrupteur {
                                titre: "RICH PRESENCE DISCORD";
                                texte: Tr.t("Options_Discord_Texte");
                                checked <=> SettingsState.rich;
                                toggled(v) => { SettingsState.rich-toggled(v); }
                            }
                        }

                        // ── Stockage ──
                        if root.section == 6: VerticalLayout {
                            spacing: 14px;
                            Entete {
                                titre: Tr.t("Options_Stockage");
                                texte: SettingsState.data-dir;
                            }
                            Rectangle {
                                height: 64px;
                                border-radius: 14px;
                                background: Theme.glass;
                                border-width: 1px;
                                border-color: Theme.glass-border;
                                HorizontalLayout {
                                    padding-left: 18px;
                                    spacing: 12px;
                                    Icon {
                                        width: 20px;
                                        text: "\u{EDA2}";
                                        font-size: 18px;
                                    }
                                    PixelLabel {
                                        horizontal-stretch: 1;
                                        text: SettingsState.size-text;
                                        font-size: 16px;
                                        color: Theme.navy;
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                MButton {
                                    text: Tr.t("Commun_OuvrirDossier");
                                    clicked => { SettingsState.open-folder(); }
                                }
                                MButton {
                                    kind: 1;
                                    text: Tr.t("Stock_Gerer");
                                    clicked => { SettingsState.storage-show(); }
                                }
                                MButton {
                                    kind: 2;
                                    text: Tr.t("Options_ToutSupprimer");
                                    clicked => { SettingsState.delete-all(); }
                                }
                            }
                        }

                        // ── À propos ──
                        if root.section == 7: VerticalLayout {
                            spacing: 14px;
                            HorizontalLayout {
                                spacing: 16px;
                                Image {
                                    width: 56px;
                                    height: 56px;
                                    source: @image-url("../assets/logo-nuage.png");
                                    image-fit: contain;
                                }
                                Entete {
                                    horizontal-stretch: 1;
                                    titre: Tr.t("Options_APropos");
                                    texte: SettingsState.about-text;
                                }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                MButton {
                                    kind: 1;
                                    icon: "\u{E895}";
                                    text: Tr.t("Maj_Rechercher");
                                    icon-spin: SettingsState.checking-update;
                                    clicked => { SettingsState.check-update(); }
                                }
                                MButton {
                                    text: "GitHub";
                                    clicked => { SettingsState.github(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}


component LigneStockage inherits Rectangle {
    in property <StorageRow> r;
    height: r.niveau == 0 ? 62px : 46px;
    border-radius: 12px;
    background: r.niveau == 0 ? #FFFFFF99 : #FFFFFF55;
    border-width: 1px;
    border-color: r.reste ? #FF5A6E88 : #FFFFFFB3;

    // barre de proportion (poids relatif dans le dossier de données)
    if r.niveau == 0 && !r.locked: Rectangle {
        x: 14px;
        y: parent.height - 9px;
        height: 3px;
        width: max(4px, (parent.width - 28px) * r.fraction);
        border-radius: 2px;
        background: Theme.steel;
    }

    TouchArea {
        enabled: r.expandable;
        clicked => { SettingsState.storage-toggle(r.cle); }
    }
    HorizontalLayout {
        padding-left: r.niveau == 0 ? 14px : 40px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: r.niveau == 0 ? 12px : 6px;
        spacing: 10px;
        Icon {
            width: 16px;
            text: r.locked ? "\u{E72E}" : r.expandable ? (r.expanded ? "\u{E70D}" : "\u{E76C}") : "";
            font-size: 12px;
            color: Theme.text-muted;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: r.nom;
                font-family: Theme.ui-font;
                font-size: r.niveau == 0 ? 14px : 13px;
                font-weight: r.niveau == 0 ? 700 : 500;
                color: Theme.text;
                overflow: elide;
            }
            if r.info != "": Text {
                text: r.info;
                font-family: Theme.ui-font;
                font-size: 11px;
                color: r.reste ? Theme.danger : Theme.text-muted;
                overflow: elide;
            }
        }
        Text {
            text: r.size-text;
            font-family: Theme.ui-font;
            font-size: 13px;
            font-weight: 600;
            color: Theme.navy;
            vertical-alignment: center;
        }
        if !r.locked: IconButton {
            icon: "\u{E74D}";
            tooltip: Tr.t("Stock_Supprimer");
            width: 34px;
            height: 34px;
            y: (parent.height - self.height) / 2;
            clicked => { SettingsState.storage-delete(r.cle); }
        }
        if r.locked: Rectangle { width: 34px; }
    }
}

/// Fenêtre modale : couvre toute la fenêtre de l'application (posée par main.slint).
export component StorageOverlay inherits Rectangle {
    background: @linear-gradient(180deg, #14203A73 0%, #14203AA6 100%);
    TouchArea {
        clicked => { SettingsState.storage-close(); }
    }
    Rectangle {
        width: min(640px, parent.width - 40px);
        height: min(620px, parent.height - 40px);
        border-radius: 24px;
        background: #F6FAFFF2;
        border-width: 2px;
        border-color: white;
        drop-shadow-blur: 30px;
        drop-shadow-color: #1C233560;
        TouchArea { }
        VerticalLayout {
            padding: 24px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                SectionTitle {
                    text: Tr.t("Stock_Titre");
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                PixelLabel {
                    text: SettingsState.storage-total;
                    font-size: 13px;
                    color: Theme.navy;
                    vertical-alignment: center;
                }
            }
            BodyText { text: Tr.t("Stock_Intro"); wrap: word-wrap; }
            if SettingsState.storage-busy: Rectangle {
                vertical-stretch: 1;
                Text {
                    text: Tr.t("Options_Calcul");
                    font-family: Theme.pixel-font;
                    font-size: 13px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            if !SettingsState.storage-busy: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 6px;
                    for r in SettingsState.storage-rows: LigneStockage { r: r; }
                }
            }
            HorizontalLayout {
                alignment: end;
                MButton {
                    text: Tr.t("Commun_Fermer");
                    clicked => { SettingsState.storage-close(); }
                }
            }
        }
    }
}
