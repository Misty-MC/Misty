// Notes de version : les releases GitHub du launcher (voir src/ui/changelog.rs), en deux tuiles.
// À gauche la liste des versions (vignette, numéro, date, étiquettes) ; à droite la version choisie :
// son bandeau (image, numéro, date, GitHub), des filtres, puis ses notes (intertitres et lignes).

import { Theme, Tr } from "theme.slint";
import { ChangelogState, ChangelogSection } from "state.slint";
import { Icon, PixelLabel, MButton, Puces, TuilePage, EnTetePage } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

/// Petite étiquette (DERNIÈRE, BÊTA, NOUVEAU, CORRIGÉ).
component Etiquette inherits Rectangle {
    in property <string> text;
    in property <color> couleur;
    /// true : fond plein ; false : fond léger et texte coloré
    in property <bool> plein: false;
    height: 20px;
    width: t.preferred-width + 14px;
    border-radius: 6px;
    background: root.plein ? root.couleur : root.couleur.with-alpha(Theme.dark ? 0.2 : 0.14);
    border-width: root.plein ? 0px : 1px;
    border-color: root.couleur.with-alpha(0.45);
    t := Text {
        text: root.text;
        font-family: Theme.ui-font;
        font-size: 11px;
        font-weight: 700;
        color: root.plein ? white : root.couleur;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// Intertitre des notes (« Launcher », « Misty Client (in game) »).
component Intertitre inherits HorizontalLayout {
    in property <string> text;
    spacing: 10px;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 4px;
            height: 18px;
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    PixelLabel {
        text: root.text;
        font-size: 13px;
        color: Theme.accent;
        wrap: word-wrap;
    }
}

/// Une ligne des notes : étiquette (nouveau, corrigé) ou puce, puis le texte.
component LigneNote inherits Rectangle {
    in property <string> text;
    in property <int> genre;
    min-height: contenu.preferred-height;
    border-radius: 12px;
    background: survol.has-hover ? Theme.glass : transparent;
    animate background { duration: Theme.fast; }
    survol := TouchArea { }
    contenu := HorizontalLayout {
        padding: 8px;
        padding-left: 10px;
        padding-right: 12px;
        spacing: 12px;
        // colonne des étiquettes, de la même largeur partout pour aligner les textes
        Rectangle {
            // assez large pour la plus longue des deux étiquettes, dans la langue choisie
            width: max(mesure-n.preferred-width, mesure-c.preferred-width) + 18px;
            mesure-n := Text { visible: false; text: Tr.t("Notes_Nouveau"); font-size: 11px; font-weight: 700; }
            mesure-c := Text { visible: false; text: Tr.t("Notes_Corrige"); font-size: 11px; font-weight: 700; }
            if root.genre == 1: Etiquette { x: 0; y: 0; text: Tr.t("Notes_Nouveau"); couleur: Theme.green-dark; }
            if root.genre == 2: Etiquette { x: 0; y: 0; text: Tr.t("Notes_Corrige"); couleur: #E8932F; }
            if root.genre == 0: Rectangle {
                x: (parent.width - self.width) / 2 - 6px;
                y: 7px;
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.text-dim;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-family: Theme.ui-font;
            font-size: 13.5px;
            color: Theme.navy2;
            wrap: word-wrap;
        }
    }
}

/// Une ligne est-elle gardée par le filtre ? (genre : -1 intertitre, 0 simple, 1 nouveau, 2 corrigé ;
/// partie : 0 launcher, 1 Misty Client)
global Filtre {
    pure public function garde(filtre: int, genre: int, partie: int) -> bool {
        if (filtre == 0) { return true; }
        if (filtre == 1) { return genre == 1; }
        if (filtre == 2) { return genre == 2; }
        if (filtre == 3) { return partie == 0; }
        return partie == 1;
    }
}

/// Une version dans la liste de gauche : sa vignette, son numéro, sa date et ses étiquettes.
component LigneVersion inherits Rectangle {
    in property <ChangelogSection> s;
    in property <bool> choisie;
    callback clicked;
    height: 60px;
    border-radius: 8px;
    background: root.choisie ? Theme.accent-soft : zone.has-hover ? Theme.glass-hover : transparent;
    border-width: 1px;
    border-color: root.choisie ? Theme.accent.with-alpha(0.5) : transparent;
    animate background, border-color { duration: Theme.fast; }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 6px;
                clip: true;
                background: #1C2335;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.s.art;
                    image-fit: cover;
                    image-rendering: pixelated;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text {
                text: root.s.title;
                font-size: 14px;
                font-weight: 700;
                color: root.choisie ? Theme.accent : Theme.navy;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Text {
                    text: root.s.date;
                    font-size: 12px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                if root.s.recent: Etiquette { text: Tr.t("Notes_Derniere"); couleur: Theme.green-dark; plein: true; }
                if root.s.prerelease: Etiquette { text: Tr.t("Notes_Beta"); couleur: #E8932F; }
            }
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ChangelogPage inherits Rectangle {
    property <int> n: clamp(ChangelogState.selected, 0, max(0, ChangelogState.sections.length - 1));
    property <ChangelogSection> s: ChangelogState.sections[root.n];
    property <int> filtre: ChangelogState.filter;

    HorizontalLayout {
        spacing: 12px;

        // ═══ À gauche : les versions ═══
        TuilePage {
            width: 290px;
            VerticalLayout {
                EnTetePage {
                    titre: Tr.t("Onglet_Notes");
                    info: ChangelogState.sections.length;
                }
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    content-height: liste.preferred-height;
                    liste := VerticalLayout {
                        width: parent.visible-width;
                        padding: 10px;
                        spacing: 4px;
                        alignment: start;
                        for v[i] in ChangelogState.sections: LigneVersion {
                            s: v;
                            choisie: i == root.n;
                            clicked => { ChangelogState.selected = i; }
                        }
                    }
                }
            }
        }

        // ═══ À droite : la version choisie ═══
        TuilePage {
            horizontal-stretch: 1;
            VerticalLayout {
                // bandeau : l'image de la version, son numéro, sa date, ses étiquettes, GitHub
                Rectangle {
                    height: 150px;
                    clip: true;
                    background: #1C2335;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.s.art;
                        image-fit: cover;
                        image-rendering: pixelated;
                    }
                    Rectangle {
                        background: @linear-gradient(180deg, #0A0F1D00 0%, #0A0F1D40 45%, #0A0F1DD9 100%);
                    }
                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 20px;
                        padding-bottom: 18px;
                        spacing: 14px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: end;
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                Text {
                                    text: root.s.title;
                                    font-size: 28px;
                                    font-weight: 800;
                                    color: white;
                                    overflow: elide;
                                }
                                if root.s.recent: VerticalLayout {
                                    alignment: center;
                                    Etiquette { text: Tr.t("Notes_Derniere"); couleur: Theme.green-dark; plein: true; }
                                }
                                if root.s.prerelease: VerticalLayout {
                                    alignment: center;
                                    Etiquette { text: Tr.t("Notes_Beta"); couleur: #E8932F; plein: true; }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                if root.s.date != "": Text {
                                    text: root.s.date;
                                    font-size: 13px;
                                    color: #FFFFFFCC;
                                    vertical-alignment: center;
                                }
                                if root.s.news > 0: Etiquette { text: Tr.t("Notes_Nouveau") + " · " + root.s.news; couleur: Theme.green-dark; plein: true; }
                                if root.s.fixes > 0: Etiquette { text: Tr.t("Notes_Corrige") + " · " + root.s.fixes; couleur: #E8932F; plein: true; }
                            }
                        }
                        if root.s.url != "": VerticalLayout {
                            alignment: end;
                            MButton {
                                icon: "\u{E8A7}";
                                text: Tr.t("Notes_GitHub");
                                clicked => { ChangelogState.open-url(root.s.url); }
                            }
                        }
                    }
                }
                // filtres
                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 14px;
                    padding-bottom: 4px;
                    Puces {
                        model: [Tr.t("Notes_Filtre_Tout"), Tr.t("Notes_Filtre_Nouveau"), Tr.t("Notes_Filtre_Corrige"), Tr.t("Notes_Filtre_Launcher"), Tr.t("Notes_Filtre_Client")];
                        current: ChangelogState.filter;
                        selected(i) => { ChangelogState.filter = i; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                // les notes
                ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    content-height: notes.preferred-height;
                    notes := VerticalLayout {
                        width: parent.visible-width;
                        padding-left: 14px;
                        padding-right: 22px;
                        padding-top: 6px;
                        padding-bottom: 20px;
                        spacing: 2px;
                        alignment: start;
                        for ligne[i] in root.s.lines: VerticalLayout {
                            if root.s.kinds[i] == -1 && (root.filtre == 0 || (root.filtre >= 3 && Filtre.garde(root.filtre, -1, root.s.parts[i]))): VerticalLayout {
                                padding-left: 10px;
                                padding-top: i > 0 ? 14px : 4px;
                                padding-bottom: 4px;
                                Intertitre { text: ligne; }
                            }
                            if root.s.kinds[i] != -1 && Filtre.garde(root.filtre, root.s.kinds[i], root.s.parts[i]): LigneNote {
                                text: ligne;
                                genre: root.s.kinds[i];
                            }
                        }
                        if (root.filtre == 1 && root.s.news == 0) || (root.filtre == 2 && root.s.fixes == 0): Text {
                            text: Tr.t("Notes_Rien");
                            font-size: 13px;
                            color: Theme.text-muted;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
