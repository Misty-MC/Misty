// Barre du bas (sur toutes les pages sauf le détail d'un profil et l'éditeur), en tuiles alignées
// sur la grille de la fenêtre, comme la maquette : options · version (contre JOUER) · JOUER ·
// compte · avatar. JOUER est un nuage ; le statut d'un lancement remplace la 2e ligne de la version.

import { Theme, Tr, Assets, Bulle } from "theme.slint";
import { HomeState, AppState, SettingsState } from "state.slint";
import { Icon, PixelLabel, Thumb, PlayButton, GlassCombo } from "widgets.slint";


/// Tuile : la brique de la mise en page (même rayon, même verre, même bord partout).
export component Tuile inherits Rectangle {
    border-radius: 8px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.glass-border;
}

/// Tuile carrée avec une icône (options, console, dossier…), et sa bulle d'aide au survol.
export component TuileIcone inherits Rectangle {
    in property <string> icon;
    in property <string> tooltip;
    in property <bool> active;
    in property <bool> enabled: true;
    /// la bulle s'ouvre à droite (colonne de gauche) ou au-dessus/dessous (barres)
    in property <bool> bulle-a-droite: false;
    callback clicked;
    border-radius: 8px;
    background: root.active ? Theme.fill : zone.has-hover && root.enabled ? Theme.panel-strong : Theme.panel;
    border-width: 1px;
    border-color: root.active ? Theme.fill : zone.has-hover && root.enabled ? Theme.accent.with-alpha(0.6) : Theme.glass-border;
    opacity: root.enabled ? 1 : 0.5;
    animate background, border-color { duration: Theme.fast; }
    Icon {
        text: root.icon;
        font-size: 18px;
        color: root.active ? Theme.on-fill : Theme.navy;
        transform-scale: zone.pressed ? 0.88 : 1;
        animate transform-scale { duration: 120ms; easing: ease-out; }
    }
    zone := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            Bulle.visible = false;
            root.clicked();
        }
    }
    property <bool> survol: zone.has-hover;
    changed survol => {
        if (self.survol && root.tooltip != "") {
            Bulle.texte = root.tooltip;
            Bulle.x = root.bulle-a-droite ? root.absolute-position.x + root.width + 10px : root.absolute-position.x + root.width / 2;
            Bulle.y = root.bulle-a-droite ? root.absolute-position.y + root.height / 2 : root.absolute-position.y - 34px;
            Bulle.a-droite = root.bulle-a-droite;
            Bulle.visible = true;
        } else if (Bulle.texte == root.tooltip) {
            Bulle.visible = false;
        }
    }
}

/// Choix de la version (jeu rapide), de Misty, d'Horizon ou du profil : toute la tuile ouvre la
/// fenêtre de choix. Pendant un lancement, la deuxième ligne devient le statut.
component TuileChoix inherits Rectangle {
    property <bool> actif: HomeState.selectors-enabled;
    property <bool> occupe: HomeState.status != "" && HomeState.status != Tr.t("Home_Pret");
    border-radius: 8px;
    background: zone.has-hover && root.actif ? Theme.panel-strong : Theme.panel;
    border-width: 1px;
    border-color: zone.has-hover && root.actif ? Theme.accent.with-alpha(0.6) : Theme.glass-border;
    animate background, border-color { duration: Theme.fast; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 18px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 42px;
                height: 42px;
                border-radius: 6px;
                clip: true;
                background: HomeState.horizon-selected ? #F0795A29 : Theme.dark ? #162140 : #1C2335;
                if HomeState.has-card-icon && !HomeState.quick: Image {
                    width: parent.width;
                    height: parent.height;
                    source: HomeState.card-icon;
                    image-fit: cover;
                }
                if !(HomeState.has-card-icon && !HomeState.quick): Image {
                    width: 28px;
                    height: 28px;
                    source: Assets.logo;
                    image-fit: contain;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: HomeState.horizon-selected ? "Horizon " + HomeState.horizon-build
                    : HomeState.misty-selected && HomeState.quick ? "Misty Client " + HomeState.misty-mc
                    : HomeState.quick ? "Minecraft " + HomeState.card-version
                    : (HomeState.profile-index >= 0 && HomeState.profile-index < HomeState.profiles.length ? HomeState.profiles[HomeState.profile-index] : HomeState.card-version);
                font-size: 15px;
                font-weight: 700;
                color: Theme.navy;
                overflow: elide;
            }
            Text {
                text: root.occupe ? HomeState.status + (HomeState.percent-text != "" ? "  ·  " + HomeState.percent-text : "")
                    : HomeState.horizon-selected ? Tr.t("Hz_Moteur")
                    : HomeState.quick ? HomeState.card-loader
                    : HomeState.card-version + " · " + HomeState.card-loader;
                font-size: 12.5px;
                color: root.occupe ? Theme.accent : Theme.text-muted;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Icon {
                text: "\u{E70E}";
                font-size: 11px;
                color: Theme.text-muted;
                opacity: root.actif ? 1 : 0.4;
            }
        }
    }
    zone := TouchArea {
        enabled: root.actif;
        mouse-cursor: pointer;
        clicked => {
            HomeState.picker-tab = HomeState.quick || HomeState.horizon-selected ? 0 : 1;
            HomeState.picker-horizon = HomeState.horizon-selected;
            HomeState.picker-misty = HomeState.misty-selected && HomeState.quick && !HomeState.horizon-selected;
            HomeState.picker-open = true;
            if (HomeState.horizon-selected) {
                HomeState.horizon-refresh();
            }
        }
    }
}

/// JOUER : un nuage sur lequel on clique. Il flotte un peu, monte au survol, s'écrase et
/// s'enfonce dans son ombre quand on appuie ; gris quand on ne peut pas jouer. La progression d'un
/// téléchargement court sous le texte.
component BlocJouer inherits Rectangle {
    property <bool> actif: HomeState.play-enabled;
    property <bool> appui: zone.pressed && root.actif;
    property <bool> survol: zone.has-hover && root.actif;
    property <float> onde: sin((animation-tick() / 3200ms) * 360deg);
    // le nuage ne dépasse jamais sa case (la place de l'ombre en dessous)
    property <length> lever: root.appui ? 3px : root.survol ? -2px : 1.5px * root.onde;
    animate lever { duration: 140ms; easing: ease-out; }

    // ombre : le même nuage, bleuté, un peu plus bas
    Image {
        x: 0;
        y: 6px;
        width: parent.width;
        height: parent.height - 6px;
        source: Assets.play-cloud;
        image-fit: fill;
        colorize: !root.actif ? #6B7C93 : Theme.dark ? #2C4F9E : #7896CA;
    }
    // le nuage (dessiné par Rust : images::nuage_jouer)
    Image {
        x: 0;
        y: root.lever;
        width: parent.width;
        height: parent.height - 6px;
        source: Assets.play-cloud;
        image-fit: fill;
        transform-scale-y: root.appui ? 0.92 : 1;
        transform-scale-x: root.appui ? 1.02 : 1;
        animate transform-scale-x, transform-scale-y { duration: 140ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
        opacity: root.actif ? 1 : 0.75;
    }
    // reflet au survol
    if root.survol: Image {
        x: 0;
        y: root.lever;
        width: parent.width;
        height: parent.height - 6px;
        source: Assets.play-cloud;
        image-fit: fill;
        colorize: #FFFFFF;
        opacity: 0.5;
    }
    Text {
        y: root.lever + (parent.height - 6px) * 0.56 - self.height / 2;
        width: parent.width;
        text: HomeState.play-text;
        font-family: Theme.pixel-font;
        font-size: 24px;
        color: !root.actif ? #6B7C93 : root.survol ? #2F6FD6 : #3C68B8;
        horizontal-alignment: center;
        animate color { duration: Theme.fast; }
    }
    if HomeState.progress > 0 && HomeState.progress < 1: Rectangle {
        x: parent.width * 0.25;
        y: root.lever + parent.height - 18px;
        width: parent.width * 0.5;
        height: 4px;
        border-radius: 2px;
        background: #3C68B833;
        Rectangle {
            x: 0;
            width: parent.width * clamp(HomeState.progress, 0, 1);
            border-radius: 2px;
            background: #3C68B8;
            animate width { duration: 200ms; }
        }
    }
    zone := TouchArea {
        enabled: root.actif;
        mouse-cursor: pointer;
        clicked => { HomeState.play(); }
    }
}

/// Compte : un nuage blanc (en ligne, compte Microsoft) ou gris (hors ligne) devant le pseudo, et
/// la liste des comptes.
component TuileCompte inherits Rectangle {
    border-radius: 8px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.glass-border;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px;
                height: 26px;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: Assets.logo;
                    image-fit: contain;
                    colorize: HomeState.premium ? (Theme.dark ? white : #2F6FD6) : (Theme.dark ? #6F7C99 : #8394AB);
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            Rectangle {
                height: 40px;
                if HomeState.all-accounts.length > 1: GlassCombo {
                    model: HomeState.all-accounts;
                    current-index <=> HomeState.all-index;
                    enabled: !HomeState.ms-busy;
                    selected(i) => { HomeState.all-selected(i); }
                }
                if HomeState.all-accounts.length <= 1 && !HomeState.premium: GlassCombo {
                    model: HomeState.accounts;
                    current-index <=> HomeState.account-index;
                    selected(i) => { HomeState.account-selected(i); }
                }
                if HomeState.all-accounts.length <= 1 && HomeState.premium: Text {
                    text: HomeState.premium-name;
                    font-size: 15px;
                    font-weight: 700;
                    color: Theme.navy;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

export component Dock inherits HorizontalLayout {
    /// largeur des tuiles carrées (la colonne de gauche de la fenêtre)
    in property <length> case: 64px;
    spacing: 12px;

    TuileIcone {
        width: root.case;
        icon: "\u{E713}";
        tooltip: Tr.t("Nav_Options");
        active: SettingsState.open;
        clicked => { AppState.nav-clicked(2); }
    }
    TuileChoix {
        horizontal-stretch: 1;
        min-width: 240px;
    }
    BlocJouer {
        width: 250px;
    }
    // compte (ou « annuler » pendant un téléchargement)
    if !HomeState.can-cancel: TuileCompte {
        horizontal-stretch: 1;
        min-width: 200px;
    }
    if HomeState.can-cancel: TuileIcone {
        horizontal-stretch: 1;
        icon: "\u{E711}";
        tooltip: Tr.t("Commun_Annuler");
        clicked => { HomeState.cancel-install(); }
    }
    // avatar : ouvre l'onglet Skin
    Rectangle {
        width: root.case;
        border-radius: 8px;
        background: Theme.panel;
        border-width: 1px;
        border-color: zone-avatar.has-hover ? Theme.accent.with-alpha(0.6) : Theme.glass-border;
        clip: true;
        animate border-color { duration: Theme.fast; }
        Thumb {
            width: parent.width - 16px;
            height: self.width;
            radius: 6px;
            logo-margin: 8px;
            logo-opacity: 1;
            source: HomeState.avatar;
            has-image: HomeState.has-avatar;
            pixel-art: true;
        }
        zone-avatar := TouchArea {
            mouse-cursor: pointer;
            clicked => { AppState.nav-clicked(7); }
        }
    }
}
