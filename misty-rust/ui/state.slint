// État de chaque page, partagé avec Rust.
// Rust remplit ces propriétés et réagit aux callbacks (voir src/ui/*.rs).

import { LangItem } from "widgets.slint";

// ───────────────────────── Fenêtre ─────────────────────────

/// Petit carré blanc qui flotte en fond.
/// Nappe de brume du paysage (coordonnées en pixels de la scène 1600 × 440).
export struct ScenePuff {
    image: image,
    x: float,
    y: float,
    w: float,
    h: float,
    layer: int,
    period: duration,
    phase: float,
    opacity: float,
}

export global AppState {
    /// 0 accueil, 1 profils, 2 options, 3 notes, 4 packs, 5 détail d'un profil, 6 éditeur de pack, 8 amis
    in-out property <int> page: 0;
    /// Onglet de la barre latérale allumé
    in-out property <int> nav: 0;
    in property <string> version-text;
    /// Fenêtre agrandie (plein écran fenêtré)
    in property <bool> maximized;
    /// Premier affichage prêt (cache l'écran de chargement)
    in property <bool> ready;
    /// Paysage du site (masques fournis par Rust)
    in property <[image]> scene-ridges;
    in property <image> scene-stars;
    in property <image> scene-twinkle;
    in property <image> scene-moon;
    in property <float> moon-x;
    in property <float> moon-y;
    in property <float> moon-size;
    in property <[ScenePuff]> scene-puffs;
    /// Mise à jour en cours : fenêtre d'avancement
    in property <bool> updating;
    in property <string> update-title;
    in property <string> update-status;
    /// 0 à 1 ; négatif tant que la taille est inconnue
    in property <float> update-progress: -1;
    callback toggle-maximize();
    callback nav-clicked(int);
    callback open-data-folder();
    callback minimize();
    callback close();
    callback drag();
}

// ───────────────────────── Boîte de dialogue ─────────────────────────

export global DialogState {
    in-out property <bool> visible;
    in property <string> title;
    in property <string> message;
    in property <string> ok-text;
    /// "" = pas de bouton Annuler
    in property <string> cancel-text;
    in property <bool> danger;
    in property <string> icon;
    /// Mode « choix dans une liste »
    in property <[string]> choices;
    callback ok();
    callback cancel();
    callback choose(int);
}

// ───────────────────────── Accueil ─────────────────────────

/// Version de la fenêtre de choix : 0 release · 1 snapshot · 2 bêta · 3 alpha
export struct VersionItem {
    id: string,
    kind: int,
}

/// Profil de la fenêtre de choix (le premier est le jeu rapide).
export struct ProfileItem {
    name: string,
    detail: string,
    icon: image,
    has-icon: bool,
    /// illustration de la mise à jour de sa version
    art: image,
}

/// Build d'Horizon publié sur GitHub.
export struct HorizonBuild {
    tag: string,
    date: string,
    size: string,
    nightly: bool,
    installed: bool,
}

/// Mise à jour de la fenêtre de choix (1.21 « Tricky Trials »…), avec son illustration.
export struct VersionGroup {
    key: string,
    title: string,
    name: string,
    art: image,
    count: string,
    years: string,
}

export global HomeState {
    /// Fenêtre de choix de la version (0 versions · 1 profils)
    in-out property <bool> picker-open;
    in-out property <int> picker-tab: 0;
    in property <[VersionItem]> picker-versions;
    in property <[VersionGroup]> picker-groups;
    in property <int> picker-group: -1;
    /// versions de la mise à jour choisie (après filtres)
    in property <[VersionItem]> picker-sub;
    /// mod loader filtré : 0 tous · 1 Fabric · 2 Forge · 3 NeoForge · 4 OptiFine · 5 LiteLoader
    in-out property <int> picker-loader: 0;
    callback picker-group-selected(int);

    // ── Horizon (Minecraft 26.3 en Rust) : builds téléchargés depuis GitHub, lancés par Misty ──
    /// Horizon est choisi : la barre du bas et JOUER le lancent
    in-out property <bool> horizon-selected;
    /// Versions Misty (Fabric + Misty Client) : proposées si le mod est dans l'exe
    in property <bool> misty-available;
    /// Versions de Minecraft où Misty Client existe, la plus récente d'abord
    in property <[string]> misty-versions;
    /// Version Misty choisie ("26.3")
    in property <string> misty-mc;
    in property <image> misty-art;
    /// JOUER lance Misty (jeu rapide sur la version du mod, Fabric, Misty Client)
    in-out property <bool> misty-selected;
    /// Fenêtre de choix ouverte sur Misty
    in-out property <bool> picker-misty;
    callback misty-select(string);
    callback misty-play();
    /// L'entrée Horizon est ouverte dans la fenêtre de choix
    in-out property <bool> picker-horizon;
    in property <image> horizon-art;
    /// Builds publiés (nightlies et versions stables), et celui qui sera lancé
    in property <[HorizonBuild]> horizon-builds;
    in property <string> horizon-build;
    /// 0 tous · 1 nightlies · 2 versions stables
    in-out property <int> horizon-filter: 0;
    /// Place de chaque build dans la grille selon le filtre (-1 : masqué), et nombre de builds affichés
    in property <[int]> horizon-ranks;
    in property <int> horizon-visibles;
    callback horizon-filter-changed();
    in property <bool> horizon-loading;
    in property <bool> horizon-busy;
    in property <string> horizon-busy-tag;
    in property <float> horizon-progress;
    in property <string> horizon-message;
    callback horizon-refresh();
    callback horizon-install(string);
    callback horizon-remove(string);
    callback horizon-select(string);
    callback horizon-play();
    callback horizon-link(int);
    in-out property <bool> picker-release: true;
    in-out property <bool> picker-snapshot: false;
    in-out property <bool> picker-beta: false;
    in-out property <bool> picker-alpha: false;
    in-out property <string> picker-search;
    callback picker-changed();
    callback version-picked(string);
    in property <[ProfileItem]> profile-items;
    /// Dernière news (dernière release GitHub, ou notes de version intégrées hors ligne)
    in property <bool> news-visible;
    in property <string> news-title;
    in property <string> news-text;
    in property <string> news-date;
    callback news-open();
    in property <[string]> accounts;
    in-out property <int> account-index;
    in property <bool> premium;
    in property <string> premium-name;
    in property <bool> ms-busy;
    in property <[string]> ms-names;
    in-out property <int> ms-index;
    in property <image> avatar;
    in property <bool> has-avatar;

    in property <[string]> profiles;
    in-out property <int> profile-index;
    in property <bool> quick: true;

    in property <[string]> versions;
    in-out property <int> version-index: -1;
    in property <[string]> modes;
    in-out property <int> mode-index: -1;
    in property <bool> modes-enabled;
    in property <bool> reload-enabled: true;
    in property <bool> selectors-enabled: true;

    in property <string> card-label;
    in property <string> card-version: "—";
    in property <string> card-loader: "VANILLA";
    in property <image> card-icon;
    in property <bool> has-card-icon;
    in property <string> summary;

    in property <string> status;
    in property <string> percent-text;
    in property <float> progress;
    in property <bool> play-enabled;
    /// Téléchargement d'une version en cours : il peut être annulé
    in property <bool> can-cancel;
    callback cancel-install();
    in property <string> play-text;

    callback account-selected(int);
    callback profile-selected(int);
    callback version-selected(int);
    callback mode-selected(int);
    callback ms-clicked();
    callback ms-selected(int);
    /// Tous les comptes : Microsoft d'abord, puis hors ligne
    in property <[string]> all-accounts;
    in-out property <int> all-index: -1;
    callback all-selected(int);
    callback reload();
    callback manage();
    callback play();
}

// ───────────────────────── Profils ─────────────────────────

export struct ProfileCard {
    id: string,
    name: string,
    summary: string,
    last: string,
    icon: image,
    has-icon: bool,
}

export global ProfilesState {
    in property <[ProfileCard]> list;
    /// 0 liste, 1 modpacks
    in-out property <int> view;

    in-out property <bool> creating;
    in-out property <string> create-name;
    in property <[string]> create-versions;
    in-out property <int> create-version-index: -1;
    in property <[string]> create-loaders;
    in-out property <int> create-loader-index: -1;
    in property <bool> create-loader-enabled;
    in property <string> create-info;
    in property <bool> create-enabled;

    in property <bool> waiting;
    in property <string> wait-title;
    in property <string> wait-text;

    callback open(string);
    callback play(string);
    callback delete(string);
    callback new-profile();
    callback modpacks();
    callback import-modpack();
    callback back();
    callback create-version-selected(int);
    callback create();
    callback cancel-create();
}

// ───────────────────────── Détail d'un profil ─────────────────────────

export struct BadgeItem {
    text: string,
    color: color,
}

export struct ContentItem {
    title: string,
    details: string,
    icon: image,
    has-icon: bool,
    active: bool,
    /// Où le mod s'installe (d'après Modrinth) : 0 inconnu, 1 client, 2 serveur, 3 les deux
    side: int,
    /// Version disponible (vide = à jour ou inconnu)
    update: string,
    /// Mise à jour en cours
    updating: bool,
}

export global InstanceState {
    in property <string> name;
    in property <image> icon;
    in property <bool> has-icon;
    in property <[BadgeItem]> badges;
    in property <string> status;
    /// 0 contenu installé, 1 découvrir
    in-out property <int> tab;
    in property <string> content-tab-text;
    in property <[string]> filters;
    in-out property <int> filter-index;
    in-out property <string> filter-text;
    in property <[ContentItem]> items;
    in-out property <bool> renaming;
    in-out property <string> rename-text;

    /// Profil créé depuis un modpack connu (Modrinth / CurseForge) : il peut être mis à jour
    in property <bool> is-modpack;
    // Misty Client dans ce profil : la case n'apparaît que pour un profil Fabric d'une version où le mod existe
    in property <bool> misty-available;
    in-out property <bool> misty-on;
    callback misty-toggled(bool);
    callback export();
    callback update-pack();
    callback back();
    callback play();
    callback folder();
    callback change-icon();
    callback rename();
    callback rename-ok();
    callback delete();
    callback tab-changed(int);
    callback filter-changed(int);
    callback filter-text-changed(string);
    callback toggle(int);
    callback remove(int);
    /// Nombre de mises à jour disponibles dans le profil (bouton « Tout mettre à jour »)
    in property <int> updates-count;
    in property <bool> updating-all;
    callback update-item(int);
    callback update-all();
}

// ───────────────────────── Explorateur Modrinth / CurseForge ─────────────────────────

export struct TabItem {
    text: string,
    enabled: bool,
}

export struct ResultItem {
    title: string,
    author: string,
    description: string,
    downloads: string,
    categories: string,
    icon: image,
    has-icon: bool,
    installed: bool,
    busy: bool,
    button-text: string,
    button-icon: string,
}

export global BrowserState {
    in property <[TabItem]> types;
    in-out property <int> type-index;
    /// 0 Modrinth, 1 CurseForge
    in-out property <int> source;
    in property <[string]> sorts;
    in-out property <int> sort-index;
    in-out property <string> query;
    in property <string> info;
    in property <[ResultItem]> results;
    in property <string> bottom-text;
    in property <bool> no-key;
    /// Incrémenté par Rust pour remonter en haut de la liste
    in property <int> scroll-reset;

    callback type-changed(int);
    callback source-changed(int);
    callback sort-changed(int);
    callback query-changed(string);
    callback install(int);
    callback near-end();
}

// ───────────────────────── Options ─────────────────────────

export struct PseudoRow {
    items: [string],
}

export struct StorageRow {
    cle: string,
    nom: string,
    info: string,
    size-text: string,
    fraction: float,
    niveau: int,
    expandable: bool,
    expanded: bool,
    locked: bool,
    reste: bool,
}

export struct MsCompte {
    pseudo: string,
    uuid: string,
    active: bool,
}

export global SettingsState {
    /// Fenêtre des options ouverte
    in property <bool> open;
    /// Catégorie affichée : 0 apparence · 1 langue · 2 Microsoft · 3 hors-ligne · 4 Java et mémoire
    /// · 5 versions · 6 comportement · 7 ressources · 8 dépannage
    in-out property <int> section: 0;
    /// Capture floutée de la fenêtre, posée derrière la fenêtre des options
    in property <image> backdrop;
    in property <bool> has-backdrop;
    /// Capture du fond en cours : la fenêtre des options se cache le temps d'une image
    in property <bool> capturing;
    /// « Windows 10.0.19045 », affiché sous la version de Misty
    in property <string> system-text;
    in-out property <float> downloads: 16;
    in property <string> cache-size;
    in property <string> logs-size;
    in property <[MsCompte]> ms-accounts;
    in property <[PseudoRow]> pseudo-rows;
    in-out property <string> new-pseudo;
    in property <string> ms-state;
    in property <bool> ms-connected;
    in property <bool> ms-busy;
    in-out property <bool> shortcut-enabled;
    in property <string> shortcut-path;
    in property <[LangItem]> langs;
    in-out property <int> lang-index;
    in property <string> ram-text;
    in property <string> ram-total-text;
    in property <float> ram-max: 8192;
    in-out property <float> ram-value: 4096;
    in property <string> data-dir;
    in property <string> size-text;
    in property <bool> storage-open;
    in property <bool> storage-busy;
    in property <[StorageRow]> storage-rows;
    in property <string> storage-total;
    in-out property <bool> rich;
    in property <string> about-text;
    in property <bool> checking-update;

    callback add-pseudo();
    callback remove-pseudo(string);
    callback connect();
    callback ms-switch(string);
    callback ms-forget(string);
    callback disconnect();
    callback disconnect-all();
    callback shortcut-toggled(bool);
    callback choose-shortcut();
    callback recreate-shortcut();
    callback lang-selected(int);
    callback ram-changed(float);
    callback open-folder();
    callback delete-all();
    callback storage-show();
    callback storage-close();
    callback storage-toggle(string);
    callback storage-delete(string);
    callback rich-toggled(bool);
    in-out property <bool> console-auto: true;
    callback console-auto-toggled(bool);
    /// Misty Client (le mod en jeu) : dans cet exe ou non, sa version de Minecraft, et le réglage
    in property <bool> misty-client-available;
    in property <string> misty-client-mc;
    in-out property <bool> misty-client: true;
    callback misty-client-toggled(bool);
    in-out property <bool> telemetry;
    callback telemetry-toggled(bool);
    in-out property <bool> prerelease;
    callback prerelease-toggled(bool);
    callback open-launcher-log();
    callback github();
    callback check-update();
    callback close();
    callback theme-selected(int);
    callback blur-toggled(bool);
    callback seasonal-toggled(bool);
    in-out property <float> bg-blur: 0;
    callback bg-blur-changed(float);
    in-out property <bool> seasonal: true;
    callback downloads-changed(float);
    callback clear-cache();
    callback open-logs();
    callback export-debug();
}

// ───────────────────────── Notes de version ─────────────────────────

export struct ChangelogSection {
    title: string,
    lines: [string],
    /// Pour chaque ligne : intertitre (« ### … ») ou non
    heads: [bool],
    recent: bool,
}

export global ChangelogState {
    in property <[ChangelogSection]> sections;
}

// ───────────────────────── Packs de textures ─────────────────────────

export struct PackCard {
    name: string,
    description: string,
    version: string,
    count: string,
    icon: image,
    has-icon: bool,
}

export global PacksState {
    in property <[PackCard]> list;
    in-out property <bool> creating;
    in-out property <string> create-name;
    in-out property <string> create-desc;
    in property <[string]> versions;
    in-out property <int> version-index: -1;
    in property <string> create-info;
    in property <bool> create-enabled: true;

    callback new-pack();
    callback validate();
    callback cancel-create();
    callback edit(int);
    callback folder(int);
    callback export(int);
    callback delete(int);
}

// ───────────────────────── Éditeur de pack ─────────────────────────

export struct CategoryItem {
    name: string,
    count: string,
}

export struct TextureItem {
    path: string,
    thumb: image,
    has-thumb: bool,
    modified: bool,
}

export global EditorState {
    in property <string> pack-name;
    in property <image> pack-icon;
    in property <bool> has-pack-icon;
    in property <string> info;
    /// 0 toutes les textures, 1 mes textures
    in-out property <int> mode;
    in property <string> perso-text;
    in property <[CategoryItem]> categories;
    in-out property <int> category-index;
    in-out property <string> search;
    in property <[TextureItem]> textures;
    in property <int> selected: -1;
    in property <string> message;
    in property <int> scroll-reset;

    in property <bool> editor-visible;
    in property <string> texture-title;
    in property <string> size-text;
    in property <image> pixels;
    in property <image> checker;
    in property <image> grid;
    in-out property <bool> show-grid: true;
    in-out property <float> zoom: 10;
    in property <length> canvas-width;
    in property <length> canvas-height;
    /// 0 crayon, 1 gomme, 2 pot de peinture, 3 pipette
    in-out property <int> tool;
    in property <color> color;
    in-out property <string> hex-text;
    in-out property <float> red;
    in-out property <float> green;
    in-out property <float> blue;
    in property <[color]> recents;
    in property <[color]> palette;
    in property <bool> reset-enabled;
    in property <bool> export-enabled: true;

    callback back();
    callback change-icon();
    callback search-changed(string);
    callback folder();
    callback export();
    callback mode-changed(int);
    callback category-changed(int);
    callback select(int);
    callback zoom-changed(float);
    callback grid-toggled(bool);
    callback tool-changed(int);
    callback pointer-down(length, length, bool);
    callback pointer-move(length, length);
    callback pointer-up();
    callback rgb-changed();
    callback hex-changed(string);
    callback pick-color(color);
    callback undo();
    callback redo();
    callback save();
    callback external();
    callback reset();
    /// Raccourcis clavier ; renvoie true si la touche est utilisée
    callback key(string, bool) -> bool;
}
