// Amis : ajout par pseudo, les amis en ligne en grandes cartes (ce qu'ils jouent, rejoindre), les
// hors ligne en une ligne. Pour l'instant seulement l'interface (rien n'est envoyé) : les cartes sont
// des « fantômes » sous une annonce « bientôt ».

import { Theme, Tr } from "theme.slint";
import { Icon, PixelLabel, BodyText, OutlinedText, GlassCard, GlassInput, MButton, Puces, Etiquette } from "widgets.slint";

/// Carte d'un ami en ligne, « fantôme » : la forme qu'elle aura (avatar, statut, ce qu'il joue,
/// rejoindre). Les vraies cartes arriveront avec le service d'amis.
component CarteFantome inherits Rectangle {
    in property <length> largeur-nom;
    in property <color> statut;
    in property <brush> scene;
    in property <bool> en-jeu: true;
    border-radius: 12px;
    background: Theme.panel-strong;
    border-width: 1px;
    border-color: Theme.glass-border;
    VerticalLayout {
        padding: 14px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 38px;
                height: 38px;
                border-radius: 7px;
                background: Theme.fill;
                Rectangle {
                    x: parent.width - 10px;
                    y: parent.height - 10px;
                    width: 12px;
                    height: 12px;
                    border-radius: 3px;
                    background: root.statut;
                    border-width: 2px;
                    border-color: Theme.panel-strong;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 6px;
                Rectangle {
                    width: root.largeur-nom;
                    height: 10px;
                    border-radius: 3px;
                    background: Theme.fill;
                }
                Rectangle {
                    width: root.largeur-nom * 0.55;
                    height: 8px;
                    border-radius: 3px;
                    background: root.statut.with-alpha(0.6);
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        // ce qu'il joue
        Rectangle {
            vertical-stretch: 1;
            min-height: 70px;
            border-radius: 8px;
            background: root.scene;
        }
        HorizontalLayout {
            Rectangle {
                horizontal-stretch: 3;
                height: 8px;
                border-radius: 3px;
                background: Theme.glass-border;
            }
            Rectangle { horizontal-stretch: 2; }
        }
        Rectangle {
            height: 34px;
            border-radius: 6px;
            background: root.en-jeu ? Theme.fill : Theme.glass-strong;
            Text {
                text: Tr.t("Amis_Rejoindre");
                font-size: 13px;
                font-weight: 700;
                color: root.en-jeu ? Theme.on-fill : Theme.text-muted;
            }
        }
    }
}

export component FriendsPage inherits Rectangle {
    property <int> onglet: 0;
    property <string> pseudo;

    VerticalLayout {
        // la page est dans la grille de la fenêtre : pas de marge autour
        padding: 0px;
        spacing: 16px;

        HorizontalLayout {
            spacing: 14px;
            HorizontalLayout {
                horizontal-stretch: 1;
                alignment: start;
                spacing: 14px;
                VerticalLayout {
                    alignment: center;
                    Etiquette { text: Tr.t("Amis_Bientot"); }
                }
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 8px;
                    GlassInput {
                        width: 240px;
                        placeholder: Tr.t("Amis_Pseudo");
                        text <=> root.pseudo;
                    }
                    MButton {
                        kind: 1;
                        icon: "\u{E8FA}";
                        text: Tr.t("Amis_Ajouter");
                        // l'envoi des demandes arrive avec le service d'amis
                        enabled: false;
                    }
                }
            }
        }

        HorizontalLayout {
            padding-left: 6px;
            Puces {
                model: [Tr.t("Amis_EnLigne").to-uppercase(), Tr.t("Amis_Tous").to-uppercase(), Tr.t("Amis_Demandes").to-uppercase()];
                current: root.onglet;
                selected(i) => { root.onglet = i; }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            // la forme de la page quand il y aura des amis…
            VerticalLayout {
                spacing: 14px;
                opacity: 0.4;
                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 14px;
                    CarteFantome {
                        horizontal-stretch: 1;
                        largeur-nom: 90px;
                        statut: #1DE062;
                        scene: @linear-gradient(180deg, #0F1B33 0%, #1A2748 65%, #24345A 100%);
                    }
                    CarteFantome {
                        horizontal-stretch: 1;
                        largeur-nom: 70px;
                        statut: #1DE062;
                        scene: @linear-gradient(180deg, #F7C98B 0%, #D9874E 70%, #8A4F2A 100%);
                    }
                    CarteFantome {
                        horizontal-stretch: 1;
                        largeur-nom: 110px;
                        statut: #2F8CFF;
                        en-jeu: false;
                        scene: Theme.glass;
                    }
                }
                Rectangle {
                    height: 56px;
                    border-radius: 10px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.glass-border;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 10px;
                        Text {
                            text: Tr.t("Amis_HorsLigne");
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                        for i in 4: VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 30px;
                                height: 30px;
                                border-radius: 6px;
                                background: Theme.fill;
                                opacity: 0.5;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: Tr.t("Amis_Demandes") + "  ›";
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            // … et l'annonce par-dessus
            Rectangle {
                width: min(parent.width - 40px, 460px);
                height: annonce.preferred-height;
                border-radius: 14px;
                background: Theme.panel-strong;
                border-width: 1px;
                border-color: Theme.glass-border;
                drop-shadow-blur: 30px;
                drop-shadow-color: Theme.shadow;
                annonce := VerticalLayout {
                    padding: 26px;
                    spacing: 10px;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 54px;
                            height: 54px;
                            border-radius: 10px;
                            background: Theme.accent-soft;
                            Icon {
                                text: "\u{E716}";
                                font-size: 24px;
                                color: Theme.accent;
                            }
                        }
                    }
                    PixelLabel {
                        text: Tr.t("Amis_Bientot");
                        font-size: 11px;
                        color: Theme.accent;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: Tr.t("Amis_Annonce_Titre");
                        font-size: 19px;
                        font-weight: 800;
                        color: Theme.navy;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    BodyText {
                        text: Tr.t("Amis_Annonce_Texte");
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
