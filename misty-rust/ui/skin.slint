// Onglet « Skin » de l'accueil : aperçu du personnage, changement de skin, choix de la cape.

import { Theme, Tr, Assets } from "theme.slint";
import { HomeState } from "state.slint";
import { Icon, PixelLabel, BodyText, GlassCard, MButton, TabPill, Spinner } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

export struct CapeItem {
    id: string,
    name: string,
    image: image,
    has-image: bool,
    active: bool,
    col: int,
    row: int,
}

export global SkinState {
    /// Onglet de l'accueil : 0 jouer, 1 skin et capes
    in-out property <int> tab: 0;
    in property <[image]> frames;
    /// Images de la marche : pose x 12 angles
    in property <[image]> walk-frames;
    in-out property <bool> walk: false;
    in-out property <bool> elytra: false;
    callback elytra-toggled();
    callback walk-toggled();
    in property <bool> has-figure;
    in property <[CapeItem]> capes;
    in property <int> cape-rows: 1;
    in property <bool> loading;
    in property <bool> busy;
    in-out property <bool> slim;
    in property <string> file-name;
    in property <bool> has-file;
    in property <string> info;
    callback open();
    callback pick-file();
    callback slim-changed();
    callback apply();
    callback select-cape(string);
}

/// Carte sombre avec le personnage qui flotte doucement.
component FigureCard inherits Rectangle {
    width: 230px;
    height: 400px;
    property <float> onde: sin((animation-tick() / 2600ms) * 180deg);
    property <angle> rot: 0deg;
    property <bool> glisse: false;
    property <image> vide;
    property <length> dernier-x: 0px;
    animate rot { duration: root.glisse ? 0ms : 300ms; easing: ease-out; }

    Rectangle {
        border-radius: 30px;
        background: Theme.stage;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow;
        drop-shadow-offset-y: 8px;

        Rectangle {
            x: 5px;
            y: 5px;
            width: parent.width - 10px;
            height: parent.height - 10px;
            border-radius: 26px;
            clip: true;
            background: @linear-gradient(165deg, #8FA6C4 0%, #3A4760 35%, #161C2B 100%);

            Rectangle {
                x: (parent.width - 240px) / 2;
                y: -50px;
                width: 240px;
                height: 240px;
                border-radius: 120px;
                opacity: 0.35;
                background: @radial-gradient(circle, #C4DFF8 0%, #C4DFF800 100%);
            }
            // ombre au sol
            Rectangle {
                property <float> s: 0.95 + 0.15 * root.onde;
                x: (parent.width - self.width) / 2;
                y: parent.height - 38px;
                width: 110px * self.s;
                height: 14px * self.s;
                border-radius: self.height / 2;
                background: #00000066;
            }
            // Personnage : on le fait tourner en glissant la souris (face / dos avec la cape)
            if SkinState.has-figure: Image {
                x: (parent.width - 224px) / 2;
                y: 26px + 6px * root.onde;
                width: 224px;
                height: 320px;
                source: SkinState.walk && SkinState.walk-frames.length >= 144 ? SkinState.walk-frames[Math.mod(Math.floor(animation-tick() / 90ms), 12) * 12 + Math.mod(Math.mod(Math.round(root.rot / 30deg), 12) + 12, 12)] : SkinState.frames.length > 0 ? SkinState.frames[Math.mod(Math.mod(Math.round(root.rot / 10deg), 36) + 36, 36)] : root.vide;
                image-fit: contain;
                image-rendering: pixelated;
            }
            TouchArea {
                enabled: SkinState.has-figure;
                mouse-cursor: grab;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.glisse = true;
                        root.dernier-x = self.mouse-x;
                    } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                        root.glisse = false;
                        // se range sur la face ou sur le dos
                        root.rot = round(root.rot / 180deg) * 180deg;
                    }
                }
                moved => {
                    if (root.glisse) {
                        root.rot -= (self.mouse-x - root.dernier-x) / 1px * 1.4deg;
                        root.dernier-x = self.mouse-x;
                    }
                }
            }
            // Vues rapides : face, côté, dos
            if SkinState.has-figure: HorizontalLayout {
                x: 0px;
                y: parent.height - 38px;
                width: parent.width;
                height: 28px;
                alignment: center;
                spacing: 6px;
                for nom[i] in [Tr.t("Skin_Vue_Face"), Tr.t("Skin_Vue_Cote"), Tr.t("Skin_Vue_Dos")]: Rectangle {
                    property <angle> cible: i == 1 ? 270deg : i * 90deg;
                    property <int> k: Math.mod(Math.mod(Math.round(root.rot / 90deg), 4) + 4, 4);
                    property <bool> actif: i == 0 ? self.k == 0 : i == 1 ? (self.k == 1 || self.k == 3) : self.k == 2;
                    width: etiquette.preferred-width + 20px;
                    border-radius: 14px;
                    background: vue-touch.has-hover ? #FFFFFF30 : self.actif ? #FFFFFF22 : transparent;
                    etiquette := Text {
                        text: nom;
                        font-family: Theme.ui-font;
                        font-size: 13px;
                        font-weight: 600;
                        color: parent.actif || vue-touch.has-hover ? white : #FFFFFFAA;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    vue-touch := TouchArea {
                        clicked => { root.rot = root.rot + (Math.mod(Math.mod((parent.cible - root.rot) / 1deg + 180, 360) + 360, 360) - 180) * 1deg; }
                    }
                }
            }
            // Marche et élytres, en haut à droite
            if SkinState.has-figure: VerticalLayout {
                x: parent.width - 78px;
                y: 14px;
                width: 66px;
                spacing: 6px;
                for opt[i] in [Tr.t("Skin_Vue_Marche"), Tr.t("Skin_Elytres")]: Rectangle {
                    property <bool> actif: i == 0 ? SkinState.walk : SkinState.elytra;
                    height: 26px;
                    border-radius: 13px;
                    border-width: 1px;
                    border-color: self.actif ? #FFFFFF99 : #FFFFFF33;
                    background: opt-touch.has-hover ? #FFFFFF30 : self.actif ? #FFFFFF2A : #FFFFFF10;
                    Text {
                        text: opt;
                        font-family: Theme.ui-font;
                        font-size: 12px;
                        font-weight: 600;
                        color: parent.actif || opt-touch.has-hover ? white : #FFFFFFB0;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    opt-touch := TouchArea {
                        clicked => {
                            if (i == 0) {
                                SkinState.walk = !SkinState.walk;
                                SkinState.walk-toggled();
                            } else {
                                SkinState.elytra = !SkinState.elytra;
                                SkinState.elytra-toggled();
                            }
                        }
                    }
                }
            }            if !SkinState.has-figure && SkinState.loading: Spinner { }
            if !SkinState.has-figure && !SkinState.loading: Image {
                x: (parent.width - 110px) / 2;
                y: 60px + 6px * root.onde;
                width: 110px;
                height: 110px;
                source: HomeState.has-avatar ? HomeState.avatar : Assets.logo;
                image-fit: contain;
                image-rendering: pixelated;
            }
        }
    }
}

component CapeTile inherits Rectangle {
    in property <string> name;
    in property <image> image;
    in property <bool> has-image;
    in property <bool> active;
    callback clicked;

    width: 88px;
    height: 124px;
    border-radius: 14px;
    background: root.active ? Theme.panel-strong : touch.has-hover ? Theme.glass-hover : Theme.glass;
    border-width: root.active ? 2.5px : 1.5px;
    border-color: root.active ? Theme.green : Theme.glass-border;
    animate background { duration: 120ms; }

    // fond sombre : les capes claires et sombres restent lisibles
    if root.has-image: Rectangle {
        x: (parent.width - 60px) / 2;
        y: 8px;
        width: 60px;
        height: 92px;
        border-radius: 8px;
        background: #1C2335AA;
        Image {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            source: root.image;
            image-fit: contain;
            image-rendering: pixelated;
        }
    }
    if !root.has-image: Icon {
        y: 8px;
        width: parent.width;
        height: 92px;
        text: "\u{E711}";
        font-size: 24px;
        color: Theme.label;
    }
    PixelLabel {
        x: 4px;
        y: 102px;
        width: parent.width - 8px;
        height: 18px;
        text: root.name;
        font-size: 9px;
        color: Theme.navy;
        horizontal-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        enabled: !SkinState.busy;
        clicked => { root.clicked(); }
    }
}

export component SkinPanel inherits Rectangle {
    HorizontalLayout {
        alignment: center;
        spacing: 26px;
        padding-left: 14px;

        FigureCard { }

        GlassCard {
            max-width: 560px;
            min-width: 440px;
            horizontal-stretch: 1;
            height: 400px;
            border-radius: 26px;
            background: Theme.panel;

            // Pas de compte Microsoft : rien à modifier
            if !HomeState.premium: VerticalLayout {
                alignment: center;
                spacing: 16px;
                padding: 30px;
                Icon {
                    text: "\u{E77B}";
                    font-size: 34px;
                    color: Theme.label;
                }
                BodyText {
                    text: Tr.t("Skin_Connexion");
                    font-size: 15px;
                    color: Theme.navy2;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    alignment: center;
                    MButton {
                        text: Tr.t("Skin_Connecter");
                        kind: 1;
                        enabled: !HomeState.ms-busy;
                        clicked => { HomeState.ms-clicked(); }
                    }
                }
            }

            if HomeState.premium: VerticalLayout {
                padding: 22px;
                spacing: 12px;

                HorizontalLayout {
                    spacing: 10px;
                    PixelLabel {
                        text: Tr.t("Skin_Titre");
                        font-size: 15px;
                        color: Theme.navy;
                    }
                    PixelLabel {
                        text: HomeState.premium-name;
                        font-size: 11px;
                        color: Theme.label;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if SkinState.busy || SkinState.loading: Rectangle {
                        width: 22px;
                        Icon {
                            text: "\u{E895}";
                            font-size: 16px;
                            color: Theme.green-dark;
                            transform-rotation: (animation-tick() / 1200ms) * 360deg;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    TabPill {
                        text: Tr.t("Skin_Classique");
                        checked: !SkinState.slim;
                        clicked => {
                            SkinState.slim = false;
                            SkinState.slim-changed();
                        }
                    }
                    TabPill {
                        text: Tr.t("Skin_Fin");
                        checked: SkinState.slim;
                        clicked => {
                            SkinState.slim = true;
                            SkinState.slim-changed();
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    MButton {
                        text: Tr.t("Skin_Fichier");
                        icon: "\u{E8E5}";
                        enabled: !SkinState.busy;
                        clicked => { SkinState.pick-file(); }
                    }
                    MButton {
                        text: Tr.t("Skin_Appliquer");
                        icon: "\u{E73E}";
                        kind: 3;
                        enabled: SkinState.has-file && !SkinState.busy;
                        clicked => { SkinState.apply(); }
                    }
                }
                // une seule ligne : message de retour, sinon le fichier choisi
                BodyText {
                    text: SkinState.info != "" ? SkinState.info : SkinState.has-file ? SkinState.file-name : Tr.t("Skin_AucunFichier");
                    font-size: 12px;
                    color: SkinState.info != "" ? Theme.navy2 : Theme.text-muted;
                    overflow: elide;
                    wrap: no-wrap;
                }

                PixelLabel {
                    text: Tr.t("Skin_Capes");
                    font-size: 13px;
                    color: Theme.navy;
                }
                ScrollView {
                    vertical-stretch: 1;
                    content-height: SkinState.cape-rows * 132px;
                    for c in SkinState.capes: CapeTile {
                        x: c.col * 96px;
                        y: c.row * 132px;
                        name: c.name;
                        image: c.image;
                        has-image: c.has-image;
                        active: c.active;
                        clicked => { SkinState.select-cape(c.id); }
                    }
                }
            }
        }
    }
}
