// Barre du bas (sur toutes les pages sauf le détail d'un profil et l'éditeur), en tuiles alignées
// sur la grille de la fenêtre, comme la maquette : options · version (contre JOUER) · JOUER ·
// compte · avatar. Le statut d'un lancement s'affiche à gauche de la version, la progression sous JOUER.

import { Theme, Tr, Assets, Bulle } from "theme.slint";
import { HomeState, AppState, SettingsState } from "state.slint";
import { Icon, PixelLabel, Thumb, PlayButton, GlassCombo } from "widgets.slint";


/// Tuile : la brique de la mise en page (même rayon, même verre, même bord partout).
export component Tuile inherits Rectangle {
    border-radius: 8px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.glass-border;
}

/// Tuile carrée avec une icône (options, console, dossier…), et sa bulle d'aide au survol.
export component TuileIcone inherits Rectangle {
    in property <string> icon;
    in property <string> tooltip;
    in property <bool> active;
    in property <bool> enabled: true;
    /// la bulle s'ouvre à droite (colonne de gauche) ou au-dessus/dessous (barres)
    in property <bool> bulle-a-droite: false;
    callback clicked;
    border-radius: 8px;
    background: root.active ? Theme.fill : zone.has-hover && root.enabled ? Theme.panel-strong : Theme.panel;
    border-width: 1px;
    border-color: root.active ? Theme.fill : zone.has-hover && root.enabled ? Theme.accent.with-alpha(0.6) : Theme.glass-border;
    opacity: root.enabled ? 1 : 0.5;
    animate background, border-color { duration: Theme.fast; }
    Icon {
        text: root.icon;
        font-size: 18px;
        color: root.active ? Theme.on-fill : Theme.navy;
        transform-scale: zone.pressed ? 0.88 : 1;
        animate transform-scale { duration: 120ms; easing: ease-out; }
    }
    zone := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            Bulle.visible = false;
            root.clicked();
        }
    }
    property <bool> survol: zone.has-hover;
    changed survol => {
        if (self.survol && root.tooltip != "") {
            Bulle.texte = root.tooltip;
            Bulle.x = root.bulle-a-droite ? root.absolute-position.x + root.width + 10px : root.absolute-position.x + root.width / 2;
            Bulle.y = root.bulle-a-droite ? root.absolute-position.y + root.height / 2 : root.absolute-position.y - 34px;
            Bulle.a-droite = root.bulle-a-droite;
            Bulle.visible = true;
        } else if (Bulle.texte == root.tooltip) {
            Bulle.visible = false;
        }
    }
}

/// Choix de la version (jeu rapide), de Misty, d'Horizon ou du profil : ouvre la fenêtre de choix.
/// Comme sur la maquette : le choix est collé à droite de la tuile, contre JOUER ; à gauche, le
/// statut pendant un lancement.
component TuileChoix inherits Rectangle {
    property <bool> actif: HomeState.selectors-enabled;
    property <bool> occupe: HomeState.status != "" && HomeState.status != Tr.t("Home_Pret");
    border-radius: 8px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.glass-border;
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 8px;
        spacing: 10px;
        // statut d'un lancement (vide le reste du temps)
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            if root.occupe: Text {
                text: HomeState.status;
                font-size: 12.5px;
                color: Theme.text-muted;
                overflow: elide;
            }
            if root.occupe && HomeState.percent-text != "": Text {
                text: HomeState.percent-text;
                font-size: 12px;
                font-weight: 700;
                color: Theme.accent;
            }
        }
        // le choix
        choix := Rectangle {
            min-width: 150px;
            max-width: 300px;
            horizontal-stretch: 0;
            preferred-width: 270px;
            border-radius: 6px;
            y: 8px;
            height: parent.height - 16px;
            background: zone.has-hover && root.actif ? Theme.glass-hover : transparent;
            animate background { duration: Theme.fast; }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 12px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 6px;
                        clip: true;
                        background: HomeState.horizon-selected ? #F0795A29 : Theme.dark ? #162140 : #1C2335;
                        if HomeState.has-card-icon && !HomeState.quick: Image {
                            width: parent.width;
                            height: parent.height;
                            source: HomeState.card-icon;
                            image-fit: cover;
                        }
                        if !(HomeState.has-card-icon && !HomeState.quick): Image {
                            width: 26px;
                            height: 26px;
                            source: Assets.logo;
                            image-fit: contain;
                        }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    PixelLabel {
                        text: HomeState.horizon-selected ? Tr.t("Hz_Moteur") : HomeState.misty-selected && HomeState.quick ? "MISTY CLIENT" : HomeState.quick ? Tr.t("Commun_Version") : Tr.t("Home_Profil");
                        font-size: 11px;
                        color: Theme.navy;
                        overflow: elide;
                    }
                    Text {
                        text: HomeState.horizon-selected ? "Horizon " + HomeState.horizon-build
                            : HomeState.misty-selected && HomeState.quick ? "Misty " + HomeState.misty-mc
                            : HomeState.quick ? HomeState.card-version + " · " + HomeState.card-loader
                            : (HomeState.profile-index >= 0 && HomeState.profile-index < HomeState.profiles.length ? HomeState.profiles[HomeState.profile-index] : HomeState.card-version);
                        font-size: 12.5px;
                        color: Theme.text-muted;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Icon {
                        text: "\u{E70E}";
                        font-size: 11px;
                        color: Theme.text-muted;
                        opacity: root.actif ? 1 : 0.4;
                    }
                }
            }
            zone := TouchArea {
                enabled: root.actif;
                mouse-cursor: pointer;
                clicked => {
                    HomeState.picker-tab = HomeState.quick || HomeState.horizon-selected ? 0 : 1;
                    HomeState.picker-horizon = HomeState.horizon-selected;
                    HomeState.picker-misty = HomeState.misty-selected && HomeState.quick && !HomeState.horizon-selected;
                    HomeState.picker-open = true;
                    if (HomeState.horizon-selected) {
                        HomeState.horizon-refresh();
                    }
                }
            }
        }
    }
}

/// JOUER : un bloc plein et plat, avec un liseré clair et un relief dessous (comme la maquette),
/// aux couleurs de Misty. La progression d'un téléchargement court en bas du bloc.
component BlocJouer inherits Rectangle {
    property <bool> actif: HomeState.play-enabled;
    property <bool> appui: zone.pressed && root.actif;
    // relief
    Rectangle {
        y: 5px;
        height: parent.height - 5px;
        border-radius: 8px;
        background: root.actif ? #2C4F9E : #3E526A;
    }
    face := Rectangle {
        y: root.appui ? 4px : 0px;
        height: parent.height - 5px;
        border-radius: 8px;
        background: !root.actif ? @linear-gradient(180deg, #8B9BB0 0%, #6B7C93 100%)
            : zone.has-hover ? @linear-gradient(180deg, #8AAEFF 0%, #5B88EE 100%)
            : @linear-gradient(180deg, #7FA6FF 0%, #4F7FE0 100%);
        border-width: 2px;
        border-color: #FFFFFF59;
        animate y { duration: 80ms; }
        Text {
            text: HomeState.play-text;
            font-family: Theme.pixel-font;
            font-size: 28px;
            color: white;
            stroke: root.actif ? #2C4F9E : #3E526A;
            stroke-width: 2px;
            stroke-style: outside;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if HomeState.progress > 0 && HomeState.progress < 1: Rectangle {
            x: 10px;
            y: parent.height - 9px;
            width: parent.width - 20px;
            height: 3px;
            border-radius: 1.5px;
            background: #FFFFFF40;
            Rectangle {
                x: 0;
                width: parent.width * clamp(HomeState.progress, 0, 1);
                border-radius: 1.5px;
                background: white;
                animate width { duration: 200ms; }
            }
        }
    }
    zone := TouchArea {
        enabled: root.actif;
        mouse-cursor: pointer;
        clicked => { HomeState.play(); }
    }
}

/// Compte : la liste des comptes (Microsoft et hors ligne), ou le compte Microsoft seul.
component TuileCompte inherits Rectangle {
    border-radius: 8px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.glass-border;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;
            PixelLabel {
                text: Tr.t("Home_Compte") + " · " + (HomeState.premium ? "MICROSOFT" : Tr.t("Home_Compte_HorsLigne"));
                font-size: 11px;
                color: Theme.text-dim;
                overflow: elide;
            }
            Rectangle {
                height: 36px;
                if HomeState.all-accounts.length > 1: GlassCombo {
                    model: HomeState.all-accounts;
                    current-index <=> HomeState.all-index;
                    enabled: !HomeState.ms-busy;
                    selected(i) => { HomeState.all-selected(i); }
                }
                if HomeState.all-accounts.length <= 1 && !HomeState.premium: GlassCombo {
                    model: HomeState.accounts;
                    current-index <=> HomeState.account-index;
                    selected(i) => { HomeState.account-selected(i); }
                }
                if HomeState.all-accounts.length <= 1 && HomeState.premium: Text {
                    text: HomeState.premium-name;
                    font-size: 15px;
                    font-weight: 700;
                    color: Theme.navy;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

export component Dock inherits HorizontalLayout {
    /// largeur des tuiles carrées (la colonne de gauche de la fenêtre)
    in property <length> case: 64px;
    spacing: 12px;

    TuileIcone {
        width: root.case;
        icon: "\u{E713}";
        tooltip: Tr.t("Nav_Options");
        active: SettingsState.open;
        clicked => { AppState.nav-clicked(2); }
    }
    TuileChoix {
        horizontal-stretch: 1;
        min-width: 240px;
    }
    BlocJouer {
        width: 250px;
    }
    // compte (ou « annuler » pendant un téléchargement)
    if !HomeState.can-cancel: TuileCompte {
        horizontal-stretch: 1;
        min-width: 200px;
    }
    if HomeState.can-cancel: TuileIcone {
        horizontal-stretch: 1;
        icon: "\u{E711}";
        tooltip: Tr.t("Commun_Annuler");
        clicked => { HomeState.cancel-install(); }
    }
    // avatar : ouvre l'onglet Skin
    Rectangle {
        width: root.case;
        border-radius: 8px;
        background: Theme.panel;
        border-width: 1px;
        border-color: zone-avatar.has-hover ? Theme.accent.with-alpha(0.6) : Theme.glass-border;
        clip: true;
        animate border-color { duration: Theme.fast; }
        Thumb {
            width: parent.width - 16px;
            height: self.width;
            radius: 6px;
            logo-margin: 8px;
            logo-opacity: 1;
            source: HomeState.avatar;
            has-image: HomeState.has-avatar;
            pixel-art: true;
        }
        zone-avatar := TouchArea {
            mouse-cursor: pointer;
            clicked => { AppState.nav-clicked(7); }
        }
    }
}
