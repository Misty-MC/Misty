// Onglet « Skin » de l'accueil, en vitrine : le personnage au centre sur un socle lumineux (halo), à
// gauche la fiche du joueur et « Mes skins » (les skins portés ou essayés), en bas les cosmétiques en
// carrousel (capes Mojang et cosmétiques Misty « bientôt disponibles », dont la cape et les élytres à essayer).

import { Theme, Tr, Assets } from "theme.slint";
import { HomeState, AppState, SettingsState } from "state.slint";
import { Icon, PixelLabel, BodyText, MButton, Spinner } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

/// Un skin de « Mes skins » : sa tête, son identifiant (nom du fichier), et s'il est porté.
export struct SkinHistoryItem {
    id: string,
    head: image,
    current: bool,
}

export struct CapeItem {
    id: string,
    name: string,
    image: image,
    has-image: bool,
    active: bool,
    col: int,
    row: int,
}

export global SkinState {
    /// Onglet de l'accueil : 0 jouer, 1 skin et capes
    in-out property <int> tab: 0;
    in property <[image]> frames;
    /// Images de la marche : pose x 12 angles
    in property <[image]> walk-frames;
    in-out property <bool> walk: false;
    in-out property <bool> elytra: false;
    /// Montrer la cape Mojang portée
    in-out property <bool> show-cape: true;
    /// Cosmétique Misty équipé : 0 aucun · 1 cape Misty · 2 élytres Misty
    in-out property <int> misty-equip: 0;
    /// Chapeau Cloudly porté (en plus de la cape)
    in-out property <bool> misty-hat: false;
    /// Ce compte a droit à la cape early player (le site le dit)
    in property <bool> misty-early: false;
    in property <image> misty-early-cape;
    in property <image> misty-cloudly;
    /// Misty Client (le mod en jeu) est dans ce launcher : l'article équipé se voit en jeu
    in property <bool> misty-in-game;
    /// Version de Minecraft de Misty Client
    in property <string> misty-mc;
    /// Aperçus de la cape et des élytres Misty (face extérieure de la texture)
    in property <image> misty-cape;
    in property <image> misty-elytra;
    callback elytra-toggled();
    callback walk-toggled();
    callback look-changed();
    /// Animation du studio : 0 repos · 1 marche · 2 course · 3 vol · 4 accroupi
    in-out property <int> anim: 0;
    /// Élytres sorties automatiquement pour le vol
    in-out property <bool> elytra-auto: false;
    /// Image du rendu en direct (fil du studio)
    in property <image> live;
    in property <bool> live-ready;
    callback render-frame(float, float, int);
    in property <bool> has-figure;
    in property <[CapeItem]> capes;
    in property <int> cape-rows: 1;
    in property <bool> loading;
    in property <bool> busy;
    in-out property <bool> slim;
    in property <string> file-name;
    in property <bool> has-file;
    in property <string> info;
    /// Catégorie de cosmétiques affichée (0 capes … 8 packs)
    in-out property <int> category: 0;
    /// La caméra cadre la catégorie choisie (sinon : tout le personnage)
    in-out property <bool> focus: false;
    /// +1 à chaque clic sur une catégorie (même la catégorie déjà ouverte : on recadre)
    in-out property <int> focus-count: 0;
    callback open();
    callback pick-file();
    callback slim-changed();
    callback apply();
    callback select-cape(string);
    /// « Mes skins » : les skins portés ou essayés, les plus récents d'abord
    in property <[SkinHistoryItem]> history;
    callback history-picked(string);
}

// ───────────────────────── Petits éléments ─────────────────────────

/// Groupe de boutons collés (vues, animations), comme les « .seg » du site.
component Seg inherits Rectangle {
    in property <[string]> items;
    in property <int> current;
    callback choisi(int);
    height: 38px;
    width: rangee.preferred-width + 8px;
    border-radius: 12px;
    background: Theme.dark ? #0A0F1D9E : #FFFFFF8C;
    border-width: 1px;
    border-color: Theme.glass-border;
    rangee := HorizontalLayout {
        x: 4px;
        y: 4px;
        height: 30px;
        spacing: 2px;
        for t[i] in root.items: Rectangle {
            property <bool> actif: i == root.current;
            width: lib.preferred-width + 18px;
            border-radius: 9px;
            background: self.actif ? Theme.fill : zone.has-hover ? Theme.glass-hover : transparent;
            drop-shadow-offset-y: self.actif ? 3px : 0px;
            drop-shadow-color: Theme.fill-lip;
            animate background { duration: Theme.fast; }
            lib := Text {
                text: t;
                font-size: 13px;
                font-weight: 600;
                color: parent.actif ? Theme.on-fill : zone.has-hover ? Theme.navy : Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            zone := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.choisi(i); }
            }
        }
    }
}

/// Bouton à bascule (cape, élytres, rotation), comme les « .toggle » du site : enfoncé quand actif.
component Bascule inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked;
    height: 38px;
    width: contenu.preferred-width;
    opacity: root.enabled ? 1 : 0.4;
    // relief
    Rectangle {
        y: 3px;
        height: parent.height - 3px;
        border-radius: 11px;
        background: Theme.lip;
        opacity: root.active ? 0 : 0.8;
    }
    face := Rectangle {
        y: root.active ? 2px : 0px;
        height: parent.height - 3px;
        border-radius: 11px;
        background: root.active ? Theme.accent.with-alpha(0.35) : Theme.dark ? #0A0F1D9E : #FFFFFFB3;
        border-width: 1px;
        border-color: root.active ? Theme.accent : Theme.glass-border;
        animate y { duration: 120ms; easing: ease-out; }
        animate background, border-color { duration: Theme.normal; }
        contenu := HorizontalLayout {
            padding-left: root.text == "" ? 11px : 12px;
            padding-right: root.text == "" ? 11px : 12px;
            spacing: 7px;
            Icon {
                text: root.icon;
                font-size: 13px;
                color: Theme.accent;
            }
            if root.text != "": Text {
                text: root.text;
                font-size: 13px;
                font-weight: 600;
                color: root.active || zone.has-hover ? Theme.navy : Theme.text-muted;
                vertical-alignment: center;
            }
        }
    }
    zone := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ───────────────────────── La scène (à gauche) ─────────────────────────

/// Le personnage sur un socle lumineux : halo de lune derrière, rien ne bouge tout seul.
component Scene3D inherits Rectangle {

    // Caméra (en degrés) : autour du personnage (yaw) et de haut ou de bas (pitch)
    property <float> yaw: 0;
    property <float> pitch: 8;
    /// élan après un lancer à la souris (degrés par image), qui s'amortit
    property <float> elan: 0;
    property <float> elan-pitch: 0;
    /// vue demandée (Face, Côté, Dos) : la caméra y glisse en douceur
    property <float> cible: 0;
    property <bool> vise: false;
    property <bool> glisse: false;
    property <bool> tourne: true;
    /// inclinaison demandée par un cadrage
    property <float> pitch-cible: 8;
    property <bool> vise-pitch: false;
    property <length> dernier-x: 0px;
    property <length> dernier-y: 0px;
    property <image> vide;

    // Une image par rafraîchissement d'écran, seulement quand le studio est à l'écran
    Timer {
        interval: 16ms;
        running: SkinState.tab == 1 && AppState.page == 0 && !SettingsState.open;
        triggered => {
            if (root.vise-pitch && !root.glisse) {
                root.pitch += (root.pitch-cible - root.pitch) * 0.16;
                if (abs(root.pitch-cible - root.pitch) < 0.2) {
                    root.pitch = root.pitch-cible;
                    root.vise-pitch = false;
                }
            }
            if (root.vise) {
                root.yaw += (root.cible - root.yaw) * 0.16;
                if (abs(root.cible - root.yaw) < 0.2) {
                    root.yaw = root.cible;
                    root.vise = false;
                }
            } else if (!root.glisse) {
                root.yaw += root.elan + (root.tourne ? 0.45 : 0);
                root.pitch = clamp(root.pitch + root.elan-pitch, -20, 45);
                root.elan *= 0.92;
                root.elan-pitch *= 0.88;
            }
            SkinState.render-frame(root.yaw, root.pitch, SkinState.anim);
        }
    }

    border-radius: 8px;
    clip: true;
    background: Theme.dark ? @linear-gradient(180deg, #162140B8 0%, #0C1324D1 100%) : @linear-gradient(180deg, #FFFFFF59 0%, #DCE8F8A6 100%);
    border-width: 1px;
    border-color: Theme.glass-border;

    // halo de lune, fixe
    Rectangle {
        property <length> d: min(400px, parent.width * 0.9);
        x: (parent.width - self.d) / 2;
        y: parent.height * 0.44 - self.d / 2;
        width: self.d;
        height: self.d;
        border-radius: self.d / 2;
        opacity: 0.85;
        background: @radial-gradient(circle, Theme.accent.with-alpha(0.32) 0%, Theme.accent.with-alpha(0.08) 45%, Theme.accent.with-alpha(0) 70%);
    }

    // repère du sol (sans décor : seulement l'ombre du personnage, plus bas)
    socle := Rectangle {
        property <length> d: min(300px, parent.width * 0.78);
        x: (parent.width - self.d) / 2;
        y: parent.height - 122px - self.d * 0.13;
        width: self.d;
        height: self.d * 0.26;
    }

    // ── Cadrage par catégorie ──
    // [angle autour, inclinaison, zoom, décalage latéral, hauteur visée] ; unités du modèle :
    // les pieds à 0, le sommet de la tête à 32, le centre de l'image à 16.
    property <[[float]]> cadrages: [
        [180, 8, 1.3, 0, 16],     // capes : le dos
        [155, 16, 1.2, 0, 19],    // ailes : le dos, un peu de haut
        [25, 12, 2.0, 0, 29],     // chapeaux : la tête, avec de la place au-dessus
        [20, 6, 1.5, 0, 16],      // tenues : le corps
        [0, 8, 0.85, 0, 16],      // effets : tout le personnage, avec de la place autour
        [30, 12, 1.8, 5.2, 26],   // compagnons : l'épaule, avec de la place au-dessus
        [0, 6, 1.6, 0, 21],       // emotes : le haut du corps
        [0, 4, 2.0, 0, 34],       // tags : le pseudo au-dessus de la tête
        [20, 8, 1.0, 0, 16],      // packs : tout le personnage
    ];
    property <bool> cadre: SkinState.focus && SkinState.category >= 0 && SkinState.category < root.cadrages.length;
    property <float> zoom-cadre: root.cadre ? root.cadrages[SkinState.category][2] : 1;
    /// zoom à la molette, par-dessus le cadrage
    property <float> zoom-main: 1;
    animate zoom-main { duration: 140ms; easing: ease-out; }
    property <float> zoom: root.zoom-cadre * root.zoom-main;
    property <float> vise-u: root.cadre ? root.cadrages[SkinState.category][3] : 0;
    property <float> vise-h: root.cadre ? root.cadrages[SkinState.category][4] : 16;
    property <float> attire: root.cadre ? 1 : 0;
    animate zoom-cadre, vise-u, vise-h, attire { duration: 650ms; easing: ease-in-out; }
    property <int> demande: SkinState.focus-count;
    changed demande => {
        if (!root.cadre) {
            return;
        }
        root.tourne = false;
        root.glisse = false;
        root.elan = 0;
        root.elan-pitch = 0;
        root.zoom-main = 1;
        let c = root.cadrages[SkinState.category];
        // le plus court chemin vers l'angle du cadrage
        root.cible = root.yaw + Math.mod(Math.mod(c[0] - root.yaw + 180, 360) + 360, 360) - 180;
        root.vise = true;
        root.pitch-cible = c[1];
        root.vise-pitch = true;
    }

    // ombre au sol
    Rectangle {
        opacity: clamp(1 - (root.zoom - 1) * 3, 0, 1);
        property <float> s: 1;
        x: (parent.width - self.width) / 2;
        y: socle.y + socle.height / 2 - self.height / 2;
        width: 120px * self.s;
        height: 16px * self.s;
        border-radius: self.height / 2;
        background: @radial-gradient(circle, #00000073 0%, #00000000 70%);
    }

    // personnage : rendu en direct (sinon, en attendant, les vues pré-calculées)
    property <length> cote: min(380px, root.height - 190px, root.width - 20px);
    // une unité du modèle à l'écran (le rendu fait 320 px pour 9 px par unité), sans puis avec le zoom
    property <length> unite-1: root.cote * 9 / 320;
    property <length> unite: root.unite-1 * root.zoom;
    // centre de l'image sans cadrage : les pieds se posent au centre du socle
    property <length> centre-x0: root.width / 2;
    property <length> centre-y0: socle.y + socle.height / 2 - root.unite-1 * 16 + 4px;
    // le point visé, là où il est sans zoom, attiré vers le milieu de la scène
    property <length> vise-x: root.centre-x0 + root.vise-u * root.unite-1;
    property <length> vise-y: root.centre-y0 - (root.vise-h - 16) * root.unite-1;
    property <length> ancre-x: root.vise-x + (root.width / 2 - root.vise-x) * root.attire;
    property <length> ancre-y: root.vise-y + (root.height * 0.46 - root.vise-y) * root.attire;
    // centre de l'image zoomée : le point visé reste sur l'ancre
    property <length> centre-x: root.ancre-x - root.vise-u * root.unite;
    property <length> centre-y: root.ancre-y + (root.vise-h - 16) * root.unite;
    if SkinState.live-ready: Image {
        width: root.cote * root.zoom;
        height: root.cote * root.zoom;
        x: root.centre-x - self.width / 2;
        y: root.centre-y - self.height / 2;
        source: SkinState.live;
        image-fit: contain;
        image-rendering: pixelated;
    }
    if !SkinState.live-ready && SkinState.has-figure: Image {
        width: root.cote * 0.7;
        height: root.cote;
        x: (parent.width - self.width) / 2;
        y: socle.y + socle.height / 2 - self.height + 10px;
        source: SkinState.frames.length > 0 ? SkinState.frames[Math.mod(Math.mod(Math.round(root.yaw / 10), 36) + 36, 36)] : root.vide;
        image-fit: contain;
        image-rendering: pixelated;
    }
    if !SkinState.has-figure && !SkinState.live-ready && SkinState.loading: Spinner { }
    if !SkinState.has-figure && !SkinState.live-ready && !SkinState.loading: Image {
        x: (parent.width - 110px) / 2;
        y: parent.height * 0.3;
        width: 110px;
        height: 110px;
        source: HomeState.has-avatar ? HomeState.avatar : Assets.logo;
        image-fit: contain;
        image-rendering: pixelated;
    }

    // pseudo au-dessus de la tête (en pixel, sur un fond sombre, comme dans le jeu)
    if SkinState.live-ready || SkinState.has-figure: Rectangle {
        property <string> nom: HomeState.premium ? HomeState.premium-name : HomeState.account-index >= 0 && HomeState.account-index < HomeState.accounts.length ? HomeState.accounts[HomeState.account-index] : "Steve";
        // le pseudo grandit avec le zoom, un peu moins vite que le personnage
        property <float> echelle: max(0.85, 1 + (root.zoom - 1) * 0.7);
        width: etiquette.preferred-width + 22px * self.echelle;
        height: 30px * self.echelle;
        x: root.centre-x - self.width / 2;
        // posé au-dessus de la tête (sommet du modèle : 32)
        y: max(58px * (1 - root.attire), root.centre-y - 16 * root.unite - self.height - 6px * self.echelle);
        // coupé par le haut de la scène (zoom sur le corps) : on le cache plutôt que de le tronquer
        opacity: clamp((self.y - 50px) / 16px, 0, 1);
        animate opacity { duration: 200ms; }
        border-radius: 3px * self.echelle;
        background: #0A0F1D8C;
        etiquette := Text {
            text: parent.nom.to-uppercase();
            font-family: Theme.pixel-font;
            font-size: 16px * parent.echelle;
            color: #EAF1FF;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // prendre le personnage : de gauche à droite pour tourner, de haut en bas pour l'incliner
    TouchArea {
        // main ouverte au survol, poing pendant le glisser
        property <image> curseur: root.glisse ? @image-url("../assets/curseur-poing.png") : @image-url("../assets/curseur-main.png");
        mouse-cursor: custom(self.curseur, 16, 16);
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.glisse = true;
                root.tourne = false;
                root.vise = false;
                root.vise-pitch = false;
                root.elan = 0;
                root.elan-pitch = 0;
                root.dernier-x = self.mouse-x;
                root.dernier-y = self.mouse-y;
            } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                root.glisse = false;
            }
        }
        moved => {
            if (root.glisse) {
                let dx = (self.mouse-x - root.dernier-x) / 1px;
                let dy = (self.mouse-y - root.dernier-y) / 1px;
                root.yaw -= dx * 0.55;
                root.pitch = clamp(root.pitch + dy * 0.35, -20, 45);
                // élan gardé au lâcher (inertie)
                root.elan = -dx * 0.55 * 0.6;
                root.elan-pitch = dy * 0.35 * 0.4;
                root.dernier-x = self.mouse-x;
                root.dernier-y = self.mouse-y;
            }
        }
        scroll-event(e) => {
            // molette vers le haut : on s'approche
            if (e.delta-y > 0) {
                root.zoom-main = min(3, root.zoom-main * 1.12);
            } else if (e.delta-y < 0) {
                root.zoom-main = max(0.6, root.zoom-main / 1.12);
            }
            accept
        }
        double-clicked => {
            // double-clic : retour à la vue de face, à hauteur normale
            SkinState.focus = false;
            root.zoom-main = 1;
            root.vise-pitch = false;
            root.tourne = false;
            root.cible = round(root.yaw / 360) * 360;
            root.vise = true;
            root.pitch = 8;
        }
    }

    // ── en haut : vues et rotation ──
    property <float> angle-vu: Math.mod(Math.mod(root.yaw, 360) + 360, 360);
    if SkinState.has-figure || SkinState.live-ready: Seg {
        x: 14px;
        y: 14px;
        items: [Tr.t("Skin_Vue_Face"), Tr.t("Skin_Vue_Cote"), Tr.t("Skin_Vue_Dos")];
        current: root.tourne ? -1 : root.angle-vu < 45 || root.angle-vu > 315 ? 0 : root.angle-vu > 135 && root.angle-vu < 225 ? 2 : 1;
        choisi(i) => {
            SkinState.focus = false;
            root.zoom-main = 1;
            root.tourne = false;
            root.elan = 0;
            let vise = i == 0 ? 0 : i == 1 ? 90 : 180;
            // le plus court chemin vers la vue demandée
            root.cible = root.yaw + Math.mod(Math.mod(vise - root.yaw + 180, 360) + 360, 360) - 180;
            root.vise = true;
        }
    }
    if SkinState.has-figure || SkinState.live-ready: Bascule {
        x: parent.width - self.width - 14px;
        y: 14px;
        icon: "\u{E895}";
        text: Tr.t("Skin_Rotation");
        active: root.tourne;
        clicked => {
            root.tourne = !root.tourne;
            root.vise = false;
            if (root.tourne) {
                SkinState.focus = false;
            }
        }
    }

    // ── en bas : animations, cape, élytres ──
    if SkinState.has-figure || SkinState.live-ready: Text {
        y: parent.height - 78px;
        width: parent.width;
        text: Tr.t("Skin_Glisser");
        opacity: 1 - root.attire;
        font-size: 12.5px;
        color: Theme.text-dim;
        horizontal-alignment: center;
    }
    if SkinState.has-figure || SkinState.live-ready: Seg {
        x: 14px;
        y: parent.height - self.height - 14px;
        items: [Tr.t("Skin_Repos"), Tr.t("Skin_Vue_Marche"), Tr.t("Skin_Course"), Tr.t("Skin_Vol"), Tr.t("Skin_Accroupi")];
        current: SkinState.anim;
        choisi(i) => {
            SkinState.anim = i;
            // en vol, on sort les élytres ; on les range en quittant le vol si c'est nous qui les avions sorties
            if (i == 3 && !SkinState.elytra && SkinState.misty-equip != 2) {
                SkinState.elytra = true;
                SkinState.elytra-auto = true;
                SkinState.elytra-toggled();
            } else if (i != 3 && SkinState.elytra-auto) {
                SkinState.elytra = false;
                SkinState.elytra-auto = false;
                SkinState.elytra-toggled();
            }
        }
    }
    if SkinState.has-figure || SkinState.live-ready: HorizontalLayout {
        x: parent.width - self.preferred-width - 14px;
        y: parent.height - 38px - 14px;
        height: 38px;
        spacing: 6px;
        Bascule {
            icon: "\u{E7C1}";
            text: "";
            active: SkinState.show-cape && SkinState.misty-equip == 0;
            enabled: HomeState.premium;
            clicked => {
                SkinState.show-cape = !SkinState.show-cape || SkinState.misty-equip != 0;
                SkinState.misty-equip = 0;
                SkinState.look-changed();
            }
        }
        Bascule {
            icon: "\u{E709}";
            text: "";
            active: SkinState.elytra || SkinState.misty-equip == 2;
            clicked => {
                if (SkinState.misty-equip == 2) {
                    SkinState.misty-equip = 0;
                    SkinState.elytra = false;
                } else {
                    SkinState.elytra = !SkinState.elytra;
                }
                SkinState.elytra-auto = false;
                SkinState.elytra-toggled();
            }
        }
    }
}

// ───────────────────────── Le vestiaire (à droite) ─────────────────────────

/// Case « bientôt » : icône pâle sur fond rayé, bordure pointillée.
component CaseBientot inherits Rectangle {
    in property <string> icon;
    border-radius: 12px;
    clip: true;
    background: Theme.glass;
    border-width: 1px;
    border-color: Theme.glass-border;
    // rayures en biais
    for r in 12: Rectangle {
        x: r * 22px - 60px;
        y: -20px;
        width: 10px;
        height: parent.height + 40px;
        background: Theme.dark ? #FFFFFF08 : #1C233508;
        transform-rotation: 45deg;
    }
    Icon {
        y: (parent.height - self.height) / 2 - 6px;
        text: root.icon;
        font-size: 26px;
        color: Theme.text-dim;
        opacity: 0.55;
    }
    PixelLabel {
        y: parent.height - 20px;
        width: parent.width;
        text: Tr.t("Skin_Bientot");
        font-size: 11px;
        color: Theme.text-dim;
        horizontal-alignment: center;
    }
}

/// Article Misty à essayer (cape ou élytres) : une case comme les capes Mojang. Un clic l'essaie,
/// un second clic le retire.
component CaseMisty inherits Rectangle {
    in property <string> text;
    in property <int> genre;
    property <bool> equipe: root.genre == 4 ? SkinState.misty-hat : SkinState.misty-equip == root.genre;
    property <bool> verrou: root.genre == 3 && !SkinState.misty-early;
    border-radius: 12px;
    background: root.equipe ? Theme.accent-soft : zone.has-hover ? Theme.glass-hover : Theme.glass-strong;
    border-width: root.equipe ? 2px : 1px;
    border-color: root.equipe ? Theme.accent : Theme.glass-border;
    transform-scale: zone.pressed ? 0.96 : 1;
    animate background, border-color { duration: Theme.normal; }
    animate transform-scale { duration: 140ms; easing: ease-out; }
    // aperçu, à la même place que l'image des capes Mojang
    Rectangle {
        y: 10px;
        height: parent.height - 40px;
        // même taille et même place que l'image des capes Mojang
        if root.genre == 1: Image {
            x: (parent.width - self.width) / 2;
            y: 0;
            width: min(root.width * 0.42, (root.height - 40px) * 0.62);
            height: self.width * 1.6;
            source: SkinState.misty-cape;
            image-fit: contain;
            image-rendering: pixelated;
        }
        if root.genre == 2: Image {
            x: (parent.width - self.width) / 2;
            y: 0;
            width: min(root.width * 0.62, (root.height - 40px) * 1.05);
            height: parent.height;
            source: SkinState.misty-elytra;
            image-fit: contain;
            image-rendering: pixelated;
        }
        if root.genre == 3: Image {
            x: (parent.width - self.width) / 2;
            y: 0;
            width: min(root.width * 0.42, (root.height - 40px) * 0.62);
            height: self.width * 1.6;
            source: SkinState.misty-early-cape;
            image-fit: contain;
            image-rendering: pixelated;
            opacity: root.verrou ? 0.45 : 1;
        }
        if root.genre == 4: Image {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(root.width * 0.62, (root.height - 40px) * 1.2);
            height: self.width / 2;
            source: SkinState.misty-cloudly;
            image-fit: contain;
            image-rendering: pixelated;
        }
    }
    // cadenas : réservée aux premiers joueurs
    if root.verrou: Icon {
        x: parent.width - 24px;
        y: 6px;
        width: 18px;
        height: 18px;
        text: "\u{E72E}";
        font-size: 12px;
        color: #FFC46B;
    }
    Text {
        x: 6px;
        y: parent.height - 24px;
        width: parent.width - 12px;
        text: root.verrou ? Tr.t("Cos_Early_Verrou") : root.text;
        font-size: 11px;
        font-weight: 600;
        color: root.verrou ? #FFC46B : root.equipe ? Theme.accent : Theme.navy;
        horizontal-alignment: center;
        overflow: elide;
    }
    zone := TouchArea {
        mouse-cursor: root.verrou ? default : pointer;
        clicked => {
            if (root.verrou) {
                return;
            }
            if (root.genre == 4) {
                SkinState.misty-hat = !SkinState.misty-hat;
            } else {
                SkinState.misty-equip = root.equipe ? 0 : root.genre;
                if (root.genre == 1 || root.genre == 3) {
                    SkinState.show-cape = true;
                }
            }
            SkinState.look-changed();
        }
    }
}

/// Cape Mojang du joueur (vraie cape, appliquée au compte).
component CaseCape inherits Rectangle {
    in property <string> name;
    in property <image> image;
    in property <bool> has-image;
    in property <bool> active;
    callback clicked;
    border-radius: 12px;
    background: root.active ? Theme.accent-soft : zone.has-hover ? Theme.glass-hover : Theme.glass-strong;
    border-width: root.active ? 2px : 1px;
    border-color: root.active ? Theme.accent : Theme.glass-border;
    transform-scale: zone.pressed ? 0.96 : 1;
    animate background, border-color { duration: Theme.normal; }
    animate transform-scale { duration: 140ms; easing: ease-out; }
    if root.has-image: Image {
        x: (parent.width - self.width) / 2;
        y: 10px;
        width: min(parent.width * 0.42, (parent.height - 40px) * 0.62);
        height: self.width * 1.6;
        source: root.image;
        image-fit: contain;
        image-rendering: pixelated;
    }
    if !root.has-image: Icon {
        y: 10px;
        height: parent.height - 40px;
        text: "\u{E711}";
        font-size: 22px;
        color: Theme.text-dim;
    }
    Text {
        x: 6px;
        y: parent.height - 24px;
        width: parent.width - 12px;
        text: root.name;
        font-size: 11px;
        font-weight: 600;
        color: root.active ? Theme.accent : Theme.navy;
        horizontal-alignment: center;
        overflow: elide;
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        enabled: !SkinState.busy;
        clicked => { root.clicked(); }
    }
}

/// Une tête de « Mes skins » : un clic la reprend (aperçu, puis Appliquer).
component TeteSkin inherits Rectangle {
    in property <SkinHistoryItem> item;
    callback clicked;
    border-radius: 8px;
    background: Theme.glass-strong;
    border-width: root.item.current ? 2px : 1px;
    border-color: root.item.current ? Theme.accent : zone.has-hover ? Theme.accent.with-alpha(0.5) : Theme.glass-border;
    animate border-color { duration: Theme.fast; }
    Image {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        source: root.item.head;
        image-fit: contain;
        image-rendering: ImageRendering.pixelated;
    }
    if root.item.current: Rectangle {
        x: 3px;
        y: parent.height - 15px;
        width: parent.width - 6px;
        height: 12px;
        border-radius: 3px;
        background: Theme.accent;
        Text {
            text: Tr.t("Skin_Porte");
            font-size: 11px;
            font-weight: 700;
            color: Theme.on-fill;
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SkinPanel inherits Rectangle {
    // catégories : icône, nom, description
    property <[{icon: string, nom: string, texte: string}]> categories: [
        { icon: "\u{E7C1}", nom: Tr.t("Cos_Capes"), texte: Tr.t("Cos_Capes_T") },
        { icon: "\u{E709}", nom: Tr.t("Cos_Ailes"), texte: Tr.t("Cos_Ailes_T") },
        { icon: "\u{E734}", nom: Tr.t("Cos_Chapeaux"), texte: Tr.t("Cos_Chapeaux_T") },
        { icon: "\u{E81E}", nom: Tr.t("Cos_Tenues"), texte: Tr.t("Cos_Tenues_T") },
        { icon: "\u{E9A9}", nom: Tr.t("Cos_Effets"), texte: Tr.t("Cos_Effets_T") },
        { icon: "\u{EB51}", nom: Tr.t("Cos_Compagnons"), texte: Tr.t("Cos_Compagnons_T") },
        { icon: "\u{E76E}", nom: Tr.t("Cos_Emotes"), texte: Tr.t("Cos_Emotes_T") },
        { icon: "\u{E8EC}", nom: Tr.t("Cos_Tags"), texte: Tr.t("Cos_Tags_T") },
        { icon: "\u{F158}", nom: Tr.t("Cos_Packs"), texte: Tr.t("Cos_Packs_T") },
    ];
    property <int> cat: SkinState.category;

    HorizontalLayout {
        spacing: 12px;

            // ═══ À gauche : le personnage, sur toute la hauteur ═══
            Scene3D {
                horizontal-stretch: 1;
                min-width: 300px;
                preferred-width: 0px;
            }

            // ═══ À droite : la fiche du joueur, puis les cosmétiques ═══
            VerticalLayout {
                width: 340px;
                spacing: 12px;

                // ── la fiche du joueur et « Mes skins » (défile si elle est trop longue) ──
                Rectangle {
                    height: min(fiche.preferred-height, 240px);
                    border-radius: 8px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.glass-border;
                    clip: true;
                    ScrollView {
                        content-width: self.visible-width;
                        content-height: fiche.preferred-height;
                        fiche := VerticalLayout {
                            width: parent.visible-width;
                            padding: 14px;
                            spacing: 10px;

                            HorizontalLayout {
                                spacing: 10px;
                                Rectangle {
                                    width: 44px;
                                    height: 44px;
                                    border-radius: 8px;
                                    background: Theme.glass-strong;
                                    border-width: 1px;
                                    border-color: Theme.glass-border;
                                    clip: true;
                                    Image {
                                        width: parent.width;
                                        height: parent.height;
                                        source: HomeState.has-avatar ? HomeState.avatar : Assets.logo;
                                        image-fit: HomeState.has-avatar ? ImageFit.cover : ImageFit.contain;
                                        image-rendering: HomeState.has-avatar ? ImageRendering.pixelated : ImageRendering.smooth;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: HomeState.premium ? HomeState.premium-name : "Steve";
                                        font-size: 17px;
                                        font-weight: 800;
                                        color: Theme.navy;
                                        overflow: elide;
                                    }
                                    if SkinState.busy || SkinState.loading: Spinner {
                                        height: 16px;
                                        width: 16px;
                                    }
                                }
                            }
                            // modèle de bras : l'un sous l'autre, en pleine largeur (« Классический (Стив) »
                            // ne tient pas à côté de l'autre), avec un bouton radio
                            VerticalLayout {
                                spacing: 6px;
                                for m[i] in [Tr.t("Skin_Classique"), Tr.t("Skin_Fin")]: modele := Rectangle {
                                    property <bool> actif: (i == 1) == SkinState.slim;
                                    height: 30px;
                                    border-radius: 8px;
                                    background: self.actif ? Theme.accent-soft : mz.has-hover ? Theme.glass-hover : Theme.glass;
                                    border-width: 1px;
                                    border-color: self.actif ? Theme.accent : Theme.glass-border;
                                    animate background, border-color { duration: Theme.fast; }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 8px;
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 14px;
                                                height: 14px;
                                                border-radius: 7px;
                                                border-width: 1.5px;
                                                border-color: modele.actif ? Theme.accent : Theme.text-dim;
                                                Rectangle {
                                                    width: modele.actif ? 6px : 0px;
                                                    height: self.width;
                                                    border-radius: self.width / 2;
                                                    background: Theme.accent;
                                                    animate width { duration: 200ms; easing: ease-out; }
                                                }
                                            }
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: m;
                                            font-size: 12.5px;
                                            font-weight: 600;
                                            color: modele.actif ? Theme.accent : Theme.text-muted;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    mz := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if ((i == 1) != SkinState.slim) {
                                                SkinState.slim = i == 1;
                                                SkinState.slim-changed();
                                            }
                                        }
                                    }
                                }
                            }

                            // connexion, ou fichier à envoyer
                            if !HomeState.premium: VerticalLayout {
                                spacing: 8px;
                                BodyText {
                                    text: Tr.t("Skin_Connexion");
                                    font-size: 12px;
                                }
                                MButton {
                                    text: Tr.t("Skin_Connecter");
                                    kind: 1;
                                    enabled: !HomeState.ms-busy;
                                    clicked => { HomeState.ms-clicked(); }
                                }
                            }
                            if HomeState.premium: VerticalLayout {
                                spacing: 6px;
                                MButton {
                                    text: Tr.t("Skin_Appliquer");
                                    icon: "\u{E73E}";
                                    kind: 3;
                                    enabled: SkinState.has-file && !SkinState.busy;
                                    clicked => { SkinState.apply(); }
                                }
                                Text {
                                    text: SkinState.info != "" ? SkinState.info : SkinState.has-file ? SkinState.file-name : Tr.t("Skin_AucunFichier");
                                    font-size: 11.5px;
                                    color: SkinState.info != "" ? Theme.navy2 : Theme.text-muted;
                                    wrap: word-wrap;
                                }
                            }

                            Rectangle {
                                height: 1px;
                                background: Theme.line;
                            }

                            // ── Mes skins ──
                            PixelLabel {
                                text: Tr.t("Skin_MesSkins");
                                font-size: 11px;
                                color: Theme.text-dim;
                            }
                            mes-skins := Rectangle {
                                property <length> taille: (self.width - 24px) / 5;
                                property <int> nombre: SkinState.history.length + 1;
                                height: ceil(self.nombre / 5) * (self.taille + 6px) - 6px;
                                for h[i] in SkinState.history: TeteSkin {
                                    x: Math.mod(i, 5) * (mes-skins.taille + 6px);
                                    y: floor(i / 5) * (mes-skins.taille + 6px);
                                    width: mes-skins.taille;
                                    height: mes-skins.taille;
                                    item: h;
                                    clicked => { SkinState.history-picked(h.id); }
                                }
                                // ajouter un skin (.png)
                                Rectangle {
                                    x: Math.mod(SkinState.history.length, 5) * (mes-skins.taille + 6px);
                                    y: floor(SkinState.history.length / 5) * (mes-skins.taille + 6px);
                                    width: mes-skins.taille;
                                    height: mes-skins.taille;
                                    border-radius: 8px;
                                    background: ajout.has-hover ? Theme.glass : transparent;
                                    border-width: 2px;
                                    border-color: ajout.has-hover ? Theme.accent : Theme.glass-border;
                                    opacity: SkinState.busy ? 0.5 : 1;
                                    animate background, border-color { duration: Theme.fast; }
                                    Icon {
                                        text: "\u{E710}";
                                        font-size: 16px;
                                        color: Theme.text-muted;
                                    }
                                    ajout := TouchArea {
                                        enabled: !SkinState.busy;
                                        mouse-cursor: pointer;
                                        clicked => { SkinState.pick-file(); }
                                    }
                                }
                            }
                            Text {
                                text: Tr.t("Skin_Ajouter");
                                font-size: 11px;
                                color: Theme.text-dim;
                            }
                        }
                    }
                }

                // ── les cosmétiques : catégories, objets (défilent sur le côté), texte de la catégorie ──
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: 8px;
                    background: Theme.panel;
                    border-width: 1px;
                    border-color: Theme.glass-border;
                    clip: true;
                    VerticalLayout {
                        padding: 12px;
                        padding-left: 14px;
                        spacing: 10px;
                        // catégories (défilent si la place manque : un fondu au bord droit le signale)
                        Rectangle {
                            height: 30px;
                            defile-cat := ScrollView {
                                horizontal-scrollbar-policy: always-off;
                                horizontal-stretch: 1;
                                height: 30px;
                                content-height: 30px;
                                content-width: onglets.preferred-width;
                                onglets := HorizontalLayout {
                                    spacing: 5px;
                                    for c[i] in root.categories: Rectangle {
                                        property <bool> actif: i == root.cat;
                                        height: 30px;
                                        width: nom.preferred-width + 20px;
                                        border-radius: 6px;
                                        background: self.actif ? Theme.fill : zc.has-hover ? Theme.glass-hover : Theme.glass-strong;
                                        border-width: 1px;
                                        border-color: self.actif ? Theme.fill : Theme.glass-border;
                                        animate background { duration: Theme.fast; }
                                        nom := Text {
                                            text: c.nom;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: parent.actif ? Theme.on-fill : Theme.navy;
                                        }
                                        zc := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                SkinState.category = i;
                                                SkinState.focus = true;
                                                SkinState.focus-count += 1;
                                            }
                                        }
                                    }
                                }
                            }
                            // fondu : il reste des catégories à droite
                            if onglets.preferred-width > defile-cat.visible-width + 2px - defile-cat.content-x: Rectangle {
                                x: parent.width - self.width;
                                width: 48px;
                                background: @linear-gradient(90deg, Theme.panel.with-alpha(0) 0%, Theme.panel 100%);
                                Icon {
                                    x: parent.width - self.width - 2px;
                                    text: "\u{E76C}";
                                    font-size: 10px;
                                    color: Theme.text-muted;
                                }
                            }
                        }
                        VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 10px;
                            // cases : capes Mojang (capes) puis l'article Misty, puis « bientôt »
                            Rectangle {
                            height: 112px;
                            cases := ScrollView {
                                property <length> taille: self.visible-height - 4px;
                                property <int> nb-capes: root.cat == 0 ? SkinState.capes.length : 0;
                                property <int> nb-misty: root.cat == 0 ? 2 : root.cat <= 2 ? 1 : 0;
                                property <int> nb-total: max(6, self.nb-capes + self.nb-misty + 2);
                                content-height: self.visible-height;
                                content-width: self.nb-total * (self.taille + 8px);
                                for c[i] in SkinState.capes: CaseCape {
                                    visible: root.cat == 0;
                                    x: i * (cases.taille + 8px);
                                    y: 0;
                                    width: cases.taille;
                                    height: cases.taille;
                                    name: c.name;
                                    image: c.image;
                                    has-image: c.has-image;
                                    active: c.active && SkinState.misty-equip != 1 && SkinState.misty-equip != 3;
                                    clicked => {
                                        SkinState.misty-equip = 0;
                                        SkinState.show-cape = true;
                                        SkinState.select-cape(c.id);
                                    }
                                }
                                if root.cat <= 2: CaseMisty {
                                    x: cases.nb-capes * (cases.taille + 8px);
                                    y: 0;
                                    width: cases.taille;
                                    height: cases.taille;
                                    genre: root.cat == 0 ? 1 : root.cat == 1 ? 2 : 4;
                                    text: root.cat == 0 ? Tr.t("Cos_CapeMisty") : root.cat == 1 ? Tr.t("Cos_ElytresMisty") : "Cloudly";
                                }
                                if root.cat == 0: CaseMisty {
                                    x: (cases.nb-capes + 1) * (cases.taille + 8px);
                                    y: 0;
                                    width: cases.taille;
                                    height: cases.taille;
                                    genre: 3;
                                    text: Tr.t("Cos_CapeEarly");
                                }
                                for b in cases.nb-total - cases.nb-capes - cases.nb-misty: CaseBientot {
                                    x: (cases.nb-capes + cases.nb-misty + b) * (cases.taille + 8px);
                                    y: 0;
                                    width: cases.taille;
                                    height: cases.taille;
                                    icon: root.categories[root.cat].icon;
                                }
                            }
                            // fondu : il reste des cartes à droite
                            if cases.content-width > cases.visible-width + 2px - cases.content-x: Rectangle {
                                x: parent.width - self.width;
                                width: 56px;
                                background: @linear-gradient(90deg, Theme.panel.with-alpha(0) 0%, Theme.panel 100%);
                            }
                            }

                            // la catégorie, et l'article Misty équipé : où il se voit en jeu
                            VerticalLayout {
                                vertical-stretch: 1;
                                spacing: 6px;
                                // le nom de la catégorie, et le badge « Bientôt disponible » (point qui pulse)
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: root.categories[root.cat].nom;
                                        font-size: 15px;
                                        font-weight: 700;
                                        color: Theme.navy;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Rectangle {
                                        width: badge.preferred-width + 30px;
                                        height: 24px;
                                        border-radius: 6px;
                                        background: Theme.accent-soft;
                                        border-width: 1px;
                                        border-color: Theme.accent.with-alpha(0.45);
                                        Rectangle {
                                            x: 10px;
                                            width: 6px;
                                            height: 6px;
                                            border-radius: 3px;
                                            background: Theme.toggle-on;
                                            opacity: 0.65 + 0.35 * sin((animation-tick() / 1600ms) * 360deg);
                                        }
                                        badge := PixelLabel {
                                            x: 22px;
                                            text: Tr.t("Skin_BientotDispo");
                                            font-size: 11px;
                                            color: Theme.accent;
                                        }
                                    }
                                }
                                // la description laisse sa place à l'avertissement de l'article équipé
                                if SkinState.misty-equip == 0 && !SkinState.misty-hat: Text {
                                    text: root.categories[root.cat].texte;
                                    font-size: 12px;
                                    color: Theme.text-muted;
                                    overflow: elide;
                                }
                                // article Misty équipé : où il se voit en jeu (ou l'avertissement, sans Misty Client)
                                if SkinState.misty-equip != 0 || SkinState.misty-hat: Rectangle {
                                    min-height: av.preferred-height;
                                    border-radius: 12px;
                                    background: SkinState.misty-in-game ? Theme.accent-soft : Theme.dark ? #FFBE5A14 : #FFF1DC;
                                    border-width: 1px;
                                    border-color: SkinState.misty-in-game ? Theme.accent.with-alpha(0.35) : Theme.dark ? #FFBE5A59 : #F0B35E;
                                    av := HorizontalLayout {
                                        padding: 11px;
                                        spacing: 10px;
                                        Icon {
                                            width: 16px;
                                            vertical-alignment: top;
                                            text: SkinState.misty-in-game ? "\u{E73E}" : "\u{E7BA}";
                                            font-size: 14px;
                                            color: SkinState.misty-in-game ? Theme.accent : #FFC56B;
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: SkinState.misty-in-game ? Tr.t("Cos_EnJeu") + "\n" + Tr.t("Cos_EnJeu_Profil") + " Fabric " + SkinState.misty-mc : Tr.t("Cos_PasEnJeu");
                                            font-size: 12px;
                                            color: SkinState.misty-in-game ? Theme.text : Theme.dark ? #FFD99A : #6B4210;
                                            wrap: word-wrap;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

            }
    }
}
