// Page d'accueil : le paysage, le titre MISTY et une ligne, le carrousel des news (image + texte,
// flèches à gauche et à droite), et en bas un dock flottant (compte · version ou profil · console ·
// JOUER). La progression court le long du dock, le statut ne s'affiche que pendant un lancement.
// Tout à droite, les onglets « Jouer » et « Skin » écrits à la verticale.

import { Theme, Tr } from "theme.slint";
import { HomeState, AppState, NewsItem } from "state.slint";
import { Icon, PixelLabel, OutlinedText, Thumb, IconButton, PlayButton, GlassCombo } from "widgets.slint";
import { ConsoleState } from "console.slint";
import { SkinState, SkinPanel } from "skin.slint";

/// Onglet vertical (« JOUER », « SKIN ») : le texte est écrit de haut en bas.
component VTab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    width: 64px;
    height: lab.preferred-width + 20px;
    opacity: root.active ? 1 : touch.has-hover ? 0.85 : 0.5;
    animate opacity { duration: 150ms; }

    // La rotation s'applique à un rectangle qui contient le texte
    // (elle est ignorée sur l'élément racine d'un composant)
    Rectangle {
        width: lab.preferred-width;
        height: lab.preferred-height;
        x: 36px - self.width / 2;
        y: (parent.height - self.height) / 2;
        transform-rotation: 90deg;
        lab := OutlinedText {
            text: root.text;
            font-size: 30px;
            thickness: 3px;
            depth: 4px;
        }
    }
    // la zone cliquable ne tourne pas
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Onglets « Jouer » et « Skin », écrits à la verticale, tout à droite.
component Onglets inherits VerticalLayout {
    alignment: center;
    spacing: 16px;
    VTab {
        text: Tr.t("Home_Bouton_Jouer");
        active: SkinState.tab == 0;
        clicked => {
            SkinState.tab = 0;
            AppState.nav = 0;
        }
    }
    VTab {
        text: Tr.t("Skin_Onglet");
        active: SkinState.tab == 1;
        clicked => {
            SkinState.tab = 1;
            AppState.nav = 7;
            SkinState.open();
        }
    }
}

/// Flèche ronde du carrousel (précédente / suivante).
component Fleche inherits Rectangle {
    in property <string> icon;
    callback clicked;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: zone.has-hover ? #FFFFFFF0 : #FFFFFFB8;
    drop-shadow-blur: 10px;
    drop-shadow-color: #0A0F1D40;
    transform-scale: zone.pressed ? 0.9 : 1;
    animate background { duration: Theme.fast; }
    animate transform-scale { duration: 120ms; easing: ease-out; }
    Icon {
        text: root.icon;
        font-size: 11px;
        color: #1C2335;
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Une diapositive : l'image à gauche, le texte à droite.
component Diapo inherits Rectangle {
    in property <NewsItem> news;
    in property <int> numero;
    in property <length> largeur-image;
    clip: true;
    HorizontalLayout {
        spacing: 0px;
        Rectangle {
            width: root.largeur-image;
            clip: true;
            background: #1C2335;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.news.image;
                image-fit: cover;
                image-rendering: ImageRendering.pixelated;
            }
            // fondu vers le texte
            Rectangle {
                x: parent.width - 60px;
                width: 60px;
                background: @linear-gradient(90deg, #00000000 0%, Theme.dark ? #111A3066 : #FFFFFF33 100%);
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            padding-left: 22px;
            padding-right: 22px;
            padding-top: 18px;
            padding-bottom: 18px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 1px;
                        background: Theme.accent;
                    }
                }
                PixelLabel {
                    text: Tr.t("Home_News");
                    font-size: 10px;
                    color: Theme.accent;
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.news.date;
                    font-size: 11.5px;
                    color: Theme.text-muted;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            Text {
                text: root.news.title;
                font-size: 20px;
                font-weight: 700;
                color: Theme.navy;
                overflow: elide;
            }
            Text {
                vertical-stretch: 1;
                text: root.news.text;
                font-size: 13px;
                color: Theme.text-muted;
                wrap: word-wrap;
                overflow: elide;
            }
            HorizontalLayout {
                alignment: start;
                Rectangle {
                    height: 30px;
                    width: lire.preferred-width + 24px;
                    border-radius: 6px;
                    background: zone-lire.has-hover ? Theme.fill-hover : Theme.fill;
                    animate background { duration: Theme.fast; }
                    lire := HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        PixelLabel {
                            text: Tr.t("Home_LireNews");
                            font-size: 10px;
                            color: Theme.on-fill;
                        }
                        Icon {
                            text: "\u{E72A}";
                            font-size: 10px;
                            color: Theme.on-fill;
                        }
                    }
                    zone-lire := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { HomeState.news-open(root.numero); }
                    }
                }
            }
        }
    }
}

/// Carrousel des news : une grande carte horizontale (image + texte), des flèches à gauche et à
/// droite, des points en bas. Il avance tout seul toutes les 8 s, sauf quand la souris est dessus.
component NewsSlider inherits Rectangle {
    property <int> nombre: HomeState.news-items.length;
    property <int> courant: clamp(HomeState.news-index, 0, max(0, root.nombre - 1));
    property <length> largeur-image: min(root.width * 0.42, 300px);
    height: 190px;
    border-radius: 12px;
    background: Theme.panel-strong;
    border-width: 1px;
    border-color: Theme.glass-border;
    drop-shadow-blur: 22px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: Theme.shadow;

    function aller(pas: int) {
        if (root.nombre > 0) {
            HomeState.news-index = Math.mod(root.courant + pas + root.nombre, root.nombre);
        }
    }

    // survol de toute la carte : met l'avance automatique en pause
    survol := TouchArea { }

    Timer {
        interval: 8s;
        running: root.nombre > 1 && !survol.has-hover;
        triggered => { root.aller(1); }
    }

    Rectangle {
        border-radius: root.border-radius;
        clip: true;
        for news[i] in HomeState.news-items: Diapo {
            x: (i - root.courant) * parent.width;
            width: parent.width;
            height: parent.height;
            news: news;
            numero: i;
            largeur-image: root.largeur-image;
            animate x { duration: 420ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        }
    }

    if root.nombre > 1: Fleche {
        x: 10px;
        y: (parent.height - self.height) / 2;
        icon: "\u{E76B}";
        clicked => { root.aller(-1); }
    }
    if root.nombre > 1: Fleche {
        x: root.largeur-image - self.width - 10px;
        y: (parent.height - self.height) / 2;
        icon: "\u{E76C}";
        clicked => { root.aller(1); }
    }

    // points : un par news, le courant plus long
    if root.nombre > 1: HorizontalLayout {
        x: (root.largeur-image - self.preferred-width) / 2;
        y: parent.height - 18px;
        height: 6px;
        spacing: 5px;
        for news[i] in HomeState.news-items: Rectangle {
            width: i == root.courant ? 18px : 6px;
            height: 6px;
            border-radius: 1px;
            background: i == root.courant ? #FFFFFF : #FFFFFF80;
            animate width, background { duration: 260ms; easing: ease-out; }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { HomeState.news-index = i; }
            }
        }
    }
}

/// Séparateur vertical du dock.
component Trait inherits Rectangle {
    width: 1px;
    height: 34px;
    background: Theme.line;
}

/// Bouton qui ouvre la fenêtre de choix : icône, petite étiquette, et la version ou le profil.
component Choix inherits Rectangle {
    property <bool> actif: HomeState.selectors-enabled;
    min-width: 180px;
    height: 52px;
    border-radius: 8px;
    background: zone.has-hover && root.actif ? Theme.glass-hover : transparent;
    opacity: root.actif ? 1 : 0.55;
    animate background { duration: Theme.fast; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 6px;
                background: HomeState.horizon-selected ? #F0795A29 : Theme.accent-soft;
                Icon {
                    text: HomeState.horizon-selected ? "\u{E945}" : HomeState.misty-selected && HomeState.quick ? "\u{E753}" : HomeState.quick ? "\u{E7FC}" : "\u{E8F1}";
                    font-size: 15px;
                    color: HomeState.horizon-selected ? #F0795A : Theme.accent;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            PixelLabel {
                text: HomeState.horizon-selected ? Tr.t("Hz_Moteur") : HomeState.misty-selected && HomeState.quick ? "MISTY CLIENT" : HomeState.quick ? Tr.t("Commun_Version") : Tr.t("Home_Profil");
                font-size: 9.5px;
                color: Theme.text-dim;
                overflow: elide;
            }
            Text {
                text: HomeState.horizon-selected ? "Horizon · " + HomeState.horizon-build
                    : HomeState.misty-selected && HomeState.quick ? "Misty · " + HomeState.misty-mc
                    : HomeState.quick ? HomeState.card-version + " · " + HomeState.card-loader
                    : (HomeState.profile-index >= 0 && HomeState.profile-index < HomeState.profiles.length ? HomeState.profiles[HomeState.profile-index] : "");
                font-size: 14.5px;
                font-weight: 700;
                color: Theme.navy;
                overflow: elide;
            }
        }
        Icon {
            text: "\u{E70D}";
            font-size: 10px;
            color: Theme.text-muted;
        }
    }
    zone := TouchArea {
        enabled: root.actif;
        mouse-cursor: pointer;
        clicked => {
            HomeState.picker-tab = HomeState.quick || HomeState.horizon-selected ? 0 : 1;
            HomeState.picker-horizon = HomeState.horizon-selected;
            HomeState.picker-misty = HomeState.misty-selected && HomeState.quick && !HomeState.horizon-selected;
            HomeState.picker-open = true;
            if (HomeState.horizon-selected) {
                HomeState.horizon-refresh();
            }
        }
    }
}

/// Compte : avatar, liste des comptes (ou le compte Microsoft seul), ajouter un compte Microsoft.
component Compte inherits HorizontalLayout {
    spacing: 10px;
    VerticalLayout {
        alignment: center;
        Thumb {
            width: 44px;
            height: 44px;
            radius: 7px;
            border: 2px;
            logo-margin: 8px;
            logo-opacity: 1;
            source: HomeState.avatar;
            has-image: HomeState.has-avatar;
            pixel-art: true;
        }
    }
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 150px;
            height: 42px;
            // comptes Microsoft et hors ligne dans la même liste : on choisit, on joue
            if HomeState.all-accounts.length > 1: GlassCombo {
                model: HomeState.all-accounts;
                current-index <=> HomeState.all-index;
                enabled: !HomeState.ms-busy;
                selected(i) => { HomeState.all-selected(i); }
            }
            if HomeState.all-accounts.length <= 1 && !HomeState.premium: GlassCombo {
                model: HomeState.accounts;
                current-index <=> HomeState.account-index;
                selected(i) => { HomeState.account-selected(i); }
            }
            if HomeState.all-accounts.length <= 1 && HomeState.premium: Rectangle {
                border-radius: 8px;
                background: Theme.glass-strong;
                border-width: 1px;
                border-color: Theme.glass-border;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    Icon {
                        text: "\u{E73E}";
                        color: Theme.toggle-on;
                        font-size: 12px;
                    }
                    Text {
                        text: HomeState.premium-name;
                        color: Theme.navy;
                        font-weight: 600;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
    VerticalLayout {
        alignment: center;
        IconButton {
            width: 42px;
            height: 42px;
            icon: "\u{E8FA}";
            tooltip: HomeState.ms-names.length > 0 ? Tr.t("Home_AjouterMicrosoft") : Tr.t("Home_ConnecterMicrosoft");
            enabled: !HomeState.ms-busy;
            clicked => { HomeState.ms-clicked(); }
        }
    }
}

export component HomePage inherits Rectangle {
    VerticalLayout {
        padding-left: 30px;
        padding-right: 22px;
        padding-bottom: 22px;
        spacing: 0px;

        // ═══════════ Le titre et les news, ou la skin ; les onglets verticaux à droite ═══════════
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 12px;
            if SkinState.tab == 0: VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                padding-left: 18px;
                padding-bottom: 26px;
                spacing: 0px;
                HorizontalLayout {
                    alignment: start;
                    OutlinedText {
                        text: "MISTY";
                        font-size: 104px;
                        thickness: 5px;
                        depth: 8px;
                    }
                }
                HorizontalLayout {
                    padding-left: 6px;
                    Text {
                        text: Tr.t("Home_txt-1") + " " + Tr.t("Home_txt-2");
                        font-size: 16px;
                        color: Theme.navy2;
                        wrap: word-wrap;
                    }
                }
                if HomeState.news-visible && HomeState.news-items.length > 0: HorizontalLayout {
                    padding-left: 4px;
                    padding-top: 24px;
                    NewsSlider {
                        horizontal-stretch: 1;
                        max-width: 720px;
                        min-width: 420px;
                        opacity: 0;
                        animate opacity { duration: 500ms; easing: ease-out; }
                        init => { self.opacity = 1; }
                    }
                }
            }
            if SkinState.tab == 1: VerticalLayout {
                horizontal-stretch: 1;
                padding-top: 8px;
                padding-bottom: 18px;
                SkinPanel {
                    vertical-stretch: 1;
                }
            }
            // le titre et les news ont une largeur maximale : les onglets restent collés à droite
            if SkinState.tab == 0: Rectangle { horizontal-stretch: 0.0001; }
            Onglets { }
        }

        // ═══════════ Le dock ═══════════
        Rectangle {
            vertical-stretch: 0;
            height: 76px;
            border-radius: 14px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.glass-border;
            drop-shadow-blur: 26px;
            drop-shadow-offset-y: 10px;
            drop-shadow-color: Theme.shadow;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 12px;
                spacing: 14px;

                Compte { }
                VerticalLayout {
                    alignment: center;
                    Trait { }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    HorizontalLayout {
                        spacing: 6px;
                        Choix {
                            horizontal-stretch: 1;
                        }
                        // profil : gérer son contenu
                        if !HomeState.quick: VerticalLayout {
                            alignment: center;
                            IconButton {
                                width: 42px;
                                height: 42px;
                                icon: "\u{E70F}";
                                tooltip: Tr.t("Home_Gerer");
                                clicked => { HomeState.manage(); }
                            }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        width: 46px;
                        height: 46px;
                        icon: "\u{E756}";
                        icon-size: 16px;
                        tooltip: Tr.t("Home_Bouton_Logs");
                        clicked => {
                            ConsoleState.focused = -1;
                            ConsoleState.open = true;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    PlayButton {
                        width: 176px;
                        height: 58px;
                        font-size: 24px;
                        text: HomeState.play-text;
                        enabled: HomeState.play-enabled;
                        clicked => { HomeState.play(); }
                    }
                }
            }

            // progression : un fil lumineux le long du bas du dock
            Rectangle {
                x: 26px;
                y: parent.height - 3px;
                width: parent.width - 52px;
                height: 2px;
                border-radius: 1px;
                background: HomeState.progress > 0 ? Theme.track : transparent;
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(HomeState.progress, 0, 1);
                    border-radius: 1px;
                    background: Theme.accent;
                    animate width { duration: 200ms; }
                }
            }
        }

        // ═══════════ Statut, sous le dock (seulement quand il se passe quelque chose) ═══════════
        if HomeState.status != "" && HomeState.status != Tr.t("Home_Pret"): HorizontalLayout {
            padding-top: 10px;
            padding-left: 22px;
            padding-right: 22px;
            spacing: 10px;
            height: 32px;
            Text {
                horizontal-stretch: 1;
                text: HomeState.status;
                font-size: 12.5px;
                font-weight: 600;
                color: Theme.navy2;
                vertical-alignment: center;
                overflow: elide;
            }
            PixelLabel {
                text: HomeState.percent-text;
                font-size: 10.5px;
            }
            // mauvaise version lancée par erreur : on arrête le téléchargement
            if HomeState.can-cancel: Rectangle {
                width: annuler.preferred-width + 18px;
                height: 22px;
                border-radius: 7px;
                background: zone-annuler.has-hover ? #FF5A6E33 : #FF5A6E1F;
                border-width: 1px;
                border-color: #FF5A6E66;
                annuler := HorizontalLayout {
                    alignment: center;
                    spacing: 5px;
                    Icon {
                        text: "\u{E711}";
                        font-size: 9px;
                        color: Theme.danger;
                    }
                    Text {
                        text: Tr.t("Commun_Annuler");
                        font-size: 11.5px;
                        font-weight: 700;
                        color: Theme.danger;
                        vertical-alignment: center;
                    }
                }
                zone-annuler := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { HomeState.cancel-install(); }
                }
            }
        }
    }
}
