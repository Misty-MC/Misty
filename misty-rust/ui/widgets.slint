// Composants réutilisables, dans le style « verre dépoli + pixel » de Misty.

import { Theme, Tr, Assets, Bulle } from "theme.slint";
import { ListView } from "std-widgets.slint";

// ───────────────────────── Textes ─────────────────────────

export component Icon inherits Text {
    font-family: Theme.icon-font;
    font-size: 16px;
    color: Theme.navy;
    horizontal-alignment: center;
    vertical-alignment: center;
}

/// Libellé court en capitales (« COMPTE », « VERSIONS », étiquettes) : police d'interface en gras,
/// un peu espacée. (Le pixel reste pour les grands titres : il est illisible en petit.)
export component PixelLabel inherits Text {
    font-family: Theme.ui-font;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.6px;
    color: Theme.label-strong;
    vertical-alignment: center;
}

/// Titre de section (dans une page ou une fenêtre).
export component SectionTitle inherits Text {
    font-family: Theme.ui-font;
    font-size: 20px;
    font-weight: 700;
    color: Theme.navy;
}

export component BodyText inherits Text {
    font-family: Theme.ui-font;
    font-size: 13px;
    color: Theme.text-muted;
    wrap: word-wrap;
}

/// Texte avec contour et ombre portée « en bloc » (style titre pixel).
export component OutlinedText inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 48px;
    in property <color> fill: white;
    in property <color> stroke-color: Theme.slate;
    in property <length> thickness: 4px;
    in property <color> shadow: Theme.slate-dark;
    in property <length> depth: 0px;
    in property <TextHorizontalAlignment> align: left;

    min-width: principal.preferred-width + root.thickness * 2;
    min-height: principal.preferred-height + root.thickness * 2 + root.depth;
    preferred-width: self.min-width;
    preferred-height: self.min-height;
    max-height: self.min-height;
    vertical-stretch: 0;

    if root.depth > 0: Text {
        x: root.thickness;
        y: root.thickness + root.depth;
        width: parent.width - root.thickness * 2;
        text: root.text;
        font-family: Theme.pixel-font;
        font-size: root.font-size;
        color: root.shadow;
        stroke: root.shadow;
        stroke-width: root.thickness;
        stroke-style: outside;
        horizontal-alignment: root.align;
    }
    principal := Text {
        x: root.thickness;
        y: root.thickness;
        width: parent.width - root.thickness * 2;
        text: root.text;
        font-family: Theme.pixel-font;
        font-size: root.font-size;
        color: root.fill;
        stroke: root.stroke-color;
        stroke-width: root.thickness;
        stroke-style: outside;
        horizontal-alignment: root.align;
    }
}

// ───────────────────────── Conteneurs ─────────────────────────

export component GlassCard inherits Rectangle {
    background: Theme.glass;
    border-width: 1.5px;
    border-color: Theme.glass-border;
    border-radius: 12px;
}

/// Carré sombre avec une image (icône de projet, de profil…), le bloc d'herbe en attendant.
export component Thumb inherits Rectangle {
    in property <image> source;
    in property <bool> has-image;
    in property <length> radius: 14px;
    in property <length> logo-margin: 14px;
    in property <float> logo-opacity: 0.6;
    in property <length> border: 0px;
    in property <bool> pixel-art: false;

    background: Theme.dark ? #162140 : #1C2335;
    border-radius: root.radius;
    border-width: root.border;
    border-color: white;
    clip: true;

    Image {
        x: root.logo-margin;
        y: root.logo-margin;
        width: parent.width - root.logo-margin * 2;
        height: parent.height - root.logo-margin * 2;
        source: Assets.logo;
        image-fit: contain;
        image-rendering: smooth;
        opacity: root.logo-opacity;
        visible: !root.has-image;
    }
    if root.has-image: Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: cover;
        image-rendering: root.pixel-art ? ImageRendering.pixelated : ImageRendering.smooth;
    }
}

/// Petite étiquette colorée ("1.20.1", "FABRIC"…).
export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> couleur: Theme.fill;
    in property <length> font-size: 11.5px;
    background: root.couleur;
    border-radius: 7px;
    height: label.preferred-height + 8px;
    width: label.preferred-width + 18px;
    label := Text {
        text: root.text;
        font-family: Theme.ui-font;
        font-size: root.font-size;
        font-weight: 700;
        letter-spacing: 0.4px;
        color: white;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// ───────────────────────── Boutons ─────────────────────────

/// Bouton texte en relief (comme les boutons du site) : il se soulève au survol et s'enfonce au clic.
/// kind : 0 = verre, 1 = principal, 2 = danger, 3 = vert.
export component MButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <int> kind: 0;
    in property <bool> enabled: true;
    /// L'icône tourne (recherche en cours) sans changer la taille du bouton
    in property <bool> icon-spin: false;
    callback clicked;

    height: 40px;
    min-width: contenu.preferred-width;
    opacity: root.enabled ? 1 : 0.5;
    animate opacity { duration: Theme.normal; }

    property <color> fond: root.kind == 1 ? Theme.fill : root.kind == 2 ? Theme.danger : root.kind == 3 ? Theme.green-dark : Theme.glass-strong;
    property <color> relief: root.kind == 1 ? Theme.fill-lip : root.kind == 2 ? #B8323F : root.kind == 3 ? Theme.green-edge : Theme.lip;
    property <color> encre: root.kind == 0 ? Theme.text : Theme.on-fill;
    property <bool> survol: touch.has-hover && root.enabled;
    property <bool> appui: touch.pressed && root.enabled;

    // relief sous le bouton
    Rectangle {
        y: 3px;
        height: parent.height - 3px;
        border-radius: 8px;
        background: root.relief;
        opacity: root.kind == 0 ? 0.55 : 1;
    }
    face := Rectangle {
        y: root.appui ? 2px : 0px;
        height: parent.height - 3px;
        border-radius: 8px;
        border-width: 1px;
        border-color: root.kind == 0 ? Theme.glass-border : root.fond.brighter(0.2);
        background: root.appui ? root.fond.darker(0.08) : root.survol ? root.fond.brighter(0.1) : root.fond;
        animate y { duration: 110ms; easing: ease-out; }
        animate background { duration: Theme.fast; }

        contenu := HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 8px;
            alignment: center;
            if root.icon != "": Icon {
                text: root.icon;
                font-size: 12px;
                color: root.encre;
                transform-rotation: root.icon-spin ? (animation-tick() / 900ms) * 360deg : 0deg;
            }
            Text {
                text: root.text;
                font-family: Theme.ui-font;
                font-size: 13px;
                font-weight: 600;
                color: root.encre;
                vertical-alignment: center;
            }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Bouton carré avec une icône (et une bulle d'aide au survol).
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> tooltip;
    in property <bool> enabled: true;
    in property <color> fond: Theme.glass-strong;
    in property <color> encre: Theme.navy;
    in property <color> bord: Theme.glass-border;
    in property <length> icon-size: 15px;
    callback clicked;

    width: 40px;
    height: 40px;
    border-radius: 8px;
    border-width: 1px;
    border-color: touch.has-hover && root.enabled ? Theme.accent : root.bord;
    background: touch.pressed ? root.fond.darker(0.1) : touch.has-hover && root.enabled ? root.fond.brighter(0.15) : root.fond;
    opacity: root.enabled ? 1 : 0.5;
    transform-scale: touch.pressed && root.enabled ? 0.9 : 1;
    animate background, border-color { duration: Theme.fast; }
    animate transform-scale { duration: 140ms; easing: ease-out; }

    Icon {
        text: root.icon;
        font-size: root.icon-size;
        color: root.encre;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            Bulle.visible = false;
            root.clicked();
        }
    }

    // Bulle d'aide : affichée par la fenêtre, sous le bouton
    property <bool> survol: touch.has-hover && root.tooltip != "";
    changed survol => {
        if (self.survol) {
            Bulle.texte = root.tooltip;
            Bulle.x = root.absolute-position.x + root.width / 2;
            Bulle.y = root.absolute-position.y + root.height + 6px;
            Bulle.a-droite = false;
            Bulle.visible = true;
        } else if (Bulle.texte == root.tooltip) {
            Bulle.visible = false;
        }
    }
}

/// Bouton de la barre de titre (réduire / agrandir / fermer).
export component ChromeButton inherits Rectangle {
    in property <string> icon;
    in property <bool> close: false;
    in property <color> encre: Theme.navy;
    callback clicked;
    width: 46px;
    height: 34px;
    border-radius: 10px;
    background: touch.has-hover ? (root.close ? Theme.danger : Theme.glass-hover) : transparent;
    transform-scale: touch.pressed ? 0.9 : 1;
    animate background { duration: Theme.fast; }
    animate transform-scale { duration: 120ms; easing: ease-out; }
    Icon {
        text: root.icon;
        font-size: 10px;
        color: touch.has-hover && root.close ? white : root.encre;
        animate color { duration: Theme.fast; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Le gros bouton vert « JOUER ».
export component PlayButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> font-size: 30px;
    /// Icône au-dessus du texte (bouton Logs, à côté de Jouer)
    in property <string> icon;
    in property <length> icon-size: 24px;
    callback clicked;

    border-radius: 10px;
    background: root.enabled ? #2C4F9E : #3E526A;
    opacity: root.enabled ? 1 : 0.7;

    face := Rectangle {
        y: touch.pressed && root.enabled ? 3px : 0px;
        height: parent.height - 6px;
        border-radius: 10px;
        background: !root.enabled ? @linear-gradient(180deg, #8B9BB0 0%, #6B7C93 100%)
            : touch.has-hover ? @linear-gradient(180deg, #C4DAFF 0%, #8AAEFF 100%)
            : @linear-gradient(180deg, #B4CFFF 0%, #6F9CFF 100%);
        border-width: 2px;
        border-color: #FFFFFF55;
        animate y { duration: 80ms; }
        if root.icon == "": Text {
            text: root.text;
            font-family: Theme.pixel-font;
            font-size: root.font-size;
            color: white;
            stroke: root.enabled ? #2C4F9E : #3E526A;
            stroke-width: 2px;
            stroke-style: outside;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.icon != "": VerticalLayout {
            alignment: center;
            spacing: 6px;
            Text {
                text: root.icon;
                font-family: Theme.icon-font;
                font-size: root.icon-size;
                color: white;
                stroke: root.enabled ? #2C4F9E : #3E526A;
                stroke-width: 1.5px;
                stroke-style: outside;
                horizontal-alignment: center;
            }
            if root.text != "": Text {
                text: root.text;
                font-family: Theme.pixel-font;
                font-size: root.font-size;
                color: white;
                stroke: root.enabled ? #2C4F9E : #3E526A;
                stroke-width: 2px;
                stroke-style: outside;
                horizontal-alignment: center;
            }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Onglet en forme de pilule.
export component TabPill inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> has-dot;
    in property <color> dot;
    callback clicked;

    height: 36px;
    min-width: contenu.preferred-width;
    horizontal-stretch: 0;
    border-radius: 18px;
    border-width: 1.5px;
    border-color: root.checked ? Theme.fill : touch.has-hover && root.enabled ? Theme.accent : Theme.glass-border;
    background: root.checked ? Theme.fill : touch.has-hover && root.enabled ? Theme.glass-hover : Theme.glass;
    opacity: root.enabled ? 1 : 0.45;
    transform-scale: touch.pressed && root.enabled ? 0.95 : 1;
    animate background, border-color { duration: Theme.normal; easing: ease-out; }
    animate transform-scale { duration: 140ms; easing: ease-out; }

    contenu := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;
        if root.has-dot: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 9px;
                height: 9px;
                border-radius: 4.5px;
                background: root.dot;
            }
        }
        if root.icon != "": Icon {
            text: root.icon;
            font-size: 13px;
            color: root.checked ? Theme.on-fill : Theme.navy;
        }
        Text {
            text: root.text;
            font-family: Theme.ui-font;
            font-size: 13px;
            font-weight: 600;
            color: root.checked ? Theme.on-fill : Theme.navy;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ───────────────────────── Saisie ─────────────────────────

/// Champ de texte en verre (avec loupe pour les recherches).
export component GlassInput inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> search: false;
    in property <bool> enabled: true;
    in property <TextHorizontalAlignment> align: left;
    in property <length> font-size: 13px;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted(string);

    height: 42px;
    border-radius: 8px;
    background: input.has-focus ? Theme.glass-hover : Theme.glass-strong;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.accent : Theme.glass-border;
    animate background { duration: Theme.normal; }
    opacity: root.enabled ? 1 : 0.6;
    animate border-color { duration: Theme.normal; }

    public function focus-input() {
        input.focus();
    }
    public function select-all() {
        input.select-all();
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        if root.search: Icon {
            text: "\u{E721}";
            font-size: 13px;
            color: Theme.text-muted;
            width: 16px;
        }
        Rectangle {
            input := TextInput {
                width: parent.width;
                height: parent.height;
                enabled: root.enabled;
                single-line: true;
                vertical-alignment: center;
                horizontal-alignment: root.align;
                font-family: Theme.ui-font;
                font-size: root.font-size;
                color: Theme.text;
                selection-background-color: Theme.blue;
                selection-foreground-color: white;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
            Text {
                width: parent.width;
                height: parent.height;
                text: root.placeholder;
                visible: input.text == "";
                vertical-alignment: center;
                horizontal-alignment: root.align;
                font-family: Theme.ui-font;
                font-size: root.font-size;
                color: Theme.text-muted;
                overflow: elide;
            }
        }
    }
}

/// Liste déroulante en verre.
export component GlassCombo inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: -1;
    in property <bool> enabled: true;
    callback selected(int);

    height: 44px;
    border-radius: 12px;
    border-width: 1.5px;
    border-color: Theme.glass-border;
    background: touch.has-hover && root.enabled ? Theme.glass-hover : Theme.glass-strong;
    opacity: root.enabled ? 1 : 0.55;
    animate background { duration: Theme.fast; }

    Text {
        x: 14px;
        width: parent.width - 44px;
        text: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
        font-family: Theme.ui-font;
        font-size: 13px;
        font-weight: 600;
        color: Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }
    Icon {
        x: parent.width - 30px;
        width: 18px;
        text: "\u{E70D}";
        font-size: 10px;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    property <length> hauteur-liste: min(320px, root.model.length * 36px + 12px);
    // pas la place en dessous du bouton : la liste s'ouvre au-dessus
    property <bool> vers-le-haut: root.absolute-position.y + root.height + 4px + self.hauteur-liste > Bulle.fenetre-hauteur - 8px && root.absolute-position.y > self.hauteur-liste + 8px;
    popup := PopupWindow {
        x: 0;
        y: root.vers-le-haut ? -self.height - 4px : root.height + 4px;
        width: root.width;
        height: root.hauteur-liste;
        Rectangle {
            background: Theme.popup;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.glass-border;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow;
            drop-shadow-offset-y: 4px;
            ListView {
                x: 6px;
                y: 6px;
                width: parent.width - 12px;
                height: parent.height - 12px;
                // le contenu est recréé à chaque ouverture : on recentre la liste sur l'élément choisi
                init => {
                    if root.current-index >= 0 {
                        self.content-y = -max(0px, min(root.current-index * 36px - (self.height - 36px) / 2, root.model.length * 36px - self.height));
                    }
                }
                for item[i] in root.model: Rectangle {
                    height: 36px;
                    border-radius: 8px;
                    background: ligne.has-hover ? Theme.popup-hover : i == root.current-index ? Theme.accent-soft : transparent;
                    animate background { duration: Theme.fast; }
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        text: item;
                        font-family: Theme.ui-font;
                        font-size: 13px;
                        font-weight: i == root.current-index ? 700 : 500;
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    ligne := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-index = i;
                            root.selected(i);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

/// Interrupteur (case à cocher en forme de bascule), avec un texte ou un contenu à droite.
export component ToggleSwitch inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    in property <bool> enabled: true;
    /// false : l'état est piloté de l'extérieur (le clic demande seulement le changement)
    in property <bool> auto: true;
    callback toggled(bool);

    min-height: 26px;
    opacity: root.enabled ? 1 : 0.45;

    HorizontalLayout {
        spacing: 12px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 46px;
                height: 26px;
                border-radius: 13px;
                background: root.checked ? @linear-gradient(90deg, Theme.toggle-on.brighter(0.15) 0%, Theme.toggle-on 100%) : Theme.toggle-off;
                border-width: 1px;
                border-color: root.checked ? Theme.toggle-on.darker(0.1) : Theme.glass-border;
                animate background, border-color { duration: 220ms; easing: ease-out; }
                // le bouton : grossit un peu au survol, glisse avec un léger rebond
                Rectangle {
                    property <length> d: zone.has-hover && root.enabled ? 22px : 20px;
                    x: root.checked ? parent.width - self.d - 3px : 3px;
                    y: (parent.height - self.d) / 2;
                    width: self.d;
                    height: self.d;
                    border-radius: self.d / 2;
                    background: white;
                    drop-shadow-blur: 4px;
                    drop-shadow-offset-y: 1px;
                    drop-shadow-color: #00000040;
                    animate x { duration: 260ms; easing: cubic-bezier(0.34, 1.4, 0.64, 1); }
                    animate d { duration: 140ms; easing: ease-out; }
                }
            }
        }
        if root.text != "": Text {
            text: root.text;
            font-family: Theme.ui-font;
            font-size: 13px;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }
        @children
    }
    zone := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            if (root.auto) {
                root.checked = !root.checked;
                root.toggled(root.checked);
            } else {
                root.toggled(!root.checked);
            }
        }
    }
}

/// Curseur en verre.
export component GlassSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in-out property <float> value;
    in property <float> step: 1;
    in property <color> fill: Theme.toggle-on;
    in property <brush> track: Theme.track;
    callback changed(float);

    height: 26px;

    function regler(px: length) {
        if (root.maximum <= root.minimum) {
            return;
        }
        let ratio = clamp((px - 10px) / (root.width - 20px), 0, 1);
        let brut = root.minimum + ratio * (root.maximum - root.minimum);
        let v = clamp(round(brut / root.step) * root.step, root.minimum, root.maximum);
        if (v != root.value) {
            root.value = v;
            root.changed(v);
        }
    }

    property <float> ratio: root.maximum > root.minimum ? (root.value - root.minimum) / (root.maximum - root.minimum) : 0;
    property <bool> actif: zone.pressed || zone.has-hover;

    // piste, puis la partie remplie en dégradé
    Rectangle {
        y: (parent.height - 6px) / 2;
        height: 6px;
        border-radius: 3px;
        background: root.track;
    }
    Rectangle {
        x: 0;
        y: (parent.height - 6px) / 2;
        height: 6px;
        width: 10px + (root.width - 20px) * root.ratio;
        border-radius: 3px;
        background: @linear-gradient(90deg, root.fill.brighter(0.25) 0%, root.fill 100%);
    }
    // le bouton : cerclé de la couleur, grossit pendant qu'on le tire
    Rectangle {
        property <length> d: zone.pressed ? 22px : root.actif ? 20px : 18px;
        x: 10px + (root.width - 20px) * root.ratio - self.d / 2;
        y: (parent.height - self.d) / 2;
        width: self.d;
        height: self.d;
        border-radius: self.d / 2;
        background: white;
        border-width: 3px;
        border-color: root.fill;
        drop-shadow-blur: root.actif ? 8px : 3px;
        drop-shadow-color: root.fill.with-alpha(0.45);
        animate d, drop-shadow-blur { duration: 140ms; easing: ease-out; }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.regler(self.mouse-x);
            }
        }
        moved => {
            if (self.pressed) {
                root.regler(self.mouse-x);
            }
        }
    }
}

/// Barre de progression fine.
export component SlimProgress inherits Rectangle {
    in property <float> progress;
    height: 8px;
    border-radius: 4px;
    background: Theme.track;
    clip: true;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.progress, 0, 1);
        border-radius: 4px;
        background: @linear-gradient(90deg, #13B24C 0%, #3BEB7B 100%);
        animate width { duration: 250ms; easing: ease-out; }
    }
}

/// Icône qui tourne (chargement).
export component Spinner inherits Rectangle {
    min-height: 44px;
    Icon {
        text: "\u{E895}";
        font-size: 30px;
        color: Theme.green-dark;
        transform-rotation: (animation-tick() / 1200ms) * 360deg;
    }
}

/// Liste déroulante des langues (avec drapeaux).
export struct LangItem {
    name: string,
    /// Nom de la langue en anglais (« French »), affiché en gris
    english: string,
    flag: image,
}

export component LangCombo inherits Rectangle {
    in property <[LangItem]> model;
    in-out property <int> current-index: -1;
    callback selected(int);

    height: 44px;
    border-radius: 12px;
    border-width: 1.5px;
    border-color: Theme.glass-border;
    background: touch.has-hover ? Theme.glass-hover : Theme.glass-strong;
    animate background { duration: Theme.fast; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 36px;
        spacing: 10px;
        if root.current-index >= 0 && root.current-index < root.model.length: VerticalLayout {
            alignment: center;
            Image {
                width: 24px;
                height: 16px;
                source: root.model[root.current-index].flag;
                image-fit: cover;
            }
        }
        Text {
            text: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index].name : "";
            font-family: Theme.ui-font;
            font-size: 13px;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    Icon {
        x: parent.width - 30px;
        width: 18px;
        text: "\u{E70D}";
        font-size: 10px;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    property <length> hauteur-liste: root.model.length * 40px + 12px;
    property <bool> vers-le-haut: root.absolute-position.y + root.height + 4px + self.hauteur-liste > Bulle.fenetre-hauteur - 8px && root.absolute-position.y > self.hauteur-liste + 8px;
    popup := PopupWindow {
        x: 0;
        y: root.vers-le-haut ? -self.height - 4px : root.height + 4px;
        width: root.width;
        height: root.hauteur-liste;
        Rectangle {
            background: Theme.popup;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.glass-border;
            drop-shadow-blur: 18px;
            drop-shadow-color: Theme.shadow;
            VerticalLayout {
                padding: 6px;
                for item[i] in root.model: Rectangle {
                    height: 40px;
                    border-radius: 8px;
                    background: ligne.has-hover ? Theme.popup-hover : i == root.current-index ? Theme.accent-soft : transparent;
                    animate background { duration: Theme.fast; }
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                width: 24px;
                                height: 16px;
                                source: item.flag;
                                image-fit: cover;
                            }
                        }
                        Text {
                            text: item.name;
                            font-family: Theme.ui-font;
                            font-size: 13px;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                    }
                    ligne := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-index = i;
                            root.selected(i);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

/// Rangée de filtres en pastilles (« TOUS », « FABRIC »…) : celui choisi est plein.
export component Puces inherits HorizontalLayout {
    in property <[string]> model;
    in property <int> current;
    callback selected(int);
    spacing: 6px;
    alignment: start;
    for t[i] in root.model: Rectangle {
        property <bool> actif: i == root.current;
        height: 30px;
        width: lab.preferred-width + 22px;
        border-radius: 6px;
        background: self.actif ? Theme.fill : zone.has-hover ? Theme.glass-hover : Theme.glass-strong;
        border-width: 1px;
        border-color: self.actif ? Theme.fill : Theme.glass-border;
        animate background { duration: Theme.fast; }
        lab := Text {
            text: t;
            font-family: Theme.ui-font;
            font-size: 11px;
            color: parent.actif ? Theme.on-fill : Theme.navy;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        zone := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.selected(i); }
        }
    }
}

/// Petite étiquette en police pixel (version, loader…) posée sur une carte.
export component Etiquette inherits Rectangle {
    in property <string> text;
    in property <color> couleur: Theme.accent;
    height: 22px;
    width: t.preferred-width + 14px;
    border-radius: 5px;
    background: root.couleur.with-alpha(0.16);
    t := Text {
        text: root.text;
        font-family: Theme.ui-font;
        font-size: 11px;
        color: root.couleur;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
