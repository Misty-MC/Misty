// Notes de version : les releases GitHub du launcher (voir src/ui/changelog.rs), en frise verticale.
// La version ouverte montre son image, son en-tête et ses notes (intertitres et lignes avec leur
// étiquette) ; les autres sont repliées en une ligne. Filtres : nouveautés, corrections, launcher, client.

import { Theme, Tr } from "theme.slint";
import { ChangelogState, ChangelogSection } from "state.slint";
import { Icon, PixelLabel, OutlinedText, GlassCard, MButton, IconButton, Puces } from "widgets.slint";
import { ListView, ScrollView } from "std-widgets.slint";

/// Petite étiquette pixel (DERNIÈRE, BÊTA, NOUVEAU, CORRIGÉ).
component Etiquette inherits Rectangle {
    in property <string> text;
    in property <color> couleur;
    /// true : fond plein ; false : fond léger et texte coloré
    in property <bool> plein: false;
    height: 20px;
    width: t.preferred-width + 14px;
    border-radius: 6px;
    background: root.plein ? root.couleur : root.couleur.with-alpha(Theme.dark ? 0.2 : 0.14);
    border-width: root.plein ? 0px : 1px;
    border-color: root.couleur.with-alpha(0.45);
    t := Text {
        text: root.text;
        font-family: Theme.pixel-font;
        font-size: 9.5px;
        color: root.plein ? white : root.couleur;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// Intertitre des notes (« Launcher », « Misty Client (in game) »).
component Intertitre inherits HorizontalLayout {
    in property <string> text;
    spacing: 10px;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 4px;
            height: 18px;
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    PixelLabel {
        text: root.text;
        font-size: 13px;
        color: Theme.accent;
        wrap: word-wrap;
    }
}

/// Une ligne des notes : étiquette (nouveau, corrigé) ou puce, puis le texte.
component LigneNote inherits Rectangle {
    in property <string> text;
    in property <int> genre;
    min-height: contenu.preferred-height;
    border-radius: 12px;
    background: survol.has-hover ? Theme.glass : transparent;
    animate background { duration: Theme.fast; }
    survol := TouchArea { }
    contenu := HorizontalLayout {
        padding: 8px;
        padding-left: 10px;
        padding-right: 12px;
        spacing: 12px;
        // colonne des étiquettes, de la même largeur partout pour aligner les textes
        Rectangle {
            width: 58px;
            if root.genre == 1: Etiquette { x: 0; y: 0; text: Tr.t("Notes_Nouveau"); couleur: Theme.green-dark; }
            if root.genre == 2: Etiquette { x: 0; y: 0; text: Tr.t("Notes_Corrige"); couleur: #E8932F; }
            if root.genre == 0: Rectangle {
                x: 22px;
                y: 7px;
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.text-dim;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-family: Theme.ui-font;
            font-size: 13.5px;
            color: Theme.navy2;
            wrap: word-wrap;
        }
    }
}

/// Une ligne est-elle gardée par le filtre ? (genre : -1 intertitre, 0 simple, 1 nouveau, 2 corrigé ;
/// partie : 0 launcher, 1 Misty Client)
global Filtre {
    pure public function garde(filtre: int, genre: int, partie: int) -> bool {
        if (filtre == 0) { return true; }
        if (filtre == 1) { return genre == 1; }
        if (filtre == 2) { return genre == 2; }
        if (filtre == 3) { return partie == 0; }
        return partie == 1;
    }
}

/// Une version dans la frise : repliée (une ligne) ou ouverte (image, en-tête et notes).
component Version inherits HorizontalLayout {
    in property <ChangelogSection> s;
    in property <int> numero;
    in property <bool> derniere;
    property <bool> ouverte: ChangelogState.selected == root.numero;
    property <int> filtre: ChangelogState.filter;
    property <int> gardees: 0;
    spacing: 14px;

    // la frise : un trait continu et un carré par version
    Rectangle {
        width: 22px;
        Rectangle {
            x: 10px;
            y: 0;
            width: 2px;
            height: root.derniere ? 26px : parent.height;
            background: Theme.glass-border;
        }
        Rectangle {
            x: 4px;
            y: 20px;
            width: 14px;
            height: 14px;
            border-radius: 3px;
            background: root.ouverte ? Theme.fill : root.s.recent ? Theme.green-dark : Theme.panel-strong;
            border-width: 2px;
            border-color: root.ouverte ? Theme.on-fill : Theme.glass-border;
            animate background { duration: Theme.normal; }
        }
    }

    VerticalLayout {
        horizontal-stretch: 1;
        padding-bottom: 10px;

        // ── repliée ──
        if !root.ouverte: Rectangle {
            height: 56px;
            border-radius: 10px;
            background: zone.has-hover ? Theme.panel-strong : Theme.panel;
            border-width: 1px;
            border-color: zone.has-hover ? Theme.accent.with-alpha(0.5) : Theme.glass-border;
            animate background, border-color { duration: Theme.fast; }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 14px;
                spacing: 12px;
                PixelLabel {
                    text: root.s.title;
                    font-size: 13px;
                    color: Theme.navy;
                }
                if root.s.prerelease: VerticalLayout {
                    alignment: center;
                    Etiquette { text: Tr.t("Notes_Beta"); couleur: #E8932F; }
                }
                Text {
                    text: root.s.date;
                    font-size: 12px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.s.summary;
                    font-size: 12.5px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.s.news > 0: VerticalLayout {
                    alignment: center;
                    Etiquette { text: Tr.t("Notes_Nouveau") + " · " + root.s.news; couleur: Theme.green-dark; }
                }
                if root.s.fixes > 0: VerticalLayout {
                    alignment: center;
                    Etiquette { text: Tr.t("Notes_Corrige") + " · " + root.s.fixes; couleur: #E8932F; }
                }
                Icon {
                    text: "\u{E70D}";
                    font-size: 10px;
                    color: Theme.text-muted;
                }
            }
            zone := TouchArea {
                mouse-cursor: pointer;
                clicked => { ChangelogState.selected = root.numero; }
            }
        }

        // ── ouverte ──
        if root.ouverte: Rectangle {
            border-radius: 12px;
            background: Theme.panel-strong;
            border-width: 1px;
            border-color: Theme.glass-border;
            drop-shadow-blur: 20px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: Theme.shadow;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 18px;
                    Rectangle {
                        width: 220px;
                        height: 124px;
                        border-radius: 8px;
                        clip: true;
                        background: #1C2335;
                        Image {
                            width: parent.width;
                            height: parent.height;
                            source: root.s.art;
                            image-fit: cover;
                            image-rendering: ImageRendering.pixelated;
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            PixelLabel {
                                text: root.s.title;
                                font-size: 22px;
                                color: Theme.navy;
                            }
                            if root.s.recent: VerticalLayout {
                                alignment: center;
                                Etiquette { text: Tr.t("Notes_Derniere"); couleur: Theme.green-dark; plein: true; }
                            }
                            if root.s.prerelease: VerticalLayout {
                                alignment: center;
                                Etiquette { text: Tr.t("Notes_Beta"); couleur: #E8932F; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            if root.s.date != "": Text {
                                text: root.s.date;
                                font-size: 13px;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                            }
                            if root.s.news > 0: Etiquette { text: Tr.t("Notes_Nouveau") + " · " + root.s.news; couleur: Theme.green-dark; }
                            if root.s.fixes > 0: Etiquette { text: Tr.t("Notes_Corrige") + " · " + root.s.fixes; couleur: #E8932F; }
                        }
                        if root.s.url != "": HorizontalLayout {
                            alignment: start;
                            padding-top: 4px;
                            MButton {
                                icon: "\u{E8A7}";
                                text: Tr.t("Notes_GitHub");
                                clicked => { ChangelogState.open-url(root.s.url); }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: start;
                        IconButton {
                            width: 32px;
                            height: 32px;
                            icon: "\u{E70E}";
                            clicked => { ChangelogState.selected = -1; }
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.line;
                }
                VerticalLayout {
                    spacing: 2px;
                    for ligne[i] in root.s.lines: VerticalLayout {
                        if root.s.kinds[i] == -1 && (root.filtre == 0 || (root.filtre >= 3 && Filtre.garde(root.filtre, -1, root.s.parts[i]))): VerticalLayout {
                            padding-left: 10px;
                            padding-top: i > 0 ? 14px : 4px;
                            padding-bottom: 4px;
                            Intertitre { text: ligne; }
                        }
                        if root.s.kinds[i] != -1 && Filtre.garde(root.filtre, root.s.kinds[i], root.s.parts[i]): LigneNote {
                            text: ligne;
                            genre: root.s.kinds[i];
                        }
                    }
                    if (root.filtre == 1 && root.s.news == 0) || (root.filtre == 2 && root.s.fixes == 0): Text {
                        text: Tr.t("Notes_Rien");
                        font-size: 13px;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}

export component ChangelogPage inherits Rectangle {
    VerticalLayout {
        padding-left: 26px;
        padding-right: 30px;
        padding-bottom: 26px;
        spacing: 16px;

        HorizontalLayout {
            padding-left: 6px;
            spacing: 16px;
            OutlinedText {
                text: Tr.t("Notes_Titre");
                font-size: 48px;
                depth: 5px;
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                Puces {
                    model: [Tr.t("Notes_Filtre_Tout"), Tr.t("Notes_Filtre_Nouveau"), Tr.t("Notes_Filtre_Corrige"), Tr.t("Notes_Filtre_Launcher"), Tr.t("Notes_Filtre_Client")];
                    current: ChangelogState.filter;
                    selected(i) => { ChangelogState.filter = i; }
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            content-height: frise.preferred-height;
            frise := VerticalLayout {
                width: parent.visible-width;
                padding-right: 14px;
                alignment: start;
                for v[i] in ChangelogState.sections: Version {
                    s: v;
                    numero: i;
                    derniere: i == ChangelogState.sections.length - 1;
                }
            }
        }
    }
}
