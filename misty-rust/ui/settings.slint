// Options : comptes hors-ligne, compte Microsoft, RAM, raccourci, types de versions, stockage, langue.

import { Theme, Tr } from "theme.slint";
import { SettingsState, StorageRow } from "state.slint";
import { Icon, PixelLabel, BodyText, SectionTitle, OutlinedText, GlassCard, IconButton, MButton, GlassInput, ToggleSwitch, GlassSlider, LangCombo, ChromeButton } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

component Carte inherits GlassCard {
    min-height: contenu.preferred-height;
    contenu := VerticalLayout {
        padding: 22px;
        spacing: 4px;
        @children
    }
}

component Pseudo inherits Rectangle {
    in property <string> text;
    callback remove();
    height: 38px;
    width: t.preferred-width + 54px;
    border-radius: 12px;
    background: Theme.glass-strong;
    border-width: 1.5px;
    border-color: Theme.glass-border;
    t := Text {
        x: 12px;
        text: root.text;
        font-family: Theme.ui-font;
        font-weight: 600;
        font-size: 13px;
        color: Theme.navy;
        vertical-alignment: center;
    }
    ChromeButton {
        x: parent.width - 32px;
        y: 5px;
        width: 28px;
        height: 28px;
        icon: "\u{E8BB}";
        close: true;
        clicked => { root.remove(); }
    }
}

/// Ligne d'un compte Microsoft : pseudo, « utiliser » si ce n'est pas le compte actif, oublier.
component LigneCompte inherits Rectangle {
    in property <string> pseudo;
    in property <bool> active;
    callback use();
    callback forget();
    height: 44px;
    border-radius: 12px;
    background: root.active ? Theme.navy : Theme.glass-strong;
    border-width: 1.5px;
    border-color: root.active ? Theme.navy : Theme.glass-border;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 10px;
        if root.active: Icon {
            text: "\u{E73E}";
            color: Theme.green;
            font-size: 13px;
        }
        Text {
            horizontal-stretch: 1;
            text: root.pseudo;
            font-family: Theme.ui-font;
            font-weight: 600;
            font-size: 13px;
            color: root.active ? white : Theme.navy;
            vertical-alignment: center;
            overflow: elide;
        }
        if !root.active: VerticalLayout {
            alignment: center;
            MButton {
                text: Tr.t("Compte_Utiliser");
                clicked => { root.use(); }
            }
        }
        VerticalLayout {
            alignment: center;
            ChromeButton {
                width: 28px;
                height: 28px;
                icon: "\u{E8BB}";
                close: true;
                encre: root.active ? white : Theme.navy;
                clicked => { root.forget(); }
            }
        }
    }
}

export component SettingsPage inherits Rectangle {
    VerticalLayout {
        padding-left: 26px;
        padding-right: 30px;
        padding-bottom: 26px;
        spacing: 18px;

        HorizontalLayout {
            padding-left: 6px;
            alignment: start;
            OutlinedText {
                text: Tr.t("Options_Title");
                font-size: 48px;
                depth: 5px;
            }
        }

        ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            content-height: colonnes.preferred-height;

            colonnes := HorizontalLayout {
                width: parent.visible-width - 12px;
                spacing: 18px;
                alignment: stretch;

                // ═══ Colonne gauche ═══
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: start;
                    spacing: 18px;

                    // Comptes hors-ligne
                    Carte {
                        SectionTitle { text: Tr.t("Options_hors_ligne"); }
                        BodyText { text: Tr.t("Options_hors_ligne_text"); }
                        Rectangle { height: 10px; }
                        // Liste des pseudos, découpée en lignes par Rust
                        for ligne in SettingsState.pseudo-rows: HorizontalLayout {
                            spacing: 8px;
                            padding-bottom: 8px;
                            alignment: start;
                            for p in ligne.items: Pseudo {
                                text: p;
                                remove => { SettingsState.remove-pseudo(p); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            GlassInput {
                                horizontal-stretch: 1;
                                text <=> SettingsState.new-pseudo;
                                accepted => { SettingsState.add-pseudo(); }
                            }
                            MButton {
                                kind: 1;
                                icon: "\u{E710}";
                                text: Tr.t("Options_bouton_ajout");
                                clicked => { SettingsState.add-pseudo(); }
                            }
                        }
                    }

                    // Compte Microsoft
                    Carte {
                        SectionTitle { text: Tr.t("Options_Compte_Microsoft"); }
                        BodyText { text: SettingsState.ms-state; }
                        Rectangle { height: 10px; }
                        for c in SettingsState.ms-accounts: VerticalLayout {
                            padding-bottom: 8px;
                            LigneCompte {
                                pseudo: c.pseudo;
                                active: c.active && SettingsState.ms-connected;
                                use => { SettingsState.ms-switch(c.uuid); }
                                forget => { SettingsState.ms-forget(c.uuid); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            MButton {
                                kind: 1;
                                icon: "\u{E710}";
                                text: SettingsState.ms-accounts.length == 0 ? Tr.t("Compte_SeConnecter") : Tr.t("Compte_Ajouter");
                                enabled: !SettingsState.ms-busy;
                                clicked => { SettingsState.connect(); }
                            }
                            if SettingsState.ms-connected: MButton {
                                text: Tr.t("Compte_SeDeconnecter");
                                clicked => { SettingsState.disconnect(); }
                            }
                            MButton {
                                text: Tr.t("Compte_DeconnexionTotale");
                                clicked => { SettingsState.disconnect-all(); }
                            }
                        }
                    }

                    // Raccourci
                    Carte {
                        ToggleSwitch {
                            checked <=> SettingsState.shortcut-enabled;
                            toggled(v) => { SettingsState.shortcut-toggled(v); }
                            VerticalLayout {
                                spacing: 2px;
                                SectionTitle { text: Tr.t("Options_Raccourci"); }
                                BodyText { text: Tr.t("Options_Raccourci_Texte"); }
                            }
                        }
                        if SettingsState.shortcut-enabled: VerticalLayout {
                            padding-top: 14px;
                            spacing: 10px;
                            Rectangle {
                                height: 34px;
                                border-radius: 10px;
                                background: #FFFFFF40;
                                Text {
                                    x: 12px;
                                    width: parent.width - 24px;
                                    text: SettingsState.shortcut-path;
                                    font-family: Theme.ui-font;
                                    font-size: 13px;
                                    color: Theme.navy2;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                alignment: start;
                                MButton {
                                    text: Tr.t("Options_ChoisirDossier");
                                    clicked => { SettingsState.choose-shortcut(); }
                                }
                                MButton {
                                    text: Tr.t("Options_Recreer");
                                    clicked => { SettingsState.recreate-shortcut(); }
                                }
                            }
                        }
                    }

                    // Langue
                    Carte {
                        SectionTitle { text: Tr.t("Options_Langue"); }
                        BodyText { text: Tr.t("Options_Langue_Texte"); }
                        Rectangle { height: 8px; }
                        LangCombo {
                            model: SettingsState.langs;
                            current-index <=> SettingsState.lang-index;
                            selected(i) => { SettingsState.lang-selected(i); }
                        }
                    }
                }

                // ═══ Colonne droite ═══
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: start;
                    spacing: 18px;

                    // Mémoire
                    Carte {
                        HorizontalLayout {
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                SectionTitle { text: Tr.t("Options_Ram"); }
                                BodyText { text: SettingsState.ram-total-text; }
                            }
                            VerticalLayout {
                                alignment: start;
                                Rectangle {
                                    border-radius: 10px;
                                    background: Theme.navy;
                                    width: ram.preferred-width + 24px;
                                    height: 32px;
                                    ram := PixelLabel {
                                        text: SettingsState.ram-text;
                                        color: white;
                                        font-size: 14px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                        Rectangle { height: 12px; }
                        GlassSlider {
                            minimum: 1024;
                            maximum: SettingsState.ram-max;
                            step: 1024;
                            value <=> SettingsState.ram-value;
                            changed(v) => { SettingsState.ram-changed(v); }
                        }
                    }

                    // Versions
                    Carte {
                        SectionTitle { text: Tr.t("Options_Versions"); }
                        BodyText { text: Tr.t("Options_Versions_Texte"); }
                        Rectangle { height: 8px; }
                        ToggleSwitch {
                            text: "Snapshots";
                            checked <=> SettingsState.snapshot;
                            toggled => { SettingsState.types-changed(); }
                        }
                        Rectangle { height: 4px; }
                        ToggleSwitch {
                            text: Tr.t("Options_Betas");
                            checked <=> SettingsState.beta;
                            toggled => { SettingsState.types-changed(); }
                        }
                        Rectangle { height: 4px; }
                        ToggleSwitch {
                            text: Tr.t("Options_indev");
                            checked <=> SettingsState.alpha;
                            toggled => { SettingsState.types-changed(); }
                        }
                    }

                    // Stockage
                    Carte {
                        SectionTitle { text: Tr.t("Options_Stockage"); }
                        Text {
                            text: SettingsState.data-dir;
                            font-family: Theme.ui-font;
                            font-size: 13px;
                            color: Theme.text-muted;
                            overflow: elide;
                        }
                        PixelLabel {
                            text: SettingsState.size-text;
                            font-size: 14px;
                            color: Theme.navy;
                            height: 44px;
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            MButton {
                                text: Tr.t("Commun_OuvrirDossier");
                                clicked => { SettingsState.open-folder(); }
                            }
                            MButton {
                                kind: 1;
                                text: Tr.t("Stock_Gerer");
                                clicked => { SettingsState.storage-show(); }
                            }
                            MButton {
                                kind: 2;
                                text: Tr.t("Options_ToutSupprimer");
                                clicked => { SettingsState.delete-all(); }
                            }
                        }
                    }

                    // Rich Presence Discord
                    Carte {
                        ToggleSwitch {
                            checked <=> SettingsState.rich;
                            toggled(v) => { SettingsState.rich-toggled(v); }
                            VerticalLayout {
                                spacing: 2px;
                                SectionTitle { text: "RICH PRESENCE DISCORD"; }
                                BodyText { text: Tr.t("Options_Discord_Texte"); }
                            }
                        }
                    }

                    // À propos
                    Carte {
                        HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                SectionTitle { text: Tr.t("Options_APropos"); }
                                BodyText { text: SettingsState.about-text; }
                            }
                            VerticalLayout {
                                alignment: center;
                                MButton {
                                    icon: "\u{E895}";
                                    text: Tr.t("Maj_Rechercher");
                                    icon-spin: SettingsState.checking-update;
                                    clicked => { SettingsState.check-update(); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                MButton {
                                    text: "GitHub";
                                    clicked => { SettingsState.github(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

component LigneStockage inherits Rectangle {
    in property <StorageRow> r;
    height: r.niveau == 0 ? 62px : 46px;
    border-radius: 12px;
    background: r.niveau == 0 ? #FFFFFF99 : #FFFFFF55;
    border-width: 1px;
    border-color: r.reste ? #FF5A6E88 : #FFFFFFB3;

    // barre de proportion (poids relatif dans le dossier de données)
    if r.niveau == 0 && !r.locked: Rectangle {
        x: 14px;
        y: parent.height - 9px;
        height: 3px;
        width: max(4px, (parent.width - 28px) * r.fraction);
        border-radius: 2px;
        background: Theme.steel;
    }

    TouchArea {
        enabled: r.expandable;
        clicked => { SettingsState.storage-toggle(r.cle); }
    }
    HorizontalLayout {
        padding-left: r.niveau == 0 ? 14px : 40px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: r.niveau == 0 ? 12px : 6px;
        spacing: 10px;
        Icon {
            width: 16px;
            text: r.locked ? "\u{E72E}" : r.expandable ? (r.expanded ? "\u{E70D}" : "\u{E76C}") : "";
            font-size: 12px;
            color: Theme.text-muted;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: r.nom;
                font-family: Theme.ui-font;
                font-size: r.niveau == 0 ? 14px : 13px;
                font-weight: r.niveau == 0 ? 700 : 500;
                color: Theme.text;
                overflow: elide;
            }
            if r.info != "": Text {
                text: r.info;
                font-family: Theme.ui-font;
                font-size: 11px;
                color: r.reste ? Theme.danger : Theme.text-muted;
                overflow: elide;
            }
        }
        Text {
            text: r.size-text;
            font-family: Theme.ui-font;
            font-size: 13px;
            font-weight: 600;
            color: Theme.navy;
            vertical-alignment: center;
        }
        if !r.locked: IconButton {
            icon: "\u{E74D}";
            tooltip: Tr.t("Stock_Supprimer");
            width: 34px;
            height: 34px;
            y: (parent.height - self.height) / 2;
            clicked => { SettingsState.storage-delete(r.cle); }
        }
        if r.locked: Rectangle { width: 34px; }
    }
}

/// Fenêtre modale : couvre toute la fenêtre de l'application (posée par main.slint).
export component StorageOverlay inherits Rectangle {
    background: @linear-gradient(180deg, #14203A73 0%, #14203AA6 100%);
    TouchArea {
        clicked => { SettingsState.storage-close(); }
    }
    Rectangle {
        width: min(640px, parent.width - 40px);
        height: min(620px, parent.height - 40px);
        border-radius: 24px;
        background: #F6FAFFF2;
        border-width: 2px;
        border-color: white;
        drop-shadow-blur: 30px;
        drop-shadow-color: #1C233560;
        TouchArea { }
        VerticalLayout {
            padding: 24px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                SectionTitle {
                    text: Tr.t("Stock_Titre");
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                PixelLabel {
                    text: SettingsState.storage-total;
                    font-size: 13px;
                    color: Theme.navy;
                    vertical-alignment: center;
                }
            }
            BodyText { text: Tr.t("Stock_Intro"); wrap: word-wrap; }
            if SettingsState.storage-busy: Rectangle {
                vertical-stretch: 1;
                Text {
                    text: Tr.t("Options_Calcul");
                    font-family: Theme.pixel-font;
                    font-size: 13px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            if !SettingsState.storage-busy: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 6px;
                    for r in SettingsState.storage-rows: LigneStockage { r: r; }
                }
            }
            HorizontalLayout {
                alignment: end;
                MButton {
                    text: Tr.t("Commun_Fermer");
                    clicked => { SettingsState.storage-close(); }
                }
            }
        }
    }
}
