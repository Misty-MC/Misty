// Liste des profils, création d'un profil, installation d'un modpack.

import { Theme, Tr, Assets } from "theme.slint";
import { ProfilesState, ProfileCard } from "state.slint";
import { Icon, PixelLabel, BodyText, SectionTitle, OutlinedText, GlassCard, Thumb, IconButton, MButton, GlassInput, GlassCombo, Spinner, Puces, Etiquette, TuilePage, EnTetePage } from "widgets.slint";
import { ContentBrowser } from "browser.slint";
import { ScrollView } from "std-widgets.slint";

/// Carte d'un profil : l'illustration de sa version (ou son icône) en haut, puis le nom, la version
/// et le loader, la dernière partie. Au survol : Jouer, Gérer et Supprimer sur l'image.
component ProfileCardView inherits Rectangle {
    in property <ProfileCard> carte;
    callback open();
    callback play();
    callback delete();
    property <bool> survol: touch.has-hover;

    width: 236px;
    height: 236px;
    border-radius: 8px;
    clip: true;
    background: root.survol ? Theme.panel-strong : Theme.panel;
    border-width: 1px;
    border-color: root.survol ? Theme.accent.with-alpha(0.6) : Theme.glass-border;
    animate background, border-color { duration: Theme.normal; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open(); }
    }
    // en-tête : l'illustration, et l'icône du profil par-dessus s'il en a une
    Rectangle {
        y: 0;
        height: root.height * 0.52;
        clip: true;
        background: #1C2335;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.carte.art;
            image-fit: cover;
            image-rendering: ImageRendering.pixelated;
            // léger zoom au survol
            transform-scale: root.survol ? 1.06 : 1;
            animate transform-scale { duration: 400ms; easing: ease-out; }
        }
        if root.carte.has-icon: Thumb {
            x: 12px;
            y: parent.height - self.height - 10px;
            width: 52px;
            height: 52px;
            radius: 8px;
            border: 2px;
            source: root.carte.icon;
            has-image: true;
        }
        // actions au survol
        HorizontalLayout {
            x: parent.width - self.preferred-width - 10px;
            y: 10px;
            height: 36px;
            spacing: 6px;
            opacity: root.survol ? 1 : 0;
            animate opacity { duration: Theme.normal; }
            IconButton {
                width: 36px;
                height: 36px;
                icon: "\u{E74D}";
                fond: Theme.danger;
                encre: white;
                bord: #FFFFFF66;
                tooltip: Tr.t("Commun_Supprimer");
                clicked => { root.delete(); }
            }
            IconButton {
                width: 36px;
                height: 36px;
                icon: "\u{E70F}";
                tooltip: Tr.t("Profil_Gerer");
                clicked => { root.open(); }
            }
        }
        // jouer : gros bouton rond au centre de l'image
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 54px;
            height: 54px;
            border-radius: 10px;
            background: zone-jouer.has-hover ? Theme.green : Theme.green-dark;
            border-width: 2px;
            border-color: #FFFFFF80;
            opacity: root.survol ? 1 : 0;
            transform-scale: root.survol ? 1 : 0.8;
            animate opacity, transform-scale { duration: Theme.normal; easing: ease-out; }
            Icon {
                text: "\u{E768}";
                font-size: 20px;
                color: white;
            }
            zone-jouer := TouchArea {
                enabled: root.survol;
                mouse-cursor: pointer;
                clicked => { root.play(); }
            }
        }
    }
    VerticalLayout {
        y: root.height * 0.52;
        height: parent.height - root.height * 0.52;
        padding: 12px;
        padding-top: 10px;
        spacing: 7px;
        Text {
            text: root.carte.name;
            font-weight: 700;
            font-size: 15px;
            color: Theme.navy;
            overflow: elide;
        }
        HorizontalLayout {
            spacing: 5px;
            alignment: start;
            Etiquette { text: root.carte.version; }
            Etiquette { text: root.carte.loader; couleur: Theme.toggle-on; }
            if root.carte.modpack: Etiquette { text: "MODPACK"; couleur: #F0795A; }
        }
        Rectangle { vertical-stretch: 1; }
        Text {
            text: root.carte.last;
            font-size: 12px;
            color: Theme.text-muted;
            overflow: elide;
        }
    }
}

/// Dernière carte de la grille : créer un profil (bordure en pointillés simulée par un cadre clair).
component NouvelleCarte inherits Rectangle {
    callback clicked;
    width: 236px;
    height: 236px;
    border-radius: 8px;
    background: zone.has-hover ? Theme.glass : transparent;
    border-width: 2px;
    border-color: zone.has-hover ? Theme.accent : Theme.glass-border;
    animate background, border-color { duration: Theme.normal; }
    VerticalLayout {
        alignment: center;
        spacing: 8px;
        padding: 18px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 52px;
                height: 52px;
                border-radius: 10px;
                background: Theme.fill;
                Icon {
                    text: "\u{E710}";
                    font-size: 18px;
                    color: Theme.on-fill;
                }
            }
        }
        Text {
            text: Tr.t("Profil_NouveauCarte");
            font-size: 15px;
            font-weight: 700;
            color: Theme.navy;
            horizontal-alignment: center;
        }
        Text {
            text: Tr.t("Profil_NouveauCarte_Texte");
            font-size: 12px;
            color: Theme.text-muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Fenêtre modale : couvre toute la fenêtre de l'application (posée par main.slint).
export component ProfileCreateOverlay inherits Rectangle {

        background: Theme.scrim;
        TouchArea {
            clicked => { ProfilesState.cancel-create(); }
        }
        Rectangle {
            width: 460px;
            height: form.preferred-height;
            border-radius: 24px;
            background: Theme.surface;
            border-width: 2px;
            border-color: Theme.glass-border;
            drop-shadow-blur: 30px;
            drop-shadow-color: Theme.shadow;
            TouchArea { }
            form := VerticalLayout {
                padding-left: 28px;
                padding-right: 28px;
                padding-top: 26px;
                padding-bottom: 26px;
                spacing: 6px;
                SectionTitle {
                    text: Tr.t("Profil_NouveauTitre");
                    height: 36px;
                    vertical-alignment: top;
                }
                PixelLabel { text: Tr.t("Commun_Nom"); font-size: 10px; x: 4px; }
                nom := GlassInput {
                    text <=> ProfilesState.create-name;
                    init => { self.focus-input(); }
                }
                Rectangle { height: 8px; }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        spacing: 6px;
                        PixelLabel { text: Tr.t("Commun_Version"); font-size: 10px; x: 4px; }
                        GlassCombo {
                            model: ProfilesState.create-versions;
                            current-index <=> ProfilesState.create-version-index;
                            selected(i) => { ProfilesState.create-version-selected(i); }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        PixelLabel { text: Tr.t("Commun_ModLoader"); font-size: 10px; x: 4px; }
                        GlassCombo {
                            model: ProfilesState.create-loaders;
                            current-index <=> ProfilesState.create-loader-index;
                            enabled: ProfilesState.create-loader-enabled;
                        }
                    }
                }
                BodyText {
                    text: ProfilesState.create-info;
                    x: 2px;
                    min-height: 30px;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    padding-top: 12px;
                    MButton {
                        text: Tr.t("Commun_Annuler");
                        clicked => { ProfilesState.cancel-create(); }
                    }
                    MButton {
                        kind: 1;
                        text: Tr.t("Profil_Creer");
                        enabled: ProfilesState.create-enabled;
                        clicked => { ProfilesState.create(); }
                    }
                }
            }
        }
}

/// Fenêtre modale : couvre toute la fenêtre de l'application (posée par main.slint).
export component ProfileWaitOverlay inherits Rectangle {

        background: Theme.scrim;
        TouchArea { }
        Rectangle {
            width: 420px;
            height: attente.preferred-height;
            border-radius: 24px;
            background: Theme.surface;
            border-width: 2px;
            border-color: Theme.glass-border;
            drop-shadow-blur: 30px;
            drop-shadow-color: Theme.shadow;
            attente := VerticalLayout {
                padding: 28px;
                spacing: 6px;
                Spinner { height: 48px; }
                SectionTitle {
                    text: ProfilesState.wait-title;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                BodyText {
                    text: ProfilesState.wait-text;
                    horizontal-alignment: center;
                }
            }
        }
}

export component ProfilesPage inherits Rectangle {
    // ═══════════ Liste des profils : une tuile, en-tête puis grille de cartes ═══════════
    if ProfilesState.view == 0: TuilePage {
        VerticalLayout {
            EnTetePage {
                titre: Tr.t("Onglet_Profils");
                info: ProfilesState.list.length;
                VerticalLayout {
                    alignment: center;
                    MButton {
                        text: Tr.t("Profil_ImporterModpack");
                        icon: "\u{E8E5}";
                        clicked => { ProfilesState.import-modpack(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    MButton {
                        text: Tr.t("Profil_InstallerModpack");
                        icon: "\u{E896}";
                        clicked => { ProfilesState.modpacks(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    MButton {
                        kind: 1;
                        text: Tr.t("Profil_Nouveau");
                        icon: "\u{E710}";
                        clicked => { ProfilesState.new-profile(); }
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.line;
            }
            // filtres par loader, quand il y en a plusieurs
            if ProfilesState.filters.length > 2: HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                Puces {
                    model: ProfilesState.filters;
                    current: ProfilesState.filter-index;
                    selected(i) => {
                        ProfilesState.filter-index = i;
                        ProfilesState.filter-changed();
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            // la grille : autant de colonnes que la largeur le permet (cartes de 220 px au moins)
            Rectangle {
                vertical-stretch: 1;
                zone := ScrollView {
                    x: 20px;
                    y: 16px;
                    width: parent.width - 28px;
                    height: parent.height - 16px;
                    property <int> colonnes: max(1, floor((self.visible-width - 12px + 12px) / (220px + 12px)));
                    property <length> case: (self.visible-width - 12px - (self.colonnes - 1) * 12px) / self.colonnes;
                    // les profils, puis la carte « Nouveau profil »
                    property <int> nombre: ProfilesState.list.length + 1;
                    content-width: self.visible-width;
                    content-height: ceil(self.nombre / self.colonnes) * (self.case + 12px) + 8px;

                    for p[i] in ProfilesState.list: ProfileCardView {
                        x: mod(i, zone.colonnes) * (zone.case + 12px);
                        y: floor(i / zone.colonnes) * (zone.case + 12px);
                        width: zone.case;
                        height: zone.case;
                        carte: p;
                        open => { ProfilesState.open(p.id); }
                        play => { ProfilesState.play(p.id); }
                        delete => { ProfilesState.delete(p.id); }
                    }
                    NouvelleCarte {
                        x: mod(ProfilesState.list.length, zone.colonnes) * (zone.case + 12px);
                        y: floor(ProfilesState.list.length / zone.colonnes) * (zone.case + 12px);
                        width: zone.case;
                        height: zone.case;
                        clicked => { ProfilesState.new-profile(); }
                    }
                }
            }
        }
    }
    // ═══════════ Modpacks : la même tuile, avec un retour ═══════════
    if ProfilesState.view == 1: TuilePage {
        VerticalLayout {
            HorizontalLayout {
                height: 62px;
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: "\u{E72B}";
                        tooltip: Tr.t("Profil_Retour");
                        clicked => { ProfilesState.back(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Modpacks";
                        font-size: 20px;
                        font-weight: 800;
                        color: Theme.navy;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Rectangle {
                height: 1px;
                background: Theme.line;
            }
            ContentBrowser {
                vertical-stretch: 1;
            }
        }
    }
}
