// Fenêtre des options (posée par-dessus le launcher, fond flouté), classée par catégories :
// apparence, langue, comptes, mémoire, comportement, ressources, dépannage. Chaque catégorie a un en-tête
// et ses réglages sont groupés dans des cartes, avec une marge intérieure.

import { Theme, Tr } from "theme.slint";
import { SettingsState, StorageRow } from "state.slint";
import { Icon, PixelLabel, BodyText, SectionTitle, IconButton, MButton, GlassInput, ToggleSwitch, GlassSlider, ChromeButton } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

// ───────────────────────── Petits éléments ─────────────────────────

component Pseudo inherits Rectangle {
    in property <string> text;
    callback remove();
    height: 38px;
    width: t.preferred-width + 54px;
    border-radius: 12px;
    background: Theme.glass-strong;
    border-width: 1px;
    border-color: Theme.glass-border;
    t := Text {
        x: 12px;
        text: root.text;
        font-family: Theme.ui-font;
        font-weight: 600;
        font-size: 13px;
        color: Theme.navy;
        vertical-alignment: center;
    }
    ChromeButton {
        x: parent.width - 32px;
        y: 5px;
        width: 28px;
        height: 28px;
        icon: "\u{E8BB}";
        close: true;
        clicked => { root.remove(); }
    }
}

/// Ligne d'un compte Microsoft : pseudo, « utiliser » si ce n'est pas le compte actif, oublier.
component LigneCompte inherits Rectangle {
    in property <string> pseudo;
    in property <bool> active;
    callback use();
    callback forget();
    height: 48px;
    border-radius: 12px;
    background: root.active ? Theme.accent-soft : survol.has-hover ? Theme.glass-hover : Theme.glass-strong;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.glass-border;
    animate background, border-color { duration: Theme.normal; }
    survol := TouchArea { }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: root.active ? Theme.accent : transparent;
                border-width: root.active ? 0px : 1.5px;
                border-color: Theme.text-dim;
                Icon {
                    visible: root.active;
                    text: "\u{E73E}";
                    font-size: 11px;
                    color: Theme.dark ? #0A1633 : white;
                }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.pseudo;
            font-family: Theme.ui-font;
            font-weight: 600;
            font-size: 14px;
            color: root.active ? Theme.accent : Theme.navy;
            vertical-alignment: center;
            overflow: elide;
        }
        if !root.active: VerticalLayout {
            alignment: center;
            MButton {
                text: Tr.t("Compte_Utiliser");
                clicked => { root.use(); }
            }
        }
        VerticalLayout {
            alignment: center;
            ChromeButton {
                width: 32px;
                height: 32px;
                icon: "\u{E8BB}";
                close: true;
                clicked => { root.forget(); }
            }
        }
    }
}

/// Titre de groupe dans la colonne de navigation (AFFICHAGE, COMPTES…).
component GroupeNav inherits Rectangle {
    in property <string> text;
    height: 26px;
    Text {
        x: 14px;
        y: parent.height - self.height - 6px;
        text: root.text;
        font-family: Theme.pixel-font;
        font-size: 10.5px;
        color: Theme.text-dim;
    }
}

/// Entrée de la colonne de navigation. Le fond de l'entrée choisie est un indicateur commun
/// qui glisse d'une entrée à l'autre (dessiné par la colonne).
component EntreeNav inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> checked;
    callback clicked;

    height: 38px;
    border-radius: 12px;
    background: !root.checked && touch.has-hover ? Theme.glass-hover : transparent;
    animate background { duration: Theme.fast; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 12px;
        Icon {
            width: 18px;
            text: root.icon;
            font-size: 15px;
            color: root.checked ? Theme.accent : Theme.text-muted;
            transform-scale: touch.pressed ? 0.85 : 1;
            animate color { duration: Theme.normal; }
            animate transform-scale { duration: 140ms; easing: ease-out; }
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-family: Theme.ui-font;
            font-size: 14px;
            font-weight: 600;
            color: root.checked ? Theme.accent : touch.has-hover ? Theme.navy : Theme.navy2;
            vertical-alignment: center;
            overflow: elide;
            animate color { duration: Theme.normal; }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Titre de réglage (gras) + description.
component Entete inherits VerticalLayout {
    in property <string> titre;
    in property <string> texte;
    spacing: 3px;
    Text {
        text: root.titre;
        font-family: Theme.ui-font;
        font-size: 16px;
        font-weight: 700;
        color: Theme.navy;
        wrap: word-wrap;
    }
    if root.texte != "": BodyText { text: root.texte; }
}

/// Ligne « titre + description » avec l'interrupteur à droite.
component LigneInterrupteur inherits HorizontalLayout {
    in property <string> titre;
    in property <string> texte;
    in-out property <bool> checked;
    callback toggled(bool);
    spacing: 24px;
    Entete {
        horizontal-stretch: 1;
        titre: root.titre;
        texte: root.texte;
    }
    VerticalLayout {
        alignment: center;
        ToggleSwitch {
            width: 44px;
            checked <=> root.checked;
            toggled(v) => { root.toggled(v); }
        }
    }
}

component Separateur inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

/// Pastille de valeur (« 4 Go », « 16 »).
component Valeur inherits Rectangle {
    in property <string> text;
    width: max(54px, v.preferred-width + 24px);
    height: 34px;
    border-radius: 10px;
    background: Theme.glass-strong;
    border-width: 1px;
    border-color: Theme.glass-border;
    v := Text {
        text: root.text;
        font-family: Theme.ui-font;
        font-size: 14px;
        font-weight: 700;
        color: Theme.navy;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

/// Curseur avec ses bornes et la valeur à droite (comme « Téléchargements simultanés » de Modrinth).
component CurseurBorne inherits HorizontalLayout {
    in property <float> minimum;
    in property <float> maximum;
    in property <float> step: 1;
    in property <string> min-text;
    in property <string> max-text;
    in property <string> value-text;
    in-out property <float> value;
    callback changed(float);
    spacing: 14px;
    Text {
        text: root.min-text;
        font-size: 13px;
        color: Theme.text-muted;
        vertical-alignment: center;
    }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        GlassSlider {
            minimum: root.minimum;
            maximum: root.maximum;
            step: root.step;
            value <=> root.value;
            changed(v) => { root.changed(v); }
        }
    }
    Text {
        text: root.max-text;
        font-size: 13px;
        color: Theme.text-muted;
        vertical-alignment: center;
    }
    VerticalLayout {
        alignment: center;
        Valeur { text: root.value-text; }
    }
}

/// Carte de thème avec un aperçu miniature (Brume, Nuit, Comme Windows).
component CarteTheme inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    /// 0 brume · 1 nuit · 2 système (moitié/moitié)
    in property <int> genre;
    in property <bool> checked;
    callback clicked;

    height: 156px;
    border-radius: 16px;
    background: Theme.glass-strong;
    border-width: root.checked ? 2px : 1px;
    border-color: root.checked ? Theme.accent : touch.has-hover ? Theme.accent.with-alpha(0.5) : Theme.glass-border;
    drop-shadow-blur: root.checked ? 18px : 0px;
    drop-shadow-color: Theme.accent.with-alpha(0.35);
    clip: true;
    transform-scale: touch.pressed ? 0.97 : touch.has-hover ? 1.02 : 1;
    animate border-color, drop-shadow-blur { duration: Theme.normal; }
    animate transform-scale { duration: 180ms; easing: ease-out; }

    // Aperçu
    Rectangle {
        x: 0;
        y: 0;
        height: 108px;
        clip: true;
        Rectangle {
            width: root.genre == 2 ? parent.width / 2 : parent.width;
            background: root.genre == 1 ? @linear-gradient(160deg, #162140 0%, #0A0F1D 100%) : @linear-gradient(135deg, #BAD6F7 0%, #95B9E4 55%, #6F90C0 100%);
        }
        if root.genre == 2: Rectangle {
            x: parent.width / 2;
            width: parent.width / 2;
            background: @linear-gradient(160deg, #162140 0%, #0A0F1D 100%);
        }
        // mini fenêtre en verre
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: 24px;
            width: min(150px, parent.width - 36px);
            height: 60px;
            border-radius: 10px;
            background: root.genre == 1 ? #111A30 : root.genre == 2 ? @linear-gradient(90deg, #FFFFFF99 0%, #FFFFFF99 50%, #111A30 50%, #111A30 100%) : #FFFFFF99;
            border-width: 1px;
            border-color: root.genre == 1 ? #FFFFFF1F : #FFFFFFCC;
            Rectangle {
                x: 12px;
                y: 14px;
                width: 32px;
                height: 32px;
                border-radius: 8px;
                background: root.genre == 1 ? #6F9CFF : #1C2335;
            }
            Rectangle {
                x: 54px;
                y: 18px;
                width: parent.width - 70px;
                height: 8px;
                border-radius: 4px;
                background: root.genre == 0 ? #1C2335 : root.genre == 1 ? #CFDAF0 : #6F9CFF;
            }
            Rectangle {
                x: 54px;
                y: 34px;
                width: (parent.width - 70px) * 0.6;
                height: 8px;
                border-radius: 4px;
                background: root.genre == 1 ? #6F7C99 : #5A6B82;
            }
        }
    }
    // Pied : bouton radio + nom
    Rectangle {
        y: 108px;
        height: parent.height - 108px;
        background: root.checked ? Theme.accent-soft : transparent;
        animate background { duration: Theme.normal; }
        HorizontalLayout {
            padding-left: 14px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    border-width: 1.5px;
                    border-color: root.checked ? Theme.accent : Theme.text-dim;
                    Rectangle {
                        width: root.checked ? 10px : 0px;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: Theme.accent;
                        animate width { duration: 260ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                    }
                }
            }
            Text {
                text: root.text;
                font-size: 14px;
                font-weight: 700;
                color: root.checked ? Theme.accent : Theme.navy;
                vertical-alignment: center;
            }
            Icon {
                horizontal-stretch: 1;
                horizontal-alignment: left;
                text: root.icon;
                font-size: 13px;
                color: Theme.text-muted;
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Langue de la liste (drapeau, nom, nom en anglais, coche ronde).
component LigneLangue inherits Rectangle {
    in property <string> nom;
    in property <string> anglais;
    in property <image> flag;
    in property <bool> checked;
    callback clicked;
    height: 46px;
    border-radius: 12px;
    background: root.checked ? Theme.accent-soft : touch.has-hover ? Theme.glass-hover : transparent;
    border-width: 1px;
    border-color: root.checked ? Theme.accent : transparent;
    animate background, border-color { duration: Theme.normal; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px;
                height: 18px;
                border-radius: 3px;
                clip: true;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.flag;
                    image-fit: cover;
                }
            }
        }
        Text {
            text: root.nom;
            font-size: 14px;
            font-weight: 700;
            color: Theme.navy;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.anglais;
            font-size: 12px;
            color: Theme.text-muted;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: root.checked ? Theme.accent : transparent;
                border-width: root.checked ? 0px : 1.5px;
                border-color: Theme.text-dim;
                transform-scale: root.checked ? 1 : 0.9;
                animate background { duration: Theme.normal; }
                animate transform-scale { duration: 260ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                Icon {
                    text: "\u{E73E}";
                    font-size: 11px;
                    color: Theme.dark ? #0A1633 : white;
                    opacity: root.checked ? 1 : 0;
                    animate opacity { duration: Theme.normal; }
                }
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Encadré d'avertissement (orange), comme celui de Modrinth sur la page des langues.
component Avertissement inherits Rectangle {
    in property <string> text;
    border-radius: 14px;
    background: Theme.dark ? #3A2A12 : #FFF1DC;
    border-width: 1px;
    border-color: Theme.dark ? #F2A33C : #F0B35E;
    min-height: contenu.preferred-height;
    contenu := HorizontalLayout {
        padding: 14px;
        padding-left: 16px;
        spacing: 12px;
        Icon {
            width: 18px;
            vertical-alignment: top;
            text: "\u{E7BA}";
            font-size: 16px;
            color: Theme.dark ? #F2A33C : #C77712;
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            font-size: 13px;
            color: Theme.dark ? #F6DDB5 : #6B4210;
            wrap: word-wrap;
        }
    }
}

/// Bloc d'action : titre, explication, puis les boutons.
component BlocAction inherits VerticalLayout {
    in property <string> titre;
    in property <string> texte;
    spacing: 6px;
    Text {
        text: root.titre;
        font-size: 15px;
        font-weight: 700;
        color: Theme.navy;
        wrap: word-wrap;
    }
    if root.texte != "": BodyText { text: root.texte; }
    HorizontalLayout {
        alignment: start;
        spacing: 10px;
        padding-top: 8px;
        @children
    }
}

/// Groupe de réglages : une carte arrondie avec une marge intérieure, pour qu'aucun bouton ni
/// interrupteur ne touche un bord.
component Carte inherits Rectangle {
    in property <length> spacing: 18px;
    border-radius: 18px;
    background: Theme.glass;
    border-width: 1px;
    border-color: Theme.glass-border;
    min-height: corps.preferred-height;
    corps := VerticalLayout {
        padding-top: 20px;
        padding-bottom: 20px;
        padding-left: 22px;
        padding-right: 22px;
        spacing: root.spacing;
        @children
    }
}

/// En-tête de la catégorie : pastille avec l'icône, titre et sous-titre.
component EnteteSection inherits HorizontalLayout {
    in property <string> icon;
    in property <string> titre;
    in property <string> texte;
    spacing: 16px;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 50px;
            height: 50px;
            border-radius: 15px;
            background: Theme.accent-soft;
            border-width: 1px;
            border-color: Theme.accent.with-alpha(0.35);
            Icon {
                text: root.icon;
                font-size: 20px;
                color: Theme.accent;
            }
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.titre;
            font-family: Theme.ui-font;
            font-size: 22px;
            font-weight: 800;
            color: Theme.navy;
            overflow: elide;
        }
        Text {
            text: root.texte;
            font-size: 13px;
            color: Theme.text-muted;
            wrap: word-wrap;
        }
    }
}

/// Contenu d'une catégorie : apparaît en fondu en glissant légèrement.
component Volet inherits VerticalLayout {
    opacity: 0;
    property <length> decalage: 10px;
    padding-top: self.decalage;
    padding-bottom: 10px - self.decalage;
    animate opacity { duration: 240ms; easing: ease-out; }
    animate decalage { duration: 320ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    init => {
        self.opacity = 1;
        self.decalage = 0;
    }
}

// ───────────────────────── La fenêtre des options ─────────────────────────

export component SettingsModal inherits Rectangle {
    property <bool> ouvert: SettingsState.open;
    property <int> section: SettingsState.section;

    // Position de l'indicateur pour chaque entrée (groupes de 26 px, entrées de 38 px + 4 px)
    property <[length]> positions: [26px, 68px, 136px, 178px, 246px, 314px, 356px, 398px];
    // En-tête de chaque catégorie
    property <[string]> icones: ["\u{E771}", "\u{E774}", "\u{E77B}", "\u{E716}", "\u{E9D9}", "\u{E9E9}", "\u{EDA2}", "\u{E90F}"];
    property <[string]> titres: ["Param_Apparence", "Param_Langue", "Param_Microsoft", "Param_HorsLigne", "Param_Memoire", "Param_Comportement", "Param_Ressources", "Param_Depannage"];

    opacity: root.ouvert ? 1 : 0;
    visible: self.opacity > 0.01 && !SettingsState.capturing;
    animate opacity { duration: root.ouvert ? 220ms : 160ms; easing: ease-out; }

    // Fond : capture floutée de la fenêtre + voile
    if SettingsState.has-backdrop && Theme.blur: Image {
        width: parent.width;
        height: parent.height;
        source: SettingsState.backdrop;
        image-fit: fill;
        image-rendering: smooth;
        opacity: 0;
        animate opacity { duration: 300ms; easing: ease-out; }
        init => { self.opacity = 1; }
    }
    Rectangle {
        background: Theme.scrim;
    }
    TouchArea {
        enabled: root.ouvert;
        clicked => { SettingsState.close(); }
    }

    carte := Rectangle {
        width: min(1040px, parent.width - 80px);
        height: min(740px, parent.height - 60px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (root.ouvert ? 0px : 18px);
        border-radius: 24px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.glass-border;
        drop-shadow-blur: 50px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: Theme.shadow;
        transform-scale: root.ouvert ? 1 : 0.96;
        animate y { duration: root.ouvert ? 380ms : 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate transform-scale { duration: root.ouvert ? 380ms : 180ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        clip: true;
        TouchArea { }

        HorizontalLayout {
            // ═══ Colonne de navigation ═══
            Rectangle {
                width: 252px;
                background: Theme.surface-2;

                VerticalLayout {
                    padding: 16px;
                    padding-top: 22px;
                    spacing: 12px;

                    // Titre de la fenêtre
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-bottom: 4px;
                        Text {
                            text: Tr.t("Param_Titre");
                            font-family: Theme.ui-font;
                            font-size: 24px;
                            font-weight: 800;
                            color: Theme.navy;
                            overflow: elide;
                        }
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        content-height: 440px;

                        Rectangle {
                            width: parent.visible-width;
                            height: 440px;

                            // indicateur qui glisse sous l'entrée choisie
                            Rectangle {
                                x: 0;
                                y: root.positions[root.section];
                                width: parent.width;
                                height: 38px;
                                border-radius: 12px;
                                background: Theme.accent-soft;
                                border-width: 1px;
                                border-color: Theme.accent.with-alpha(0.35);
                                animate y { duration: 380ms; easing: cubic-bezier(0.34, 1.25, 0.64, 1); }
                                // trait lumineux à gauche
                                Rectangle {
                                    x: 0px;
                                    y: 10px;
                                    width: 3px;
                                    height: parent.height - 20px;
                                    border-radius: 2px;
                                    background: Theme.accent;
                                    drop-shadow-blur: 8px;
                                    drop-shadow-color: Theme.accent;
                                }
                            }

                            GroupeNav { y: 0px; width: parent.width; text: Tr.t("Param_Groupe_Affichage"); }
                            EntreeNav { y: 26px; width: parent.width; icon: root.icones[0]; text: Tr.t("Param_Apparence"); checked: root.section == 0; clicked => { SettingsState.section = 0; } }
                            EntreeNav { y: 68px; width: parent.width; icon: root.icones[1]; text: Tr.t("Param_Langue"); checked: root.section == 1; clicked => { SettingsState.section = 1; } }

                            GroupeNav { y: 110px; width: parent.width; text: Tr.t("Param_Groupe_Comptes"); }
                            EntreeNav { y: 136px; width: parent.width; icon: root.icones[2]; text: Tr.t("Param_Microsoft"); checked: root.section == 2; clicked => { SettingsState.section = 2; } }
                            EntreeNav { y: 178px; width: parent.width; icon: root.icones[3]; text: Tr.t("Param_HorsLigne"); checked: root.section == 3; clicked => { SettingsState.section = 3; } }

                            GroupeNav { y: 220px; width: parent.width; text: Tr.t("Param_Groupe_Jeu"); }
                            EntreeNav { y: 246px; width: parent.width; icon: root.icones[4]; text: Tr.t("Param_Memoire"); checked: root.section == 4; clicked => { SettingsState.section = 4; } }

                            GroupeNav { y: 288px; width: parent.width; text: Tr.t("Param_Groupe_Launcher"); }
                            EntreeNav { y: 314px; width: parent.width; icon: root.icones[5]; text: Tr.t("Param_Comportement"); checked: root.section == 5; clicked => { SettingsState.section = 5; } }
                            EntreeNav { y: 356px; width: parent.width; icon: root.icones[6]; text: Tr.t("Param_Ressources"); checked: root.section == 6; clicked => { SettingsState.section = 6; } }
                            EntreeNav { y: 398px; width: parent.width; icon: root.icones[7]; text: Tr.t("Param_Depannage"); checked: root.section == 7; clicked => { SettingsState.section = 7; } }
                        }
                    }

                    // Pied de colonne : version de Misty et de Windows, dans une petite carte
                    Rectangle {
                        height: 56px;
                        border-radius: 14px;
                        background: Theme.glass;
                        border-width: 1px;
                        border-color: Theme.glass-border;
                        HorizontalLayout {
                            padding-left: 11px;
                            padding-right: 12px;
                            spacing: 11px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 34px;
                                    height: 34px;
                                    border-radius: 10px;
                                    background: Theme.dark ? #162140 : #1C2335;
                                    Image {
                                        width: 24px;
                                        height: 24px;
                                        source: @image-url("../assets/logo-nuage.png");
                                        image-fit: contain;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 1px;
                                Text {
                                    text: SettingsState.about-text;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: Theme.navy2;
                                    overflow: elide;
                                }
                                Text {
                                    text: SettingsState.system-text;
                                    font-size: 11.5px;
                                    color: Theme.text-muted;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Theme.line;
                }
            }

            // ═══ Contenu de la catégorie choisie ═══
            Rectangle {
                horizontal-stretch: 1;

                ScrollView {
                    width: parent.width;
                    height: parent.height;
                    content-width: self.visible-width;
                    content-height: contenu.preferred-height;

                    contenu := VerticalLayout {
                        width: parent.visible-width;
                        padding-left: 36px;
                        padding-right: 40px;
                        padding-top: 30px;
                        padding-bottom: 36px;
                        spacing: 24px;
                        alignment: start;

                        // marge à droite pour la croix de fermeture
                        HorizontalLayout {
                            padding-right: 52px;
                            EnteteSection {
                                icon: root.icones[root.section];
                                titre: Tr.t(root.titres[root.section]);
                                texte: root.section == 0 ? Tr.t("Param_Apparence_Sous")
                                    : root.section == 1 ? Tr.t("Param_Langue_Sous")
                                    : root.section == 2 ? Tr.t("Param_Microsoft_Sous")
                                    : root.section == 3 ? Tr.t("Param_HorsLigne_Sous")
                                    : root.section == 4 ? Tr.t("Param_Memoire_Sous")
                                    : root.section == 5 ? Tr.t("Param_Comportement_Sous")
                                    : root.section == 6 ? Tr.t("Param_Ressources_Sous")
                                    : Tr.t("Param_Depannage_Sous");
                            }
                        }

                        // ── Apparence ──
                        if root.section == 0: Volet {
                            spacing: 16px;
                            Carte {
                                Entete {
                                    titre: Tr.t("Param_Theme");
                                    texte: Tr.t("Param_Theme_Texte");
                                }
                                if Theme.event != 0: Rectangle {
                                    height: 42px;
                                    border-radius: 12px;
                                    background: Theme.accent-soft;
                                    border-width: 1px;
                                    border-color: Theme.accent.with-alpha(0.5);
                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        spacing: 10px;
                                        Icon {
                                            width: 16px;
                                            text: "\u{E706}";
                                            font-size: 14px;
                                            color: Theme.accent;
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: Theme.halloween ? Tr.t("Param_Saison_Halloween") : Tr.t("Param_Saison_Noel");
                                            font-size: 13px;
                                            font-weight: 600;
                                            color: Theme.accent;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 14px;
                                    CarteTheme {
                                        horizontal-stretch: 1;
                                        genre: 0;
                                        text: Tr.t("Param_Theme_Brume");
                                        icon: "\u{E706}";
                                        checked: Theme.mode == 0;
                                        clicked => { SettingsState.theme-selected(0); }
                                    }
                                    CarteTheme {
                                        horizontal-stretch: 1;
                                        genre: 1;
                                        text: Tr.t("Param_Theme_Nuit");
                                        icon: "\u{E708}";
                                        checked: Theme.mode == 1;
                                        clicked => { SettingsState.theme-selected(1); }
                                    }
                                    CarteTheme {
                                        horizontal-stretch: 1;
                                        genre: 2;
                                        text: Tr.t("Param_Theme_Systeme");
                                        icon: "\u{E7F4}";
                                        checked: Theme.mode == 2;
                                        clicked => { SettingsState.theme-selected(2); }
                                    }
                                }
                            }
                            Carte {
                                LigneInterrupteur {
                                    titre: Tr.t("Param_Saison");
                                    texte: Tr.t("Param_Saison_Texte");
                                    checked <=> SettingsState.seasonal;
                                    toggled(v) => { SettingsState.seasonal-toggled(v); }
                                }
                                Separateur { }
                                VerticalLayout {
                                    spacing: 12px;
                                    Entete {
                                        titre: Tr.t("Param_FondFlou");
                                        texte: Tr.t("Param_FondFlou_Texte");
                                    }
                                    CurseurBorne {
                                        minimum: 0;
                                        maximum: 10;
                                        step: 1;
                                        min-text: Tr.t("Param_FondFlou_Net");
                                        max-text: Tr.t("Param_FondFlou_Max");
                                        value-text: SettingsState.bg-blur == 0 ? Tr.t("Param_FondFlou_Off") : round(SettingsState.bg-blur);
                                        value <=> SettingsState.bg-blur;
                                        changed(v) => { SettingsState.bg-blur-changed(v); }
                                    }
                                }
                                Separateur { }
                                LigneInterrupteur {
                                    titre: Tr.t("Param_Flou");
                                    texte: Tr.t("Param_Flou_Texte");
                                    checked: Theme.blur;
                                    toggled(v) => { SettingsState.blur-toggled(v); }
                                }
                            }
                        }

                        // ── Langue ──
                        if root.section == 1: Volet {
                            spacing: 16px;
                            Avertissement { text: Tr.t("Param_Langue_Avert"); }
                            Carte {
                                spacing: 12px;
                                BodyText { text: Tr.t("Options_Langue_Texte"); }
                                VerticalLayout {
                                    spacing: 6px;
                                    for l[i] in SettingsState.langs: LigneLangue {
                                        nom: l.name;
                                        anglais: l.english;
                                        flag: l.flag;
                                        checked: i == SettingsState.lang-index;
                                        clicked => {
                                            SettingsState.lang-index = i;
                                            SettingsState.lang-selected(i);
                                        }
                                    }
                                }
                            }
                        }

                        // ── Compte Microsoft ──
                        if root.section == 2: Volet {
                            spacing: 16px;
                            Carte {
                                Entete {
                                    titre: Tr.t("Param_Microsoft_Titre");
                                    texte: SettingsState.ms-state;
                                }
                                if SettingsState.ms-accounts.length > 0: VerticalLayout {
                                    spacing: 8px;
                                    for c in SettingsState.ms-accounts: LigneCompte {
                                        pseudo: c.pseudo;
                                        active: c.active && SettingsState.ms-connected;
                                        use => { SettingsState.ms-switch(c.uuid); }
                                        forget => { SettingsState.ms-forget(c.uuid); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    MButton {
                                        kind: 1;
                                        icon: "\u{E710}";
                                        text: SettingsState.ms-accounts.length == 0 ? Tr.t("Compte_SeConnecter") : Tr.t("Compte_Ajouter");
                                        enabled: !SettingsState.ms-busy;
                                        clicked => { SettingsState.connect(); }
                                    }
                                    if SettingsState.ms-connected: MButton {
                                        text: Tr.t("Compte_SeDeconnecter");
                                        clicked => { SettingsState.disconnect(); }
                                    }
                                    MButton {
                                        text: Tr.t("Compte_DeconnexionTotale");
                                        clicked => { SettingsState.disconnect-all(); }
                                    }
                                }
                            }
                        }

                        // ── Comptes hors-ligne ──
                        if root.section == 3: Volet {
                            spacing: 16px;
                            Carte {
                                BodyText { text: Tr.t("Options_hors_ligne_text"); }
                                if SettingsState.pseudo-rows.length > 0: VerticalLayout {
                                    spacing: 8px;
                                    for ligne in SettingsState.pseudo-rows: HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        for p in ligne.items: Pseudo {
                                            text: p;
                                            remove => { SettingsState.remove-pseudo(p); }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    GlassInput {
                                        horizontal-stretch: 1;
                                        placeholder: Tr.t("Param_Pseudo_Placeholder");
                                        text <=> SettingsState.new-pseudo;
                                        accepted => { SettingsState.add-pseudo(); }
                                    }
                                    MButton {
                                        horizontal-stretch: 0;
                                        kind: 1;
                                        icon: "\u{E710}";
                                        text: Tr.t("Options_bouton_ajout");
                                        clicked => { SettingsState.add-pseudo(); }
                                    }
                                }
                            }
                        }

                        // ── Java et mémoire ──
                        if root.section == 4: Volet {
                            spacing: 16px;
                            Carte {
                                Entete {
                                    titre: Tr.t("Param_Memoire_Titre");
                                    texte: SettingsState.ram-total-text;
                                }
                                CurseurBorne {
                                    minimum: 1024;
                                    maximum: SettingsState.ram-max;
                                    step: 1024;
                                    min-text: "1 " + Tr.t("Unite_Go");
                                    max-text: round(SettingsState.ram-max / 1024) + " " + Tr.t("Unite_Go");
                                    value-text: SettingsState.ram-text;
                                    value <=> SettingsState.ram-value;
                                    changed(v) => { SettingsState.ram-changed(v); }
                                }
                                Separateur { }
                                BodyText { text: Tr.t("Param_Memoire_Conseil"); }
                            }
                        }

                        // ── Comportement : raccourci, partage, Discord, console, télémétrie ──
                        if root.section == 5: Volet {
                            spacing: 16px;
                            Carte {
                                LigneInterrupteur {
                                    titre: Tr.t("Param_Raccourci");
                                    texte: Tr.t("Options_Raccourci_Texte");
                                    checked <=> SettingsState.shortcut-enabled;
                                    toggled(v) => { SettingsState.shortcut-toggled(v); }
                                }
                                if SettingsState.shortcut-enabled: VerticalLayout {
                                    spacing: 12px;
                                    Rectangle {
                                        height: 42px;
                                        border-radius: 12px;
                                        background: Theme.glass-strong;
                                        border-width: 1px;
                                        border-color: Theme.glass-border;
                                        HorizontalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            spacing: 10px;
                                            Icon {
                                                width: 16px;
                                                text: "\u{E8B7}";
                                                font-size: 13px;
                                                color: Theme.text-muted;
                                            }
                                            Text {
                                                horizontal-stretch: 1;
                                                text: SettingsState.shortcut-path;
                                                font-size: 13px;
                                                color: Theme.navy2;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        alignment: start;
                                        MButton {
                                            text: Tr.t("Options_ChoisirDossier");
                                            clicked => { SettingsState.choose-shortcut(); }
                                        }
                                        MButton {
                                            text: Tr.t("Options_Recreer");
                                            clicked => { SettingsState.recreate-shortcut(); }
                                        }
                                    }
                                }
                            }
                            Carte {
                                LigneInterrupteur {
                                    titre: Tr.t("Param_Partage");
                                    texte: Tr.t("Param_Partage_Texte");
                                    checked <=> SettingsState.share-game-data;
                                    toggled(v) => { SettingsState.share-game-data-toggled(v); }
                                }
                            }
                            Carte {
                                LigneInterrupteur {
                                    titre: Tr.t("Param_Discord");
                                    texte: Tr.t("Options_Discord_Texte");
                                    checked <=> SettingsState.rich;
                                    toggled(v) => { SettingsState.rich-toggled(v); }
                                }
                                Separateur { }
                                LigneInterrupteur {
                                    titre: Tr.t("Param_Console");
                                    texte: Tr.t("Param_Console_Texte");
                                    checked <=> SettingsState.console-auto;
                                    toggled(v) => { SettingsState.console-auto-toggled(v); }
                                }
                                Separateur { }
                                LigneInterrupteur {
                                    titre: Tr.t("Param_Telemetrie");
                                    texte: Tr.t("Param_Telemetrie_Texte");
                                    checked <=> SettingsState.telemetry;
                                    toggled(v) => { SettingsState.telemetry-toggled(v); }
                                }
                            }
                        }

                        // ── Ressources ──
                        if root.section == 6: Volet {
                            spacing: 16px;
                            Carte {
                                HorizontalLayout {
                                    spacing: 16px;
                                    Entete {
                                        horizontal-stretch: 1;
                                        titre: Tr.t("Param_Stockage");
                                        texte: Tr.t("Param_Stockage_Texte");
                                    }
                                    VerticalLayout {
                                        alignment: start;
                                        Valeur { text: SettingsState.size-text; }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;
                                    MButton {
                                        kind: 1;
                                        icon: "\u{EDA2}";
                                        text: Tr.t("Stock_Gerer");
                                        clicked => { SettingsState.storage-show(); }
                                    }
                                    MButton {
                                        kind: 2;
                                        icon: "\u{E74D}";
                                        text: Tr.t("Options_ToutSupprimer");
                                        clicked => { SettingsState.delete-all(); }
                                    }
                                }
                            }
                            Carte {
                                spacing: 12px;
                                Entete {
                                    titre: Tr.t("Param_Dossier");
                                    texte: Tr.t("Param_Dossier_Texte");
                                }
                                Rectangle {
                                    height: 46px;
                                    border-radius: 12px;
                                    background: Theme.glass-strong;
                                    border-width: 1px;
                                    border-color: Theme.glass-border;
                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 6px;
                                        spacing: 10px;
                                        Icon {
                                            width: 16px;
                                            text: "\u{E7B8}";
                                            font-size: 14px;
                                            color: Theme.text-muted;
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: SettingsState.data-dir;
                                            font-size: 13px;
                                            color: Theme.navy2;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        VerticalLayout {
                                            alignment: center;
                                            IconButton {
                                                width: 34px;
                                                height: 34px;
                                                icon: "\u{E838}";
                                                icon-size: 14px;
                                                tooltip: Tr.t("Commun_OuvrirDossier");
                                                clicked => { SettingsState.open-folder(); }
                                            }
                                        }
                                    }
                                }
                            }
                            Carte {
                                spacing: 12px;
                                Entete {
                                    titre: Tr.t("Param_Telechargements");
                                    texte: Tr.t("Param_Telechargements_Texte");
                                }
                                CurseurBorne {
                                    minimum: 2;
                                    maximum: 32;
                                    step: 1;
                                    min-text: "2";
                                    max-text: "32";
                                    value-text: round(SettingsState.downloads);
                                    value <=> SettingsState.downloads;
                                    changed(v) => { SettingsState.downloads-changed(v); }
                                }
                            }
                        }

                        // ── Dépannage ──
                        if root.section == 7: Volet {
                            spacing: 16px;
                            Carte {
                                BlocAction {
                                    titre: Tr.t("Param_Cache");
                                    texte: Tr.t("Param_Cache_Texte");
                                    MButton {
                                        icon: "\u{E74D}";
                                        text: Tr.t("Param_Cache_Bouton");
                                        clicked => { SettingsState.clear-cache(); }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: SettingsState.cache-size;
                                            font-size: 13px;
                                            color: Theme.text-muted;
                                        }
                                    }
                                }
                                Separateur { }
                                BlocAction {
                                    titre: Tr.t("Param_Journaux");
                                    texte: Tr.t("Param_Journaux_Texte");
                                    MButton {
                                        icon: "\u{E838}";
                                        text: Tr.t("Param_Journaux_Bouton");
                                        clicked => { SettingsState.open-logs(); }
                                    }
                                    MButton {
                                        icon: "\u{E756}";
                                        text: Tr.t("Param_JournalMisty");
                                        clicked => { SettingsState.open-launcher-log(); }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: SettingsState.logs-size;
                                            font-size: 13px;
                                            color: Theme.text-muted;
                                        }
                                    }
                                }
                                Separateur { }
                                BlocAction {
                                    titre: Tr.t("Param_Debug");
                                    texte: Tr.t("Param_Debug_Texte");
                                    MButton {
                                        icon: "\u{E896}";
                                        text: Tr.t("Param_Debug_Bouton");
                                        clicked => { SettingsState.export-debug(); }
                                    }
                                }
                            }
                            Carte {
                                BlocAction {
                                    titre: Tr.t("Param_MiseAJour");
                                    texte: SettingsState.about-text;
                                    MButton {
                                        kind: 1;
                                        icon: "\u{E895}";
                                        text: Tr.t("Maj_Rechercher");
                                        icon-spin: SettingsState.checking-update;
                                        clicked => { SettingsState.check-update(); }
                                    }
                                    MButton {
                                        text: "GitHub";
                                        clicked => { SettingsState.github(); }
                                    }
                                }
                                Separateur { }
                                LigneInterrupteur {
                                    titre: Tr.t("Param_PreRelease");
                                    texte: Tr.t("Param_PreRelease_Texte");
                                    checked <=> SettingsState.prerelease;
                                    toggled(v) => { SettingsState.prerelease-toggled(v); }
                                }
                            }
                            if SettingsState.misty-client-available: Carte {
                                LigneInterrupteur {
                                    titre: Tr.t("Param_MistyClient");
                                    texte: Tr.t("Param_MistyClient_Texte") + " Fabric " + SettingsState.misty-client-mc + ".";
                                    checked <=> SettingsState.misty-client;
                                    toggled(v) => { SettingsState.misty-client-toggled(v); }
                                }
                            }
                        }
                    }
                }

                // Croix de fermeture, en haut à droite (loin du bord)
                Rectangle {
                    x: parent.width - self.width - 26px;
                    y: 26px;
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: fermer.pressed ? Theme.glass-strong : fermer.has-hover ? Theme.glass-hover : Theme.glass;
                    border-width: 1px;
                    border-color: fermer.has-hover ? Theme.accent : Theme.glass-border;
                    transform-scale: fermer.pressed ? 0.88 : 1;
                    transform-rotation: fermer.has-hover ? 90deg : 0deg;
                    animate background, border-color { duration: Theme.fast; }
                    animate transform-scale { duration: 140ms; easing: ease-out; }
                    animate transform-rotation { duration: 260ms; easing: ease-out; }
                    Icon {
                        text: "\u{E8BB}";
                        font-size: 12px;
                        color: Theme.navy;
                    }
                    fermer := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { SettingsState.close(); }
                    }
                }
            }
        }
    }
}

// ───────────────────────── Gestion du stockage ─────────────────────────

component LigneStockage inherits Rectangle {
    in property <StorageRow> r;
    height: r.niveau == 0 ? 62px : 46px;
    border-radius: 12px;
    background: r.niveau == 0 ? Theme.glass-strong : Theme.glass;
    border-width: 1px;
    border-color: r.reste ? #FF5A6E88 : Theme.glass-border;

    // barre de proportion (poids relatif dans le dossier de données)
    if r.niveau == 0 && !r.locked: Rectangle {
        x: 14px;
        y: parent.height - 9px;
        height: 3px;
        width: max(4px, (parent.width - 28px) * r.fraction);
        border-radius: 2px;
        background: Theme.steel;
    }

    TouchArea {
        enabled: r.expandable;
        clicked => { SettingsState.storage-toggle(r.cle); }
    }
    HorizontalLayout {
        padding-left: r.niveau == 0 ? 14px : 40px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: r.niveau == 0 ? 12px : 6px;
        spacing: 10px;
        Icon {
            width: 16px;
            text: r.locked ? "\u{E72E}" : r.expandable ? (r.expanded ? "\u{E70D}" : "\u{E76C}") : "";
            font-size: 12px;
            color: Theme.text-muted;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: r.nom;
                font-family: Theme.ui-font;
                font-size: r.niveau == 0 ? 14px : 13px;
                font-weight: r.niveau == 0 ? 700 : 500;
                color: Theme.text;
                overflow: elide;
            }
            if r.info != "": Text {
                text: r.info;
                font-family: Theme.ui-font;
                font-size: 11px;
                color: r.reste ? Theme.danger : Theme.text-muted;
                overflow: elide;
            }
        }
        Text {
            text: r.size-text;
            font-family: Theme.ui-font;
            font-size: 13px;
            font-weight: 600;
            color: Theme.navy;
            vertical-alignment: center;
        }
        if !r.locked: IconButton {
            icon: "\u{E74D}";
            tooltip: Tr.t("Stock_Supprimer");
            width: 34px;
            height: 34px;
            y: (parent.height - self.height) / 2;
            clicked => { SettingsState.storage-delete(r.cle); }
        }
        if r.locked: Rectangle { width: 34px; }
    }
}

/// Fenêtre modale : couvre toute la fenêtre de l'application (posée par main.slint).
export component StorageOverlay inherits Rectangle {
    background: Theme.scrim;
    opacity: 0;
    animate opacity { duration: 200ms; }
    init => { self.opacity = 1; }
    TouchArea {
        clicked => { SettingsState.storage-close(); }
    }
    Rectangle {
        width: min(640px, parent.width - 40px);
        height: min(620px, parent.height - 40px);
        border-radius: 24px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.glass-border;
        drop-shadow-blur: 40px;
        drop-shadow-color: Theme.shadow;
        transform-scale: 0.95;
        animate transform-scale { duration: 320ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        init => { self.transform-scale = 1; }
        TouchArea { }
        VerticalLayout {
            padding: 24px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                SectionTitle {
                    text: Tr.t("Stock_Titre");
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                PixelLabel {
                    text: SettingsState.storage-total;
                    font-size: 13px;
                    color: Theme.navy;
                    vertical-alignment: center;
                }
            }
            BodyText { text: Tr.t("Stock_Intro"); wrap: word-wrap; }
            if SettingsState.storage-busy: Rectangle {
                vertical-stretch: 1;
                Text {
                    text: Tr.t("Options_Calcul");
                    font-family: Theme.pixel-font;
                    font-size: 13px;
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            if !SettingsState.storage-busy: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 6px;
                    for r in SettingsState.storage-rows: LigneStockage { r: r; }
                }
            }
            HorizontalLayout {
                alignment: end;
                MButton {
                    text: Tr.t("Commun_Fermer");
                    clicked => { SettingsState.storage-close(); }
                }
            }
        }
    }
}
