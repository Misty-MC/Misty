// Page d'accueil : à gauche le titre MISTY, la news à la une (grande image, flèches, points) et
// les news suivantes en petites cartes ; à droite une colonne de lancement (compte, carte de la
// version, console, JOUER), puis les onglets « Jouer » et « Skin » écrits à la verticale.
// Le statut et la progression n'apparaissent dans la colonne que pendant un lancement.

import { Theme, Tr, Assets } from "theme.slint";
import { HomeState, AppState, NewsItem } from "state.slint";
import { Icon, PixelLabel, OutlinedText, Thumb, IconButton, PlayButton, GlassCombo } from "widgets.slint";
import { ConsoleState } from "console.slint";
import { SkinState, SkinPanel } from "skin.slint";

/// Onglet vertical (« JOUER », « SKIN ») : le texte est écrit de haut en bas.
component VTab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;

    width: 64px;
    height: lab.preferred-width + 20px;
    opacity: root.active ? 1 : touch.has-hover ? 0.85 : 0.5;
    animate opacity { duration: 150ms; }

    // La rotation s'applique à un rectangle qui contient le texte
    // (elle est ignorée sur l'élément racine d'un composant)
    Rectangle {
        width: lab.preferred-width;
        height: lab.preferred-height;
        x: 36px - self.width / 2;
        y: (parent.height - self.height) / 2;
        transform-rotation: 90deg;
        lab := OutlinedText {
            text: root.text;
            font-size: 30px;
            thickness: 3px;
            depth: 4px;
        }
    }
    // la zone cliquable ne tourne pas
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Onglets « Jouer » et « Skin », écrits à la verticale, tout à droite.
component Onglets inherits VerticalLayout {
    alignment: center;
    spacing: 16px;
    VTab {
        text: Tr.t("Home_Bouton_Jouer");
        active: SkinState.tab == 0;
        clicked => {
            SkinState.tab = 0;
            AppState.nav = 0;
        }
    }
    VTab {
        text: Tr.t("Skin_Onglet");
        active: SkinState.tab == 1;
        clicked => {
            SkinState.tab = 1;
            AppState.nav = 7;
            SkinState.open();
        }
    }
}

/// Flèche ronde du carrousel (précédente / suivante).
component Fleche inherits Rectangle {
    in property <string> icon;
    callback clicked;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: zone.has-hover ? #FFFFFFF0 : #FFFFFFB8;
    drop-shadow-blur: 10px;
    drop-shadow-color: #0A0F1D40;
    transform-scale: zone.pressed ? 0.9 : 1;
    animate background { duration: Theme.fast; }
    animate transform-scale { duration: 120ms; easing: ease-out; }
    Icon {
        text: root.icon;
        font-size: 11px;
        color: #1C2335;
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Une diapositive de la news à la une : l'image en haut, le texte en bas.
component Diapo inherits Rectangle {
    in property <NewsItem> news;
    in property <int> numero;
    in property <length> hauteur-texte;
    clip: true;
    Rectangle {
        height: parent.height - root.hauteur-texte;
        y: 0;
        clip: true;
        background: #1C2335;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.news.image;
            image-fit: cover;
            image-rendering: ImageRendering.pixelated;
        }
        // fondu vers le texte
        Rectangle {
            y: parent.height - 50px;
            height: 50px;
            background: @linear-gradient(180deg, #0A0F1D00 0%, #0A0F1D59 100%);
        }
    }
    HorizontalLayout {
        y: parent.height - root.hauteur-texte;
        height: root.hauteur-texte;
        padding-left: 20px;
        padding-right: 18px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 7px;
                        height: 7px;
                        border-radius: 1px;
                        background: Theme.accent;
                    }
                }
                PixelLabel {
                    text: Tr.t("Home_News");
                    font-size: 10px;
                    color: Theme.accent;
                }
                Text {
                    text: root.news.date != "" ? "·  " + root.news.date : "";
                    font-size: 11.5px;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Text {
                text: root.news.title;
                font-size: 19px;
                font-weight: 700;
                color: Theme.navy;
                overflow: elide;
            }
            Text {
                text: root.news.text;
                font-size: 13px;
                color: Theme.text-muted;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 34px;
                width: lire.preferred-width + 26px;
                border-radius: 6px;
                background: zone-lire.has-hover ? Theme.fill-hover : Theme.fill;
                animate background { duration: Theme.fast; }
                lire := HorizontalLayout {
                    alignment: center;
                    spacing: 8px;
                    PixelLabel {
                        text: Tr.t("Home_LireNews");
                        font-size: 10.5px;
                        color: Theme.on-fill;
                    }
                    Icon {
                        text: "\u{E72A}";
                        font-size: 10px;
                        color: Theme.on-fill;
                    }
                }
                zone-lire := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { HomeState.news-open(root.numero); }
                }
            }
        }
    }
}

/// La news à la une : une grande carte (image en haut, texte en bas), des flèches de part et
/// d'autre de l'image et des points dessous. Elle avance toute seule toutes les 8 s, sauf quand la
/// souris est dessus.
component NewsUne inherits Rectangle {
    property <int> nombre: HomeState.news-items.length;
    property <int> courant: clamp(HomeState.news-index, 0, max(0, root.nombre - 1));
    property <length> hauteur-texte: 92px;
    border-radius: 12px;
    background: Theme.panel-strong;
    border-width: 1px;
    border-color: Theme.glass-border;
    drop-shadow-blur: 22px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: Theme.shadow;

    function aller(pas: int) {
        if (root.nombre > 0) {
            HomeState.news-index = Math.mod(root.courant + pas + root.nombre, root.nombre);
        }
    }

    // survol de toute la carte : met l'avance automatique en pause
    survol := TouchArea { }

    Timer {
        interval: 8s;
        running: root.nombre > 1 && !survol.has-hover;
        triggered => { root.aller(1); }
    }

    Rectangle {
        border-radius: root.border-radius;
        clip: true;
        for news[i] in HomeState.news-items: Diapo {
            x: (i - root.courant) * parent.width;
            width: parent.width;
            height: parent.height;
            news: news;
            numero: i;
            hauteur-texte: root.hauteur-texte;
            animate x { duration: 420ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        }
    }

    property <length> milieu-image: (root.height - root.hauteur-texte) / 2;
    if root.nombre > 1: Fleche {
        x: 12px;
        y: root.milieu-image - self.height / 2;
        icon: "\u{E76B}";
        clicked => { root.aller(-1); }
    }
    if root.nombre > 1: Fleche {
        x: parent.width - self.width - 12px;
        y: root.milieu-image - self.height / 2;
        icon: "\u{E76C}";
        clicked => { root.aller(1); }
    }

    // points : un par news, le courant plus long
    if root.nombre > 1: HorizontalLayout {
        x: (parent.width - self.preferred-width) / 2;
        y: parent.height - root.hauteur-texte - 18px;
        height: 6px;
        spacing: 5px;
        for news[i] in HomeState.news-items: Rectangle {
            width: i == root.courant ? 18px : 6px;
            height: 6px;
            border-radius: 1px;
            background: i == root.courant ? #FFFFFF : #FFFFFF80;
            animate width, background { duration: 260ms; easing: ease-out; }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { HomeState.news-index = i; }
            }
        }
    }
}

/// Petite carte d'une autre news, sous la une : vignette, titre, date. Un clic la met à la une.
component NewsMini inherits Rectangle {
    in property <int> numero;
    property <NewsItem> news: HomeState.news-items[root.numero];
    property <bool> survol: zone.has-hover;
    height: 64px;
    border-radius: 10px;
    background: root.survol ? Theme.panel-strong : Theme.panel;
    border-width: 1px;
    border-color: root.survol ? Theme.accent.with-alpha(0.6) : Theme.glass-border;
    animate background, border-color { duration: Theme.normal; }
    HorizontalLayout {
        padding: 8px;
        spacing: 10px;
        Rectangle {
            width: 64px;
            border-radius: 6px;
            clip: true;
            background: #1C2335;
            Image {
                width: parent.width;
                height: parent.height;
                source: root.news.image;
                image-fit: cover;
                image-rendering: ImageRendering.pixelated;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.news.title;
                font-size: 13px;
                font-weight: 700;
                color: Theme.navy;
                overflow: elide;
            }
            Text {
                text: root.news.date != "" ? root.news.date : root.news.text;
                font-size: 11.5px;
                color: Theme.text-muted;
                overflow: elide;
            }
        }
    }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { HomeState.news-index = root.numero; }
    }
}

/// Carte de la version choisie (ou du profil) : dégradé sombre, le nuage (ou l'icône du profil) qui
/// flotte, et en bas l'étiquette, le numéro de version et le loader. Un clic ouvre la fenêtre de choix.
component CarteVersion inherits Rectangle {
    property <bool> actif: HomeState.selectors-enabled;
    property <float> onde: sin((animation-tick() / 2600ms) * 180deg);
    border-radius: 12px;
    clip: true;
    background: @linear-gradient(165deg, #8FA6C4 0%, #3A4760 40%, #161C2B 100%);
    border-width: 1px;
    border-color: zone.has-hover && root.actif ? #FFFFFF80 : #FFFFFF2E;
    animate border-color { duration: Theme.normal; }

    zone := TouchArea {
        enabled: root.actif;
        mouse-cursor: pointer;
        clicked => {
            HomeState.picker-tab = HomeState.quick || HomeState.horizon-selected ? 0 : 1;
            HomeState.picker-horizon = HomeState.horizon-selected;
            HomeState.picker-misty = HomeState.misty-selected && HomeState.quick && !HomeState.horizon-selected;
            HomeState.picker-open = true;
            if (HomeState.horizon-selected) {
                HomeState.horizon-refresh();
            }
        }
    }

    // nuage (ou icône du profil)
    Image {
        property <length> taille: min(130px, parent.height - 150px);
        x: (parent.width - self.width) / 2;
        y: max(16px, (parent.height - 118px - self.height) / 2) + 6px * root.onde;
        width: max(0px, self.taille);
        height: max(0px, self.taille);
        source: HomeState.has-card-icon ? HomeState.card-icon : Assets.logo;
        image-fit: contain;
        image-rendering: ImageRendering.smooth;
    }

    // « changer » en haut à droite
    Rectangle {
        x: parent.width - self.width - 10px;
        y: 10px;
        width: changer.preferred-width + 18px;
        height: 26px;
        border-radius: 6px;
        background: zone.has-hover && root.actif ? #FFFFFF40 : #FFFFFF1F;
        opacity: root.actif ? 1 : 0.5;
        animate background { duration: Theme.fast; }
        changer := HorizontalLayout {
            alignment: center;
            spacing: 6px;
            PixelLabel {
                text: Tr.t("Home_Changer");
                font-size: 9.5px;
                color: #FFFFFFD9;
            }
            Icon {
                text: "\u{E70D}";
                font-size: 9px;
                color: #FFFFFFD9;
            }
        }
    }

    // bandeau : étiquette, version et loader
    Rectangle {
        x: 10px;
        y: parent.height - self.height - 10px;
        width: parent.width - 20px;
        height: infos.preferred-height;
        border-radius: 8px;
        background: #0A0F1D80;
        border-width: 1px;
        border-color: #FFFFFF1A;
        infos := VerticalLayout {
            padding: 14px;
            padding-left: 16px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 1px;
                        background: #9CC0FF;
                    }
                }
                PixelLabel {
                    horizontal-stretch: 1;
                    text: HomeState.card-label;
                    font-size: 10px;
                    color: #FFFFFFA6;
                    overflow: elide;
                }
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                OutlinedText {
                    text: HomeState.card-version;
                    font-size: 28px;
                    stroke-color: #141B2B;
                    shadow: #0A0E18;
                    thickness: 3px;
                    depth: 3px;
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 22px;
                        width: chargeur.preferred-width + 16px;
                        border-radius: 5px;
                        background: #9CC0FF29;
                        border-width: 1px;
                        border-color: #9CC0FF59;
                        chargeur := PixelLabel {
                            text: HomeState.card-loader;
                            font-size: 10px;
                            color: #CFE0FF;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

/// Compte : avatar, liste des comptes (ou le compte Microsoft seul), ajouter un compte Microsoft.
component Compte inherits HorizontalLayout {
    spacing: 10px;
    VerticalLayout {
        alignment: center;
        Thumb {
            width: 44px;
            height: 44px;
            radius: 7px;
            border: 2px;
            logo-margin: 8px;
            logo-opacity: 1;
            source: HomeState.avatar;
            has-image: HomeState.has-avatar;
            pixel-art: true;
        }
    }
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        Rectangle {
            height: 42px;
            // comptes Microsoft et hors ligne dans la même liste : on choisit, on joue
            if HomeState.all-accounts.length > 1: GlassCombo {
                model: HomeState.all-accounts;
                current-index <=> HomeState.all-index;
                enabled: !HomeState.ms-busy;
                selected(i) => { HomeState.all-selected(i); }
            }
            if HomeState.all-accounts.length <= 1 && !HomeState.premium: GlassCombo {
                model: HomeState.accounts;
                current-index <=> HomeState.account-index;
                selected(i) => { HomeState.account-selected(i); }
            }
            if HomeState.all-accounts.length <= 1 && HomeState.premium: Rectangle {
                border-radius: 8px;
                background: Theme.glass-strong;
                border-width: 1px;
                border-color: Theme.glass-border;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    Icon {
                        text: "\u{E73E}";
                        color: Theme.toggle-on;
                        font-size: 12px;
                    }
                    Text {
                        text: HomeState.premium-name;
                        color: Theme.navy;
                        font-weight: 600;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
    VerticalLayout {
        alignment: center;
        IconButton {
            width: 42px;
            height: 42px;
            icon: "\u{E8FA}";
            tooltip: HomeState.ms-names.length > 0 ? Tr.t("Home_AjouterMicrosoft") : Tr.t("Home_ConnecterMicrosoft");
            enabled: !HomeState.ms-busy;
            clicked => { HomeState.ms-clicked(); }
        }
    }
}

/// Colonne de lancement, à droite : compte, carte de la version, console et JOUER, et pendant un
/// lancement la progression et le statut.
component Lancement inherits Rectangle {
    width: 300px;
    border-radius: 14px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.glass-border;
    drop-shadow-blur: 26px;
    drop-shadow-offset-y: 10px;
    drop-shadow-color: Theme.shadow;

    VerticalLayout {
        padding: 14px;
        spacing: 12px;

        Compte { }

        CarteVersion {
            vertical-stretch: 1;
        }

        // profil : gérer son contenu
        if !HomeState.quick: Rectangle {
            height: 38px;
            border-radius: 8px;
            background: zone-gerer.has-hover ? Theme.glass-hover : Theme.glass-strong;
            border-width: 1px;
            border-color: zone-gerer.has-hover ? Theme.accent : Theme.glass-border;
            animate background, border-color { duration: Theme.fast; }
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Icon {
                    text: "\u{E70F}";
                    font-size: 13px;
                }
                Text {
                    text: Tr.t("Home_Gerer");
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.navy;
                    vertical-alignment: center;
                }
            }
            zone-gerer := TouchArea {
                mouse-cursor: pointer;
                clicked => { HomeState.manage(); }
            }
        }

        // statut : seulement quand il se passe quelque chose (pas « Prêt à jouer »)
        if HomeState.status != "" && HomeState.status != Tr.t("Home_Pret"): VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: HomeState.status;
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.navy2;
                    vertical-alignment: center;
                    overflow: elide;
                }
                PixelLabel {
                    text: HomeState.percent-text;
                    font-size: 10px;
                }
            }
            if HomeState.progress > 0: Rectangle {
                height: 4px;
                border-radius: 1px;
                background: Theme.track;
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(HomeState.progress, 0, 1);
                    border-radius: 1px;
                    background: Theme.accent;
                    animate width { duration: 200ms; }
                }
            }
            // mauvaise version lancée par erreur : on arrête le téléchargement
            if HomeState.can-cancel: Rectangle {
                height: 28px;
                border-radius: 6px;
                background: zone-annuler.has-hover ? #FF5A6E33 : #FF5A6E1F;
                border-width: 1px;
                border-color: #FF5A6E66;
                HorizontalLayout {
                    alignment: center;
                    spacing: 6px;
                    Icon {
                        text: "\u{E711}";
                        font-size: 9px;
                        color: Theme.danger;
                    }
                    Text {
                        text: Tr.t("Commun_Annuler");
                        font-size: 12px;
                        font-weight: 700;
                        color: Theme.danger;
                        vertical-alignment: center;
                    }
                }
                zone-annuler := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { HomeState.cancel-install(); }
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            IconButton {
                width: 52px;
                height: 58px;
                icon: "\u{E756}";
                icon-size: 16px;
                tooltip: Tr.t("Home_Bouton_Logs");
                clicked => {
                    ConsoleState.focused = -1;
                    ConsoleState.open = true;
                }
            }
            PlayButton {
                horizontal-stretch: 1;
                height: 58px;
                font-size: 24px;
                text: HomeState.play-text;
                enabled: HomeState.play-enabled;
                clicked => { HomeState.play(); }
            }
        }
    }
}

export component HomePage inherits Rectangle {
    HorizontalLayout {
        padding-left: 30px;
        padding-right: 14px;
        padding-top: 16px;
        padding-bottom: 22px;
        spacing: 22px;

        // ═══════════ À gauche : le titre et les news, ou la skin ═══════════
        if SkinState.tab == 0: VerticalLayout {
            horizontal-stretch: 1;
            spacing: 14px;
            HorizontalLayout {
                alignment: start;
                padding-left: 2px;
                OutlinedText {
                    text: "MISTY";
                    font-size: 76px;
                    thickness: 4px;
                    depth: 6px;
                }
            }
            if HomeState.news-items.length > 0: NewsUne {
                vertical-stretch: 1;
                min-height: 200px;
            }
            // les news suivantes, en petit
            if HomeState.news-items.length > 1: HorizontalLayout {
                spacing: 10px;
                for k in min(3, HomeState.news-items.length - 1): NewsMini {
                    horizontal-stretch: 1;
                    numero: Math.mod(clamp(HomeState.news-index, 0, HomeState.news-items.length - 1) + 1 + k, HomeState.news-items.length);
                }
            }
            if HomeState.news-items.length == 0: Rectangle { vertical-stretch: 1; }
        }
        if SkinState.tab == 1: VerticalLayout {
            horizontal-stretch: 1;
            SkinPanel {
                vertical-stretch: 1;
            }
        }

        // ═══════════ À droite : la colonne de lancement, puis les onglets verticaux ═══════════
        Lancement { }
        Onglets {
            width: 56px;
        }
    }
}
