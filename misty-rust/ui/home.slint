// Page d'accueil, volontairement épurée : le paysage, le titre MISTY et une ligne, la dernière news
// en petite pastille, et en bas un dock flottant (compte · version ou profil · console · JOUER).
// Le statut et la progression se glissent sous le dock. En haut à droite : Jouer | Skin.

import { Theme, Tr } from "theme.slint";
import { HomeState, AppState } from "state.slint";
import { Icon, PixelLabel, OutlinedText, Thumb, IconButton, PlayButton, GlassCombo } from "widgets.slint";
import { ConsoleState } from "console.slint";
import { SkinState, SkinPanel } from "skin.slint";

/// Sélecteur « Jouer | Skin » : deux segments, une pastille qui glisse sous le choisi.
component Bascule inherits Rectangle {
    property <length> segment: max(jouer.preferred-width, skin.preferred-width) + 36px;
    width: 2 * root.segment + 8px;
    height: 40px;
    border-radius: 20px;
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.glass-border;

    Rectangle {
        x: 4px + (SkinState.tab == 1 ? root.segment : 0px);
        y: 4px;
        width: root.segment;
        height: parent.height - 8px;
        border-radius: self.height / 2;
        background: Theme.fill;
        animate x { duration: 320ms; easing: cubic-bezier(0.34, 1.3, 0.64, 1); }
    }
    jouer := PixelLabel {
        x: 4px;
        width: root.segment;
        text: Tr.t("Home_Bouton_Jouer");
        font-size: 12px;
        horizontal-alignment: center;
        color: SkinState.tab == 0 ? Theme.on-fill : Theme.navy;
        animate color { duration: Theme.normal; }
    }
    skin := PixelLabel {
        x: 4px + root.segment;
        width: root.segment;
        text: Tr.t("Skin_Onglet");
        font-size: 12px;
        horizontal-alignment: center;
        color: SkinState.tab == 1 ? Theme.on-fill : Theme.navy;
        animate color { duration: Theme.normal; }
    }
    TouchArea {
        x: 0;
        width: parent.width / 2;
        mouse-cursor: pointer;
        clicked => {
            SkinState.tab = 0;
            AppState.nav = 0;
        }
    }
    TouchArea {
        x: parent.width / 2;
        width: parent.width / 2;
        mouse-cursor: pointer;
        clicked => {
            SkinState.tab = 1;
            AppState.nav = 7;
            SkinState.open();
        }
    }
}

/// La dernière news en une ligne : point, titre, date, flèche.
component PastilleNews inherits Rectangle {
    property <bool> survol: touch.has-hover;
    height: 38px;
    width: contenu.preferred-width;
    border-radius: 19px;
    background: root.survol ? Theme.panel-strong : Theme.panel;
    border-width: 1px;
    border-color: root.survol ? Theme.accent.with-alpha(0.6) : Theme.glass-border;
    animate background, border-color { duration: Theme.normal; }
    contenu := HorizontalLayout {
        padding-left: 14px;
        padding-right: 6px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: Theme.accent;
            }
        }
        Text {
            text: HomeState.news-title;
            font-size: 13px;
            font-weight: 700;
            color: Theme.navy;
            vertical-alignment: center;
            max-width: 300px;
            overflow: elide;
        }
        if HomeState.news-date != "": Text {
            text: HomeState.news-date;
            font-size: 12px;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: root.survol ? Theme.fill : transparent;
                animate background { duration: Theme.normal; }
                Icon {
                    x: (parent.width - self.width) / 2 + (root.survol ? 1px : 0px);
                    text: "\u{E72A}";
                    font-size: 10px;
                    color: root.survol ? Theme.on-fill : Theme.navy;
                    animate x { duration: 200ms; easing: ease-out; }
                }
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { HomeState.news-open(); }
    }
}

/// Séparateur vertical du dock.
component Trait inherits Rectangle {
    width: 1px;
    height: 34px;
    background: Theme.line;
}

/// Bouton qui ouvre la fenêtre de choix : icône, petite étiquette, et la version ou le profil.
component Choix inherits Rectangle {
    property <bool> actif: HomeState.selectors-enabled;
    min-width: 180px;
    height: 52px;
    border-radius: 16px;
    background: zone.has-hover && root.actif ? Theme.glass-hover : transparent;
    opacity: root.actif ? 1 : 0.55;
    animate background { duration: Theme.fast; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 11px;
                background: HomeState.horizon-selected ? #F0795A29 : Theme.accent-soft;
                Icon {
                    text: HomeState.horizon-selected ? "\u{E945}" : HomeState.misty-selected && HomeState.quick ? "\u{E753}" : HomeState.quick ? "\u{E7FC}" : "\u{E8F1}";
                    font-size: 15px;
                    color: HomeState.horizon-selected ? #F0795A : Theme.accent;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            PixelLabel {
                text: HomeState.horizon-selected ? Tr.t("Hz_Moteur") : HomeState.misty-selected && HomeState.quick ? "MISTY CLIENT" : HomeState.quick ? Tr.t("Commun_Version") : Tr.t("Home_Profil");
                font-size: 9.5px;
                color: Theme.text-dim;
                overflow: elide;
            }
            Text {
                text: HomeState.horizon-selected ? "Horizon · " + HomeState.horizon-build
                    : HomeState.misty-selected && HomeState.quick ? "Misty · " + HomeState.misty-mc
                    : HomeState.quick ? HomeState.card-version + " · " + HomeState.card-loader
                    : (HomeState.profile-index >= 0 && HomeState.profile-index < HomeState.profiles.length ? HomeState.profiles[HomeState.profile-index] : "");
                font-size: 14.5px;
                font-weight: 700;
                color: Theme.navy;
                overflow: elide;
            }
        }
        Icon {
            text: "\u{E70D}";
            font-size: 10px;
            color: Theme.text-muted;
        }
    }
    zone := TouchArea {
        enabled: root.actif;
        mouse-cursor: pointer;
        clicked => {
            HomeState.picker-tab = HomeState.quick || HomeState.horizon-selected ? 0 : 1;
            HomeState.picker-horizon = HomeState.horizon-selected;
            HomeState.picker-misty = HomeState.misty-selected && HomeState.quick && !HomeState.horizon-selected;
            HomeState.picker-open = true;
            if (HomeState.horizon-selected) {
                HomeState.horizon-refresh();
            }
        }
    }
}

/// Compte : avatar, liste des comptes (ou le compte Microsoft seul), ajouter un compte Microsoft.
component Compte inherits HorizontalLayout {
    spacing: 10px;
    VerticalLayout {
        alignment: center;
        Thumb {
            width: 44px;
            height: 44px;
            radius: 13px;
            border: 2px;
            logo-margin: 8px;
            logo-opacity: 1;
            source: HomeState.avatar;
            has-image: HomeState.has-avatar;
            pixel-art: true;
        }
    }
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 150px;
            height: 42px;
            // comptes Microsoft et hors ligne dans la même liste : on choisit, on joue
            if HomeState.all-accounts.length > 1: GlassCombo {
                model: HomeState.all-accounts;
                current-index <=> HomeState.all-index;
                enabled: !HomeState.ms-busy;
                selected(i) => { HomeState.all-selected(i); }
            }
            if HomeState.all-accounts.length <= 1 && !HomeState.premium: GlassCombo {
                model: HomeState.accounts;
                current-index <=> HomeState.account-index;
                selected(i) => { HomeState.account-selected(i); }
            }
            if HomeState.all-accounts.length <= 1 && HomeState.premium: Rectangle {
                border-radius: 12px;
                background: Theme.glass-strong;
                border-width: 1px;
                border-color: Theme.glass-border;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    Icon {
                        text: "\u{E73E}";
                        color: Theme.toggle-on;
                        font-size: 12px;
                    }
                    Text {
                        text: HomeState.premium-name;
                        color: Theme.navy;
                        font-weight: 600;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
    VerticalLayout {
        alignment: center;
        IconButton {
            width: 42px;
            height: 42px;
            icon: "\u{E8FA}";
            tooltip: HomeState.ms-names.length > 0 ? Tr.t("Home_AjouterMicrosoft") : Tr.t("Home_ConnecterMicrosoft");
            enabled: !HomeState.ms-busy;
            clicked => { HomeState.ms-clicked(); }
        }
    }
}

export component HomePage inherits Rectangle {
    VerticalLayout {
        padding-left: 30px;
        padding-right: 30px;
        padding-bottom: 22px;
        spacing: 0px;

        // ═══════════ En haut : Jouer | Skin ═══════════
        HorizontalLayout {
            alignment: end;
            padding-bottom: 6px;
            Bascule { }
        }

        // ═══════════ Le titre, ou la skin ═══════════
        if SkinState.tab == 0: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            padding-left: 18px;
            padding-bottom: 30px;
            spacing: 0px;
            HorizontalLayout {
                alignment: start;
                OutlinedText {
                    text: "MISTY";
                    font-size: 104px;
                    thickness: 5px;
                    depth: 8px;
                }
            }
            HorizontalLayout {
                padding-left: 6px;
                Text {
                    text: Tr.t("Home_txt-1") + " " + Tr.t("Home_txt-2");
                    font-size: 16px;
                    color: Theme.navy2;
                    wrap: word-wrap;
                    max-width: 520px;
                }
            }
            if HomeState.news-visible: HorizontalLayout {
                alignment: start;
                padding-left: 4px;
                padding-top: 22px;
                PastilleNews { }
            }
        }
        if SkinState.tab == 1: VerticalLayout {
            vertical-stretch: 1;
            padding-top: 8px;
            padding-bottom: 18px;
            SkinPanel {
                vertical-stretch: 1;
            }
        }

        // ═══════════ Le dock ═══════════
        Rectangle {
            vertical-stretch: 0;
            height: 76px;
            border-radius: 26px;
            background: Theme.panel;
            border-width: 1px;
            border-color: Theme.glass-border;
            drop-shadow-blur: 26px;
            drop-shadow-offset-y: 10px;
            drop-shadow-color: Theme.shadow;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 12px;
                spacing: 14px;

                Compte { }
                VerticalLayout {
                    alignment: center;
                    Trait { }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    HorizontalLayout {
                        spacing: 6px;
                        Choix {
                            horizontal-stretch: 1;
                        }
                        // profil : gérer son contenu
                        if !HomeState.quick: VerticalLayout {
                            alignment: center;
                            IconButton {
                                width: 42px;
                                height: 42px;
                                icon: "\u{E70F}";
                                tooltip: Tr.t("Home_Gerer");
                                clicked => { HomeState.manage(); }
                            }
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        width: 46px;
                        height: 46px;
                        icon: "\u{E756}";
                        icon-size: 16px;
                        tooltip: Tr.t("Home_Bouton_Logs");
                        clicked => {
                            ConsoleState.focused = -1;
                            ConsoleState.open = true;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    PlayButton {
                        width: 176px;
                        height: 58px;
                        font-size: 24px;
                        text: HomeState.play-text;
                        enabled: HomeState.play-enabled;
                        clicked => { HomeState.play(); }
                    }
                }
            }

            // progression : un fil lumineux le long du bas du dock
            Rectangle {
                x: 26px;
                y: parent.height - 3px;
                width: parent.width - 52px;
                height: 2px;
                border-radius: 1px;
                background: HomeState.progress > 0 ? Theme.track : transparent;
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(HomeState.progress, 0, 1);
                    border-radius: 1px;
                    background: Theme.accent;
                    animate width { duration: 200ms; }
                }
            }
        }

        // ═══════════ Statut, sous le dock ═══════════
        HorizontalLayout {
            padding-top: 10px;
            padding-left: 22px;
            padding-right: 22px;
            spacing: 10px;
            height: 32px;
            Text {
                horizontal-stretch: 1;
                text: HomeState.status;
                font-size: 12.5px;
                font-weight: 600;
                color: Theme.navy2;
                vertical-alignment: center;
                overflow: elide;
            }
            PixelLabel {
                text: HomeState.percent-text;
                font-size: 10.5px;
            }
            // mauvaise version lancée par erreur : on arrête le téléchargement
            if HomeState.can-cancel: Rectangle {
                width: annuler.preferred-width + 18px;
                height: 22px;
                border-radius: 7px;
                background: zone-annuler.has-hover ? #FF5A6E33 : #FF5A6E1F;
                border-width: 1px;
                border-color: #FF5A6E66;
                annuler := HorizontalLayout {
                    alignment: center;
                    spacing: 5px;
                    Icon {
                        text: "\u{E711}";
                        font-size: 9px;
                        color: Theme.danger;
                    }
                    Text {
                        text: Tr.t("Commun_Annuler");
                        font-size: 11.5px;
                        font-weight: 700;
                        color: Theme.danger;
                        vertical-alignment: center;
                    }
                }
                zone-annuler := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { HomeState.cancel-install(); }
                }
            }
        }
    }
}
