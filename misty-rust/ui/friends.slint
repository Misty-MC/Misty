// Amis : une tuile comme Profils. En-tête (titre, nombre, ajout par pseudo), puis les amis en
// cartes : leur tête, leur nom, et s'ils jouent en ce moment avec Misty Client. La liste est gardée
// sur ce PC ; « en ligne » vient du réseau Misty (voir src/services/amis.rs).

import { Theme, Tr } from "theme.slint";
import { FriendsState, FriendCard } from "state.slint";
import { Icon, BodyText, GlassInput, MButton, IconButton, Puces, TuilePage, EnTetePage } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

component CarteAmi inherits Rectangle {
    in property <FriendCard> ami;
    property <bool> survol: zone.has-hover;
    property <color> statut: !FriendsState.status-known ? Theme.text-muted : root.ami.online ? #1DE062 : #8B9BB0;
    height: 76px;
    border-radius: 8px;
    background: root.survol ? Theme.panel-strong : Theme.glass;
    border-width: 1px;
    border-color: root.ami.online ? #1DE06266 : Theme.glass-border;
    animate background, border-color { duration: Theme.fast; }
    zone := TouchArea { }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 44px;
                height: 44px;
                Rectangle {
                    border-radius: 6px;
                    clip: true;
                    background: Theme.fill;
                    if root.ami.has-head: Image {
                        width: parent.width;
                        height: parent.height;
                        source: root.ami.head;
                        image-fit: fill;
                        image-rendering: pixelated;
                    }
                    if !root.ami.has-head: Text {
                        text: root.ami.name.character-count > 0 ? "?" : "";
                        font-size: 18px;
                        font-weight: 800;
                        color: Theme.on-fill;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if FriendsState.status-known: Rectangle {
                    x: parent.width - 11px;
                    y: parent.height - 11px;
                    width: 14px;
                    height: 14px;
                    border-radius: 4px;
                    background: root.statut;
                    border-width: 2px;
                    border-color: root.survol ? Theme.panel-strong : Theme.panel;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            Text {
                text: root.ami.name;
                font-size: 15px;
                font-weight: 700;
                color: Theme.navy;
                overflow: elide;
            }
            Text {
                text: !FriendsState.status-known ? Tr.t("Amis_Inconnu") : root.ami.online ? Tr.t("Amis_JoueMisty") : Tr.t("Amis_HorsLigne");
                font-size: 12px;
                font-weight: root.ami.online ? 600 : 400;
                color: FriendsState.status-known && root.ami.online ? Theme.green-dark : Theme.text-muted;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                width: 32px;
                height: 32px;
                opacity: root.survol ? 1 : 0;
                animate opacity { duration: Theme.fast; }
                icon: "\u{E74D}";
                tooltip: Tr.t("Amis_Retirer");
                clicked => { FriendsState.remove(root.ami.uuid); }
            }
        }
    }
}

/// Une page vide : l'icône, un titre, un texte.
component Vide inherits VerticalLayout {
    in property <string> icone;
    in property <string> titre;
    in property <string> texte;
    alignment: center;
    spacing: 10px;
    padding: 30px;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 54px;
            height: 54px;
            border-radius: 10px;
            background: Theme.accent-soft;
            Icon {
                text: root.icone;
                font-size: 22px;
                color: Theme.accent;
            }
        }
    }
    Text {
        text: root.titre;
        font-size: 18px;
        font-weight: 800;
        color: Theme.navy;
        horizontal-alignment: center;
    }
    HorizontalLayout {
        alignment: center;
        BodyText {
            width: min(420px, root.width - 60px);
            text: root.texte;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

export component FriendsPage inherits Rectangle {
    /// 0 tous, 1 en ligne
    property <int> onglet: 0;
    property <int> visibles: root.onglet == 0 ? FriendsState.list.length : FriendsState.online-count;

    TuilePage {
        VerticalLayout {
            EnTetePage {
                titre: Tr.t("Onglet_Amis");
                info: FriendsState.list.length;
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    GlassInput {
                        width: min(240px, max(140px, root.width - 560px));
                        placeholder: Tr.t("Amis_Pseudo");
                        text <=> FriendsState.name;
                        accepted => { FriendsState.add(); }
                        // on retape : le message du dernier ajout s'en va
                        edited => { FriendsState.message = ""; }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    MButton {
                        kind: 1;
                        icon: "\u{E8FA}";
                        text: Tr.t("Amis_Ajouter");
                        enabled: FriendsState.name != "" && !FriendsState.adding;
                        clicked => { FriendsState.add(); }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 0;
                    alignment: center;
                    IconButton {
                        icon: "\u{E72C}";
                        tooltip: Tr.t("Amis_Actualiser");
                        enabled: !FriendsState.refreshing && FriendsState.list.length > 0;
                        clicked => { FriendsState.refresh(); }
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.line;
            }
            // retour du dernier ajout
            if FriendsState.message != "": HorizontalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 12px;
                Text {
                    text: FriendsState.message;
                    font-size: 13px;
                    font-weight: 600;
                    color: FriendsState.message-error ? Theme.danger : Theme.green-dark;
                    wrap: word-wrap;
                }
            }
            // sans jeton Misty, on ne sait pas qui joue
            if !FriendsState.status-known && FriendsState.list.length > 0: HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 12px;
                Rectangle {
                    border-radius: 8px;
                    background: Theme.accent-soft;
                    border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.35);
                    height: bandeau.preferred-height;
                    bandeau := HorizontalLayout {
                        padding: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                text: "\u{E946}";
                                font-size: 14px;
                                color: Theme.accent;
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: Tr.t("Amis_SansStatut");
                            font-size: 12.5px;
                            color: Theme.navy;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            if FriendsState.list.length > 0: HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                Puces {
                    model: [Tr.t("Amis_Tous"), Tr.t("Amis_EnLigne") + (FriendsState.status-known ? " · " + FriendsState.online-count : "")];
                    current: root.onglet;
                    selected(i) => { root.onglet = i; }
                }
                Rectangle { horizontal-stretch: 1; }
            }

            if FriendsState.list.length == 0: Vide {
                vertical-stretch: 1;
                icone: "\u{E716}";
                titre: Tr.t("Amis_Aucun");
                texte: Tr.t("Amis_Vide_Texte");
            }
            if FriendsState.list.length > 0 && root.visibles == 0: Vide {
                vertical-stretch: 1;
                icone: "\u{E7E8}";
                titre: Tr.t("Amis_PersonneEnLigne");
                texte: FriendsState.status-known ? Tr.t("Amis_PersonneEnLigne_Texte") : Tr.t("Amis_SansStatut");
            }
            // la grille : autant de colonnes que la largeur le permet (cartes de 230 px au moins) ;
            // la liste est triée en ligne d'abord, donc l'onglet « En ligne » en montre le début
            if root.visibles > 0: Rectangle {
                vertical-stretch: 1;
                grille := ScrollView {
                    x: 20px;
                    y: 16px;
                    width: parent.width - 28px;
                    height: parent.height - 16px;
                    property <int> colonnes: max(1, floor((self.visible-width - 12px + 10px) / (230px + 10px)));
                    property <length> case: (self.visible-width - 12px - (self.colonnes - 1) * 10px) / self.colonnes;
                    content-width: self.visible-width;
                    content-height: ceil(root.visibles / self.colonnes) * (76px + 10px) + 8px;
                    for a[i] in FriendsState.list: CarteAmi {
                        visible: i < root.visibles;
                        x: mod(i, grille.colonnes) * (grille.case + 10px);
                        y: floor(i / grille.colonnes) * (76px + 10px);
                        width: grille.case;
                        ami: a;
                    }
                }
            }
        }
    }
}
