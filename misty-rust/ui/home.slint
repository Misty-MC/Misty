// Page d'accueil, comme la maquette : un grand cadre ouvert sur le paysage de Misty (le fond de la
// fenêtre), le logo MISTY au milieu et la dernière news dans une petite pastille en bas. Sur
// l'onglet Skin, le studio. Les onglets sont dans la tuile du haut, le lancement dans la barre du
// bas (dock.slint).

import { Theme, Tr, Assets } from "theme.slint";
import { HomeState, AppState } from "state.slint";
import { Icon, PixelLabel, OutlinedText } from "widgets.slint";
import { SkinState, SkinPanel } from "skin.slint";

/// La news affichée : un point, « Nouveautés », son titre et sa date, une flèche. Un clic l'ouvre ;
/// les petites flèches passent à la précédente ou à la suivante.
component PastilleNews inherits Rectangle {
    property <int> n: clamp(HomeState.news-index, 0, max(0, HomeState.news-items.length - 1));
    property <bool> survol: zone.has-hover;
    height: 48px;
    width: contenu.preferred-width;
    border-radius: 8px;
    background: Theme.dark ? #0A0F1DCC : #FFFFFFD9;
    border-width: 1px;
    border-color: root.survol ? Theme.accent.with-alpha(0.7) : Theme.glass-border;
    animate border-color { duration: Theme.fast; }
    zone := TouchArea {
        mouse-cursor: pointer;
        clicked => { HomeState.news-open(root.n); }
    }
    contenu := HorizontalLayout {
        padding-left: 16px;
        padding-right: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.accent;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            PixelLabel {
                text: Tr.t("Home_News") + (HomeState.news-items[root.n].date != "" ? "  ·  " + HomeState.news-items[root.n].date : "");
                font-size: 11px;
                color: Theme.accent;
            }
            Text {
                text: HomeState.news-items[root.n].title;
                font-size: 14px;
                font-weight: 700;
                color: Theme.navy;
                max-width: 320px;
                overflow: elide;
            }
        }
        // précédente / suivante
        if HomeState.news-items.length > 1: HorizontalLayout {
            spacing: 2px;
            for sens[k] in [-1, 1]: Rectangle {
                width: 30px;
                height: 30px;
                y: 9px;
                border-radius: 6px;
                background: zf.has-hover ? Theme.glass-hover : transparent;
                Icon {
                    text: sens < 0 ? "\u{E76B}" : "\u{E76C}";
                    font-size: 10px;
                    color: Theme.text-muted;
                }
                zf := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        HomeState.news-index = Math.mod(root.n + sens + HomeState.news-items.length, HomeState.news-items.length);
                    }
                }
            }
        }
    }
}

export component HomePage inherits Rectangle {
    // ═══════════ Jouer : le paysage dans un cadre, le logo au milieu ═══════════
    if SkinState.tab == 0: Rectangle {
        border-radius: 8px;
        border-width: 2px;
        border-color: Theme.glass-border;
        clip: true;
        // voile léger en bas : la pastille et le logo restent lisibles sur le paysage
        Rectangle {
            background: @linear-gradient(180deg, #00000000 0%, #00000000 55%, (Theme.dark ? #05080F80 : #14203A40) 100%);
        }
        // des nuages Misty qui traversent le ciel, chacun à sa hauteur, sa taille et sa vitesse
        for n in [
            { y: 0.10, s: 76, p: 76000, o: 0.10, a: 0.65 },
            { y: 0.24, s: 44, p: 52000, o: 0.55, a: 0.45 },
            { y: 0.16, s: 34, p: 44000, o: 0.30, a: 0.35 },
            { y: 0.62, s: 96, p: 98000, o: 0.80, a: 0.30 },
            { y: 0.70, s: 54, p: 66000, o: 0.35, a: 0.25 },
        ]: Image {
            property <float> t: Math.mod(animation-tick() / (n.p * 1ms) + n.o, 1);
            x: -n.s * 1px + (parent.width + n.s * 2px) * self.t;
            y: parent.height * n.y + 4px * sin((animation-tick() / 5000ms + n.o) * 360deg);
            width: n.s * 1px;
            height: self.width;
            source: Assets.logo;
            image-fit: contain;
            colorize: white;
            opacity: n.a;
        }
        // le logo, comme celui de Minecraft sur la maquette
        VerticalLayout {
            alignment: center;
            spacing: 10px;
            HorizontalLayout {
                alignment: center;
                OutlinedText {
                    text: "MISTY";
                    font-size: min(140px, root.width / 6.5);
                    thickness: 6px;
                    depth: 9px;
                }
            }
            HorizontalLayout {
                alignment: center;
                PixelLabel {
                    text: Tr.t("Home_Badge");
                    font-size: 13px;
                    letter-spacing: 3px;
                    color: Theme.dark ? #DCE6FFCC : #1C2335B3;
                }
            }
        }
        if HomeState.news-items.length > 0: PastilleNews {
            x: 20px;
            y: parent.height - self.height - 20px;
        }
    }

    // ═══════════ Skin : le studio ═══════════
    if SkinState.tab == 1: SkinPanel { }
}
